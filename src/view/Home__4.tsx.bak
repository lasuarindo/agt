// ============================================================================
// SUPPORTED BY SECTION
// ============================================================================
function SupportedBySection() {
  const supporters = [
    {
      name: 'Telkom Indonesia',
      tagline: 'Technology Partner',
      initial: 'T',
      gradient: 'from-blue-500 to-blue-700',
      logo: logodev('telkom.co.id')
    },
    {
      name: 'Indigo',
      tagline: 'Innovation Partner',
      initial: 'I',
      gradient: 'from-purple-500 to-pink-500'
    },
    {
      name: 'Viisa',
      tagline: '',
      initial: 'V',
      gradient: 'from-[#1A1F71] to-[#F7B600]',
      logo: logodev('viisa.vn')
    }
  ]

  return (
    <section className="py-16 md:py-20 bg-white relative overflow-hidden">
      <div className="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-b from-[#E8D09E]/8 to-transparent rounded-full blur-3xl pointer-events-none" />
      
      <div className="relative max-w-6xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12"
        >
          <p className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest mb-2">
            Didukung Oleh
          </p>
          <h2 className="text-2xl md:text-3xl font-extrabold text-[#1A1A1A] tracking-tight">
            Mitra Strategis Kami
          </h2>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {supporters.map((supporter, idx) => (
            <motion.div
              key={supporter.name}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className="group relative bg-gradient-to-br from-white to-[#FAF8F5] rounded-2xl p-6 border border-gray-100 hover:border-[#E8D09E]/50 shadow-sm hover:shadow-lg transition-all duration-300"
            >
              <div className="flex items-center gap-4">
                {supporter.logo ? (
                  <div className="w-16 h-16 rounded-2xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300 shrink-0 bg-white border border-gray-100 overflow-hidden">
                    <img 
                      src={supporter.logo} 
                      alt={`${supporter.name} logo`}
                      className="w-full h-full object-contain p-2"
                      onError={(e) => {
                        e.currentTarget.style.display = 'none'
                        const parent = e.currentTarget.parentElement
                        if (parent) {
                          parent.innerHTML = `<span class="text-white font-extrabold text-2xl">${supporter.initial}</span>`
                          parent.className = `w-16 h-16 bg-gradient-to-br ${supporter.gradient} rounded-2xl flex items-center justify-center`
                        }
                      }}
                    />
                  </div>
                ) : (
                  <div className={`w-16 h-16 bg-gradient-to-br ${supporter.gradient} rounded-2xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300 shrink-0`}>
                    <span className="text-white font-extrabold text-2xl">{supporter.initial}</span>
                  </div>
                )}

                <div className="flex-1 min-w-0">
                  <h3 className="text-base font-bold text-[#1A1A1A] mb-0.5 truncate">
                    {supporter.name}
                  </h3>
                  <p className="text-xs font-medium text-gray-500 uppercase tracking-wide">
                    {supporter.tagline}
                  </p>
                </div>
              </div>
            </motion.div>
          ))}
        </div>

        <motion.div
          initial={{ opacity: 0 }}
          whileInView={{ opacity: 1 }}
          viewport={{ once: true }}
          transition={{ delay: 0.4 }}
          className="mt-8 text-center"
        >
          <p className="text-xs text-gray-400 flex items-center justify-center gap-1.5">
            <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
            <span>Standar Keamanan Global</span>
          </p>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// ABOUT SECTION + TIMELINE
// ============================================================================
function AboutSection() {
  const timeline = [
    { year: '2017', title: 'Berdiri', desc: 'PT. Autentikasi Garda Teknologi didirikan di Bandung dengan visi menjadi pelopor sistem anti-counterfeit di Asia Pasifik.', icon: <Rocket className="w-5 h-5" /> },
    { year: '2019', title: 'Ekspansi Produk', desc: 'Meluncurkan teknologi scratch PIN dan sticker hologram pertama yang terintegrasi dengan database real-time.', icon: <Lightbulb className="w-5 h-5" /> },
    { year: '2021', title: '100+ Brand Partner', desc: 'Mencapai milestone 100 brand partner dari berbagai industri, dari fashion hingga farmasi.', icon: <Users className="w-5 h-5" /> },
    { year: '2023', title: 'Mobile Platform', desc: 'Meluncurkan aplikasi mobile untuk verifikasi produk yang dapat diakses oleh konsumen secara langsung.', icon: <Smartphone className="w-5 h-5" /> },
    { year: '2025', title: '500+ Brand & Regional', desc: 'Memperluas jangkauan ke seluruh Asia Pasifik dengan lebih dari 500 brand partner aktif.', icon: <Globe className="w-5 h-5" /> }
  ]

  return (
    <section id="about" className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />
      
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-20">
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6 lg:sticky lg:top-32"
          >
            <div>
              <p className="text-[#8C6F3D] font-bold tracking-widest uppercase text-xs mb-3">Tentang Kami</p>
              <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight mb-4">
                Delapan Tahun <br />
                <span className="text-transparent bg-clip-text bg-linear-to-r from-[#8C6F3D] to-[#C5A059]">
                  Melindungi Keaslian
                </span>
              </h2>
              <p className="text-gray-600 leading-relaxed text-lg">
                Sejak 2017, AuthenticGuards Technology berkomitmen untuk memberantas produk palsu dan membangun ekosistem perdagangan yang aman di Asia Pasifik.
              </p>
            </div>

            <div className="space-y-4">
              {[
                {
                  icon: <Target className="w-5 h-5" />,
                  title: "Misi Kami",
                  desc: "Menyediakan teknologi autentikasi yang terjangkau, akurat, dan mudah diadopsi oleh brand di seluruh Asia Pasifik."
                },
                {
                  icon: <Eye className="w-5 h-5" />,
                  title: "Visi Kami",
                  desc: "Menjadi standar global dalam sistem anti-counterfeit yang melindungi produk dan konsumen di seluruh dunia."
                }
              ].map((item, idx) => (
                <div key={idx} className="flex gap-4 p-5 bg-white rounded-2xl border border-[#E8D09E]/30 shadow-sm hover:shadow-md transition-shadow">
                  <div className="w-11 h-11 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
                    {item.icon}
                  </div>
                  <div>
                    <h3 className="font-bold text-[#1A1A1A] mb-1">{item.title}</h3>
                    <p className="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="relative"
          >
            <div className="absolute left-6 top-0 bottom-0 w-0.5 bg-linear-to-b from-[#C5A059] via-[#E8D09E] to-transparent" />
            
            <div className="space-y-6">
              {timeline.map((item, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, y: 20 }}
                  whileInView={{ opacity: 1, y: 0 }}
                  viewport={{ once: true, margin: "-50px" }}
                  transition={{ duration: 0.5, delay: idx * 0.1 }}
                  className="relative pl-16"
                >
                  <div className="absolute left-0 top-0 w-12 h-12 bg-white border-2 border-[#C5A059] rounded-xl flex items-center justify-center text-[#8C6F3D] shadow-md z-10">
                    {item.icon}
                  </div>
                  
                  <div className="bg-white rounded-2xl p-5 border border-[#E8D09E]/30 shadow-sm hover:shadow-md transition-shadow">
                    <div className="flex items-center gap-3 mb-2">
                      <span className="text-xs font-extrabold text-[#C5A059] bg-[#E8D09E]/20 px-2.5 py-1 rounded-md tracking-wider">
                        {item.year}
                      </span>
                      <h3 className="font-bold text-[#1A1A1A]">{item.title}</h3>
                    </div>
                    <p className="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

