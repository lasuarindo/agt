import { useState } from 'react'
import { Link } from 'react-router'
import { motion, AnimatePresence } from 'motion/react'
import {
  MapPin,
  Phone,
  Mail,
  Clock,
  Globe,
  MessageCircle,
  Send,
  CheckCircle2,
  ArrowRight,
  Sparkles,
  ShieldCheck,
  Handshake,
  Building2,
  Users,
  Newspaper,
  HeadphonesIcon,
  HelpCircle,
  ChevronDown,
  AlertCircle,
  Loader2,
  ExternalLink,
  Calendar,
  Briefcase,
  Award,
  Target
} from 'lucide-react'

// ============================================================================
// HERO CONTACT SECTION
// ============================================================================
function HeroContact() {
  return (
    <section className="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden">
      <div className="absolute inset-0 bg-gradient-to-br from-[#FAF8F5] via-[#F5EFE6] to-[#E8D09E]/20" />
      <div className="absolute top-0 right-0 -mt-32 -mr-32 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 -mb-32 -ml-32 w-[600px] h-[600px] bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div
        className="absolute inset-0 opacity-[0.03] pointer-events-none"
        style={{
          backgroundImage: `linear-gradient(rgba(26, 26, 26, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 26, 26, 1) 1px, transparent 1px)`,
          backgroundSize: '60px 60px'
        }}
      />

      <div className="relative z-10 max-w-5xl mx-auto px-4 md:px-8 text-center">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-[#C5A059]/40 px-4 py-2 rounded-full mb-6"
        >
          <MessageCircle className="w-4 h-4 text-[#C5A059]" />
          <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Hubungi Kami</span>
        </motion.div>

        <motion.h1
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.1 }}
          className="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#1A1A1A] leading-[1.1] tracking-tight mb-6"
        >
          Mari Berdiskusi Tentang <br className="hidden md:block" />
          <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] via-[#C5A059] to-[#8C6F3D]">
            Solusi Anda
          </span>
        </motion.h1>

        <motion.p
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8"
        >
          Tim kami siap membantu Anda menemukan solusi autentikasi yang tepat. Pilih cara komunikasi yang paling nyaman untuk Anda.
        </motion.p>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.3 }}
          className="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-gray-600"
        >
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">Response &lt; 24 Jam</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">Konsultasi Gratis</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">Dukungan 24/7</span>
          </span>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// CONTACT METHODS - 4 Quick Access Cards
// ============================================================================
function ContactMethodsSection() {
  const methods = [
    {
      icon: <Phone className="w-6 h-6" />,
      title: 'Telepon',
      value: '+62 812-2220-1649',
      desc: 'Senin - Jumat, 09:00 - 17:00 WIB',
      href: 'tel:+6281222201649',
      action: 'Hubungi Sekarang',
      gradient: 'from-emerald-500/10 to-emerald-500/[0.02]',
      iconBg: 'bg-emerald-100',
      iconColor: 'text-emerald-600',
      accentBorder: 'border-emerald-200',
      size: 'large'
    },
    {
      icon: <Mail className="w-6 h-6" />,
      title: 'Email',
      value: 'info@authenticguards.com',
      desc: 'Respon dalam 1x24 jam kerja',
      href: 'mailto:info@authenticguards.com',
      action: 'Kirim Email',
      gradient: 'from-blue-500/10 to-blue-500/[0.02]',
      iconBg: 'bg-blue-100',
      iconColor: 'text-blue-600',
      accentBorder: 'border-blue-200',
      size: 'large'
    },
    {
      icon: <MapPin className="w-6 h-6" />,
      title: 'Kantor Pusat',
      value: 'Bandung, Jawa Barat',
      desc: 'Jl. Kh Wahid Hasyim No.316, Kopo',
      href: 'https://maps.google.com/?q=Jl.+Kh+Wahid+Hasyim+No.316+Bandung',
      action: 'Lihat di Peta',
      gradient: 'from-rose-500/10 to-rose-500/[0.02]',
      iconBg: 'bg-rose-100',
      iconColor: 'text-rose-600',
      accentBorder: 'border-rose-200',
      size: 'small'
    },
    {
      icon: <Clock className="w-6 h-6" />,
      title: 'Jam Operasional',
      value: 'Senin - Jumat',
      desc: '09:00 - 17:00 WIB',
      href: null,
      action: null,
      gradient: 'from-amber-500/10 to-amber-500/[0.02]',
      iconBg: 'bg-amber-100',
      iconColor: 'text-amber-600',
      accentBorder: 'border-amber-200',
      size: 'small'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Sparkles className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Cara Menghubungi</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Pilih Cara <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Komunikasi</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Berbagai channel komunikasi yang tersedia untuk memudahkan Anda terhubung dengan tim kami.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {methods.map((method, idx) => {
            const isLarge = method.size === 'large'
            
            return (
              <motion.a
                key={idx}
                href={method.href || undefined}
                target={method.href?.startsWith('http') ? '_blank' : undefined}
                rel={method.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, margin: "-50px" }}
                transition={{ duration: 0.5, delay: idx * 0.1 }}
                className={`group relative bg-white rounded-3xl border ${method.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden ${
                  isLarge ? 'p-8 md:p-10' : 'p-6 md:p-8'
                } ${!method.href ? 'cursor-default' : 'cursor-pointer'}`}
              >
                <div className={`absolute inset-0 bg-gradient-to-br ${method.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />
                
                <div className="relative z-10">
                  <div className="flex items-start justify-between mb-6">
                    <div className="flex items-start gap-4">
                      <div className={`w-14 h-14 ${method.iconBg} ${method.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                        {method.icon}
                      </div>
                      <div>
                        <h3 className={`${isLarge ? 'text-2xl' : 'text-xl'} font-bold text-[#1A1A1A] mb-2`}>
                          {method.title}
                        </h3>
                        <p className={`${isLarge ? 'text-lg' : 'text-base'} font-semibold text-[#8C6F3D] mb-1`}>
                          {method.value}
                        </p>
                        <p className="text-sm text-gray-500">{method.desc}</p>
                      </div>
                    </div>
                    
                    {isLarge && method.action && (
                      <div className="hidden md:flex items-center gap-1.5 bg-[#E8D09E]/20 text-[#8C6F3D] px-3 py-1.5 rounded-full text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">
                        <span>{method.action}</span>
                        <ArrowRight className="w-3.5 h-3.5" />
                      </div>
                    )}
                  </div>

                  {isLarge && method.action && (
                    <div className="flex items-center gap-2 text-[#8C6F3D] font-bold text-sm group-hover:gap-3 transition-all">
                      <span>{method.action}</span>
                      <ArrowRight className="w-4 h-4" />
                    </div>
                  )}

                  {!isLarge && method.action && method.href?.startsWith('http') && (
                    <div className="flex items-center gap-2 text-[#8C6F3D] font-bold text-sm mt-4">
                      <span>{method.action}</span>
                      <ExternalLink className="w-4 h-4" />
                    </div>
                  )}
                </div>
              </motion.a>
            )
          })}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// CONTACT FORM SECTION
// ============================================================================
function ContactFormSection() {
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    company: '',
    phone: '',
    category: 'general',
    subject: '',
    message: ''
  })
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [submitStatus, setSubmitStatus] = useState<'idle' | 'success' | 'error'>('idle')

  const categories = [
    { value: 'general', label: 'Pertanyaan Umum', icon: <HelpCircle className="w-4 h-4" /> },
    { value: 'sales', label: 'Sales & Partnership', icon: <Handshake className="w-4 h-4" /> },
    { value: 'support', label: 'Dukungan Teknis', icon: <HeadphonesIcon className="w-4 h-4" /> },
    { value: 'enterprise', label: 'Solusi Enterprise', icon: <Building2 className="w-4 h-4" /> },
    { value: 'media', label: 'Media & Press', icon: <Newspaper className="w-4 h-4" /> }
  ]

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value } = e.target
    setFormData(prev => ({ ...prev, [name]: value }))
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setIsSubmitting(true)
    
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 1500))
    
    setSubmitStatus('success')
    setIsSubmitting(false)
    
    // Reset form after 3 seconds
    setTimeout(() => {
      setFormData({
        name: '',
        email: '',
        company: '',
        phone: '',
        category: 'general',
        subject: '',
        message: ''
      })
      setSubmitStatus('idle')
    }, 3000)
  }

  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 w-96 h-96 bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
          
          {/* Left: Info Sidebar */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="lg:col-span-4 space-y-6"
          >
            <div>
              <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full mb-4">
                <Send className="w-4 h-4 text-[#8C6F3D]" />
                <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Kirim Pesan</span>
              </div>
              
              <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight mb-4">
                Ceritakan <br />
                <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">
                  Kebutuhan Anda
                </span>
              </h2>
              <p className="text-gray-600 leading-relaxed">
                Isi formulir di samping dan tim kami akan menghubungi Anda dalam 1x24 jam kerja.
              </p>
            </div>

            {/* Response Time Card */}
            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-6 text-white shadow-2xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-[#C5A059]/10 rounded-full blur-3xl" />
              
              <div className="relative z-10">
                <div className="flex items-center gap-2 mb-4">
                  <div className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
                  <span className="text-xs font-bold text-emerald-400 uppercase tracking-wider">Tim Aktif</span>
                </div>
                
                <h3 className="text-xl font-bold mb-4">Waktu Respons</h3>
                
                <div className="space-y-3">
                  {[
                    { label: 'Email', time: '< 24 jam' },
                    { label: 'Telepon', time: 'Langsung' },
                    { label: 'Form', time: '< 24 jam' },
                    { label: 'WhatsApp', time: '< 2 jam' }
                  ].map((item, idx) => (
                    <div key={idx} className="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/10">
                      <span className="text-sm text-gray-300">{item.label}</span>
                      <span className="text-sm font-bold text-[#E8D09E]">{item.time}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* Trust Indicators */}
            <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-4 flex items-center gap-2">
                <ShieldCheck className="w-5 h-5 text-emerald-600" />
                Jaminan Kami
              </h4>
              <div className="space-y-3">
                {[
                  'Data Anda aman & terenkripsi',
                  'Tidak ada spam, hanya respon relevan',
                  'Konsultasi awal gratis tanpa komitmen',
                  'Tim ahli dengan pengalaman 8+ tahun'
                ].map((item, idx) => (
                  <div key={idx} className="flex items-start gap-2">
                    <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                    <span className="text-sm text-gray-700">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </motion.div>

          {/* Right: Form */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="lg:col-span-8"
          >
            <div className="bg-white border border-[#E8D09E]/30 rounded-3xl p-6 md:p-10 shadow-sm">
              
              {/* Success Message */}
              <AnimatePresence>
                {submitStatus === 'success' && (
                  <motion.div
                    initial={{ opacity: 0, height: 0 }}
                    animate={{ opacity: 1, height: 'auto' }}
                    exit={{ opacity: 0, height: 0 }}
                    className="overflow-hidden mb-6"
                  >
                    <div className="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 flex items-start gap-4">
                      <div className="p-3 bg-emerald-100 text-emerald-700 rounded-xl shrink-0">
                        <CheckCircle2 className="w-6 h-6" />
                      </div>
                      <div>
                        <h4 className="font-bold text-emerald-900 mb-1">Pesan Terkirim!</h4>
                        <p className="text-sm text-emerald-800 leading-relaxed">
                          Terima kasih telah menghubungi kami. Tim kami akan merespon pesan Anda dalam 1x24 jam kerja.
                        </p>
                      </div>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>

              <form onSubmit={handleSubmit} className="space-y-5">
                {/* Category Selection */}
                <div className="space-y-2">
                  <label className="text-sm font-semibold text-gray-700">
                    Kategori Pertanyaan <span className="text-red-500">*</span>
                  </label>
                  <div className="grid grid-cols-2 md:grid-cols-5 gap-2">
                    {categories.map((cat) => (
                      <button
                        key={cat.value}
                        type="button"
                        onClick={() => setFormData(prev => ({ ...prev, category: cat.value }))}
                        className={`flex flex-col items-center gap-1.5 p-3 rounded-xl border-2 transition-all ${
                          formData.category === cat.value
                            ? 'border-[#C5A059] bg-[#E8D09E]/10 text-[#8C6F3D]'
                            : 'border-gray-200 hover:border-[#E8D09E]/50 text-gray-600'
                        }`}
                      >
                        {cat.icon}
                        <span className="text-xs font-semibold text-center">{cat.label}</span>
                      </button>
                    ))}
                  </div>
                </div>

                {/* Name & Email */}
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-1.5">
                    <label htmlFor="name" className="text-sm font-semibold text-gray-700">
                      Nama Lengkap <span className="text-red-500">*</span>
                    </label>
                    <input
                      id="name"
                      type="text"
                      name="name"
                      required
                      value={formData.name}
                      onChange={handleChange}
                      className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                      placeholder="Nama lengkap Anda"
                    />
                  </div>
                  <div className="space-y-1.5">
                    <label htmlFor="email" className="text-sm font-semibold text-gray-700">
                      Email <span className="text-red-500">*</span>
                    </label>
                    <input
                      id="email"
                      type="email"
                      name="email"
                      required
                      value={formData.email}
                      onChange={handleChange}
                      className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                      placeholder="email@perusahaan.com"
                    />
                  </div>
                </div>

                {/* Company & Phone */}
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-1.5">
                    <label htmlFor="company" className="text-sm font-semibold text-gray-700">
                      Perusahaan
                    </label>
                    <input
                      id="company"
                      type="text"
                      name="company"
                      value={formData.company}
                      onChange={handleChange}
                      className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                      placeholder="Nama perusahaan (opsional)"
                    />
                  </div>
                  <div className="space-y-1.5">
                    <label htmlFor="phone" className="text-sm font-semibold text-gray-700">
                      Nomor Telepon
                    </label>
                    <input
                      id="phone"
                      type="tel"
                      name="phone"
                      value={formData.phone}
                      onChange={handleChange}
                      className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                      placeholder="+62 812-xxxx-xxxx"
                    />
                  </div>
                </div>

                {/* Subject */}
                <div className="space-y-1.5">
                  <label htmlFor="subject" className="text-sm font-semibold text-gray-700">
                    Subjek <span className="text-red-500">*</span>
                  </label>
                  <input
                    id="subject"
                    type="text"
                    name="subject"
                    required
                    value={formData.subject}
                    onChange={handleChange}
                    className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                    placeholder="Ringkasan singkat pesan Anda"
                  />
                </div>

                {/* Message */}
                <div className="space-y-1.5">
                  <label htmlFor="message" className="text-sm font-semibold text-gray-700">
                    Pesan <span className="text-red-500">*</span>
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows={6}
                    value={formData.message}
                    onChange={handleChange}
                    className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white resize-none"
                    placeholder="Ceritakan kebutuhan atau pertanyaan Anda secara detail..."
                  />
                  <p className="text-xs text-gray-500 text-right">
                    {formData.message.length} karakter
                  </p>
                </div>

                {/* Privacy Notice */}
                <div className="flex items-start gap-2 p-4 bg-[#FAF8F5] rounded-xl border border-[#E8D09E]/30">
                  <ShieldCheck className="w-4 h-4 text-[#8C6F3D] shrink-0 mt-0.5" />
                  <p className="text-xs text-gray-600 leading-relaxed">
                    Dengan mengirim formulir ini, Anda menyetujui{' '}
                    <Link to="/privacy-policy" className="text-[#8C6F3D] font-semibold hover:underline">Kebijakan Privasi</Link>
                    {' '}kami. Data Anda akan diproses dengan aman dan hanya digunakan untuk merespon pertanyaan Anda.
                  </p>
                </div>

                {/* Submit Button */}
                <button
                  type="submit"
                  disabled={isSubmitting || submitStatus === 'success'}
                  className="w-full flex items-center justify-center gap-2 bg-[#1A1A1A] text-white font-bold py-4 rounded-xl hover:bg-[#8C6F3D] disabled:opacity-70 disabled:cursor-not-allowed transition-all duration-300 shadow-lg hover:shadow-[#8C6F3D]/30 hover:-translate-y-0.5 active:translate-y-0"
                >
                  {isSubmitting ? (
                    <>
                      <Loader2 className="w-5 h-5 animate-spin" />
                      <span>Mengirim Pesan...</span>
                    </>
                  ) : submitStatus === 'success' ? (
                    <>
                      <CheckCircle2 className="w-5 h-5" />
                      <span>Pesan Terkirim!</span>
                    </>
                  ) : (
                    <>
                      <span>Kirim Pesan</span>
                      <Send className="w-5 h-5" />
                    </>
                  )}
                </button>
              </form>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DEPARTMENT CONTACTS SECTION
// ============================================================================
function DepartmentContactsSection() {
  const departments = [
    {
      icon: <Handshake className="w-6 h-6" />,
      title: 'Sales & Partnership',
      desc: 'Untuk diskusi solusi, pricing, dan partnership strategis.',
      email: 'sales@authenticguards.com',
      phone: '+62 812-2220-1650',
      gradient: 'from-emerald-500/10 to-emerald-500/[0.02]',
      iconBg: 'bg-emerald-100',
      iconColor: 'text-emerald-600',
      accentBorder: 'border-emerald-200'
    },
    {
      icon: <HeadphonesIcon className="w-6 h-6" />,
      title: 'Dukungan Teknis',
      desc: 'Untuk bantuan teknis, troubleshooting, dan integrasi API.',
      email: 'support@authenticguards.com',
      phone: '+62 812-2220-1651',
      gradient: 'from-blue-500/10 to-blue-500/[0.02]',
      iconBg: 'bg-blue-100',
      iconColor: 'text-blue-600',
      accentBorder: 'border-blue-200'
    },
    {
      icon: <Building2 className="w-6 h-6" />,
      title: 'Enterprise Solutions',
      desc: 'Untuk klien enterprise dengan kebutuhan custom dan skala besar.',
      email: 'enterprise@authenticguards.com',
      phone: '+62 812-2220-1652',
      gradient: 'from-purple-500/10 to-purple-500/[0.02]',
      iconBg: 'bg-purple-100',
      iconColor: 'text-purple-600',
      accentBorder: 'border-purple-200'
    },
    {
      icon: <Newspaper className="w-6 h-6" />,
      title: 'Media & Press',
      desc: 'Untuk permintaan wawancara, press release, dan kolaborasi media.',
      email: 'media@authenticguards.com',
      phone: '+62 812-2220-1653',
      gradient: 'from-rose-500/10 to-rose-500/[0.02]',
      iconBg: 'bg-rose-100',
      iconColor: 'text-rose-600',
      accentBorder: 'border-rose-200'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Users className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Tim Spesialis</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Kontak <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Per Departemen</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Hubungi langsung tim yang paling sesuai dengan kebutuhan Anda untuk respon yang lebih cepat.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {departments.map((dept, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className={`group relative bg-white rounded-3xl border ${dept.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden p-8`}
            >
              <div className={`absolute inset-0 bg-gradient-to-br ${dept.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />
              
              <div className="relative z-10">
                <div className="flex items-start gap-4 mb-6">
                  <div className={`w-14 h-14 ${dept.iconBg} ${dept.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                    {dept.icon}
                  </div>
                  <div>
                    <h3 className="text-xl font-bold text-[#1A1A1A] mb-2">{dept.title}</h3>
                    <p className="text-sm text-gray-600 leading-relaxed">{dept.desc}</p>
                  </div>
                </div>

                <div className="space-y-2 pt-4 border-t border-gray-100">
                  <a 
                    href={`mailto:${dept.email}`}
                    className="flex items-center gap-3 p-3 rounded-xl hover:bg-white/50 transition-colors group/link"
                  >
                    <Mail className="w-4 h-4 text-gray-400 group-hover/link:text-[#8C6F3D] transition-colors" />
                    <span className="text-sm font-semibold text-gray-700 group-hover/link:text-[#8C6F3D] transition-colors">{dept.email}</span>
                  </a>
                  <a 
                    href={`tel:${dept.phone.replace(/[^0-9+]/g, '')}`}
                    className="flex items-center gap-3 p-3 rounded-xl hover:bg-white/50 transition-colors group/link"
                  >
                    <Phone className="w-4 h-4 text-gray-400 group-hover/link:text-[#8C6F3D] transition-colors" />
                    <span className="text-sm font-semibold text-gray-700 group-hover/link:text-[#8C6F3D] transition-colors">{dept.phone}</span>
                  </a>
                </div>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// OFFICE LOCATION SECTION
// ============================================================================
function OfficeLocationSection() {
  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <MapPin className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Lokasi Kantor</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Kunjungi <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Kantor Kami</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Kami menyambut kunjungan Anda di kantor pusat kami di Bandung.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* Map Placeholder */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="relative rounded-3xl overflow-hidden shadow-xl min-h-[400px] bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a]"
          >
            <div className="absolute inset-0 opacity-20"
              style={{
                backgroundImage: `linear-gradient(rgba(232, 208, 158, 0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(232, 208, 158, 0.3) 1px, transparent 1px)`,
                backgroundSize: '40px 40px'
              }}
            />
            
            <div className="absolute inset-0 flex flex-col items-center justify-center p-8 text-center">
              <div className="w-20 h-20 bg-[#E8D09E]/20 rounded-2xl flex items-center justify-center mb-4 border border-[#E8D09E]/30">
                <MapPin className="w-10 h-10 text-[#E8D09E]" />
              </div>
              <h3 className="text-xl font-bold text-white mb-2">Kantor Pusat AuthenticGuards</h3>
              <p className="text-sm text-gray-400 mb-6 max-w-sm">
                Jl. Kh Wahid Hasyim No.316, Kopo, Bojongloa Kaler, Kota Bandung, Jawa Barat 40233
              </p>
              <a
                href="https://maps.google.com/?q=Jl.+Kh+Wahid+Hasyim+No.316+Bandung"
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex items-center gap-2 bg-[#C5A059] text-[#1A1A1A] px-6 py-3 rounded-xl font-bold hover:bg-[#E8D09E] transition-all duration-300"
              >
                <span>Buka di Google Maps</span>
                <ExternalLink className="w-4 h-4" />
              </a>
            </div>
          </motion.div>

          {/* Office Details */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-4"
          >
            <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
              <div className="flex items-start gap-4">
                <div className="w-12 h-12 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
                  <Building2 className="w-6 h-6" />
                </div>
                <div>
                  <p className="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Kantor Pusat</p>
                  <h3 className="text-lg font-bold text-[#1A1A1A] mb-2">PT. Autentikasi Garda Teknologi</h3>
                  <p className="text-sm text-gray-600 leading-relaxed">
                    Jl. Kh Wahid Hasyim No.316, Kopo, Bojongloa Kaler, Kota Bandung, Jawa Barat 40233, Indonesia
                  </p>
                </div>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
                <div className="flex items-start gap-3 mb-3">
                  <Clock className="w-5 h-5 text-[#8C6F3D] shrink-0" />
                  <h4 className="font-bold text-[#1A1A1A]">Jam Operasional</h4>
                </div>
                <div className="space-y-2 text-sm">
                  <div className="flex justify-between">
                    <span className="text-gray-600">Senin - Kamis</span>
                    <span className="font-semibold text-[#1A1A1A]">09:00 - 17:00</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-gray-600">Jumat</span>
                    <span className="font-semibold text-[#1A1A1A]">09:00 - 16:30</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-gray-600">Sabtu - Minggu</span>
                    <span className="font-semibold text-red-500">Tutup</span>
                  </div>
                </div>
              </div>

              <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
                <div className="flex items-start gap-3 mb-3">
                  <Calendar className="w-5 h-5 text-[#8C6F3D] shrink-0" />
                  <h4 className="font-bold text-[#1A1A1A]">Hari Libur</h4>
                </div>
                <p className="text-sm text-gray-600 leading-relaxed mb-3">
                  Kantor tutup pada hari libur nasional Indonesia.
                </p>
                <div className="flex items-center gap-2 text-xs text-gray-500">
                  <AlertCircle className="w-3.5 h-3.5" />
                  <span>Respon mungkin lebih lambat di hari libur</span>
                </div>
              </div>
            </div>

            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-6 text-white shadow-xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-[#C5A059]/10 rounded-full blur-3xl" />
              
              <div className="relative z-10">
                <div className="flex items-center gap-2 mb-4">
                  <Award className="w-5 h-5 text-[#E8D09E]" />
                  <h4 className="font-bold">Kunjungan Bisnis</h4>
                </div>
                <p className="text-sm text-gray-300 leading-relaxed mb-4">
                  Untuk kunjungan bisnis atau meeting, harap buat janji terlebih dahulu melalui email atau telepon.
                </p>
                <a
                  href="mailto:info@authenticguards.com?subject=Permintaan%20Kunjungan%20Kantor"
                  className="inline-flex items-center gap-2 text-[#E8D09E] font-bold text-sm hover:text-[#C5A059] transition-colors"
                >
                  <span>Buat Janji Kunjungan</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// FAQ SECTION
// ============================================================================
function FAQSection() {
  const [openIndex, setOpenIndex] = useState<number | null>(0)

  const faqs = [
    {
      q: "Berapa lama waktu respons untuk pertanyaan saya?",
      a: "Kami berkomitmen untuk merespon semua pertanyaan dalam waktu 1x24 jam kerja. Untuk pertanyaan mendesak, Anda dapat menghubungi kami langsung melalui telepon di +62 812-2220-1649 pada jam operasional."
    },
    {
      q: "Apakah konsultasi awal berbayar?",
      a: "Tidak, konsultasi awal sepenuhnya gratis tanpa komitmen. Tim kami akan membantu memahami kebutuhan Anda dan merekomendasikan solusi yang paling sesuai sebelum Anda membuat keputusan."
    },
    {
      q: "Apakah saya harus datang ke kantor untuk konsultasi?",
      a: "Tidak perlu. Kami menyediakan konsultasi online melalui video call untuk kenyamanan Anda. Namun, jika Anda ingin mengunjungi kantor kami, silakan buat janji terlebih dahulu."
    },
    {
      q: "Informasi apa yang perlu saya siapkan sebelum menghubungi?",
      a: "Untuk respon yang lebih cepat, siapkan informasi tentang: jenis produk yang ingin diproteksi, volume produksi, target pasar, dan timeline implementasi yang diinginkan."
    },
    {
      q: "Apakah AuthenticGuards melayani klien di luar Indonesia?",
      a: "Ya, kami melayani klien di seluruh Asia Tenggara termasuk Malaysia, Singapura, Thailand, dan Vietnam. Tim kami dapat berkomunikasi dalam Bahasa Indonesia dan English."
    },
    {
      q: "Bagaimana jika saya memiliki pertanyaan teknis tentang API?",
      a: "Untuk pertanyaan teknis dan integrasi API, silakan hubungi tim Dukungan Teknis kami di support@authenticguards.com atau melalui kategori 'Dukungan Teknis' di formulir kontak."
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-4xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <HelpCircle className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">FAQ</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Pertanyaan <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Umum</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Jawaban untuk pertanyaan yang sering diajukan sebelum menghubungi kami.
          </p>
        </motion.div>

        <div className="space-y-3">
          {faqs.map((faq, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 10 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ delay: idx * 0.05 }}
              className="bg-[#FAF8F5] rounded-2xl border border-gray-100 overflow-hidden hover:border-[#E8D09E]/40 transition-all"
            >
              <button
                onClick={() => setOpenIndex(openIndex === idx ? null : idx)}
                className="w-full flex items-center justify-between gap-4 p-5 text-left"
              >
                <h3 className="font-bold text-[#1A1A1A] text-base md:text-lg pr-4">
                  {faq.q}
                </h3>
                <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-all ${
                  openIndex === idx
                    ? 'bg-[#C5A059] text-white rotate-180'
                    : 'bg-white text-[#8C6F3D]'
                }`}>
                  <ChevronDown className="w-4 h-4" />
                </div>
              </button>

              <AnimatePresence>
                {openIndex === idx && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: 'auto', opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    transition={{ duration: 0.3 }}
                    className="overflow-hidden"
                  >
                    <div className="px-5 pb-5 pt-0">
                      <div className="pt-4 border-t border-gray-200">
                        <p className="text-sm text-gray-600 leading-relaxed">
                          {faq.a}
                        </p>
                      </div>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </motion.div>
          ))}
        </div>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ delay: 0.4 }}
          className="mt-12 text-center"
        >
          <p className="text-gray-500 mb-4">
            Masih ada pertanyaan? Kami siap membantu.
          </p>
          <a
            href="#contact-form"
            className="inline-flex items-center gap-2 text-[#8C6F3D] font-bold hover:text-[#6b5530] transition-colors group"
          >
            <span>Kirim Pesan ke Tim Kami</span>
            <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// CTA SECTION
// ============================================================================
function ContactCTA() {
  return (
    <section className="py-16 md:py-24 bg-white relative overflow-hidden">
      <div className="max-w-5xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="relative bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 md:p-16 text-white text-center shadow-2xl overflow-hidden"
        >
          <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/15 rounded-full blur-3xl pointer-events-none" />
          <div className="absolute bottom-0 left-0 w-72 h-72 bg-[#8C6F3D]/10 rounded-full blur-3xl pointer-events-none" />

          <div className="relative z-10 space-y-6 max-w-2xl mx-auto">
            <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-1.5 rounded-full">
              <Handshake className="w-4 h-4 text-[#E8D09E]" />
              <span className="text-xs font-bold text-[#E8D09E] tracking-wider uppercase">Mulai Kolaborasi</span>
            </div>

            <h2 className="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight">
              Siap Melindungi <br className="hidden md:block" />
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#E8D09E] to-[#C5A059]">
                Brand Anda?
              </span>
            </h2>

            <p className="text-gray-300 text-lg leading-relaxed">
              Bergabunglah dengan 500+ brand yang telah mempercayakan perlindungan produk mereka kepada AuthenticGuards.
            </p>

            <div className="flex flex-col sm:flex-row gap-4 justify-center pt-4">
              <a
                href="#contact-form"
                className="group inline-flex items-center justify-center gap-3 bg-[#C5A059] text-[#1A1A1A] px-8 py-4 rounded-xl font-bold text-lg hover:bg-[#E8D09E] transition-all duration-300 shadow-lg hover:shadow-[#C5A059]/30 hover:-translate-y-0.5"
              >
                <span>Hubungi Tim Kami</span>
                <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
              </a>
              <Link
                to="/services"
                className="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-all duration-300"
              >
                <Briefcase className="w-5 h-5" />
                <span>Lihat Layanan</span>
              </Link>
            </div>

            <div className="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-6 text-xs text-gray-400">
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Konsultasi Gratis
              </span>
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Response &lt; 24 Jam
              </span>
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Tanpa Komitmen
              </span>
            </div>
          </div>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// MAIN PAGE
// ============================================================================
export default function ContactPage() {
  return (
    <>
      <HeroContact />
      <ContactMethodsSection />
      <div id="contact-form">
        <ContactFormSection />
      </div>
      <DepartmentContactsSection />
      <OfficeLocationSection />
      <FAQSection />
      <ContactCTA />
    </>
  )
}