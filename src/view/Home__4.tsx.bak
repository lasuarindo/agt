// ============================================================================
// SERVICES SECTION - Bento Grid dengan Featured Services
// ============================================================================
function ServicesSection() {
  const services = [
    {
      id: 'hologram',
      icon: <Tag className="w-7 h-7" />,
      title: "Sticker Hologram",
      subtitle: "Flagship Product",
      desc: "Solusi autentikasi paling populer kami. Sticker hologram premium dengan QR code unik dan scratch PIN 6 digit yang terintegrasi dengan database real-time.",
      highlights: [
        { label: "Produk Terverifikasi", value: "10M+" },
        { label: "Tingkat Akurasi", value: "99.9%" }
      ],
      industries: ["Semua Industri", "FMCG", "Elektronik", "Farmasi"],
      gradient: "from-emerald-500/10 to-emerald-500/[0.02]",
      iconBg: "bg-emerald-100",
      iconColor: "text-emerald-600",
      accentBorder: "border-emerald-200",
      size: "large"
    },
    {
      id: 'garment',
      icon: <Layers className="w-6 h-6" />,
      title: "Garment Label",
      desc: "Label tekstil khusus untuk industri fashion dengan integrasi QR code dan scratch PIN yang tahan cuci dan estetis.",
      industries: ["Fashion", "Apparel", "Footwear"],
      gradient: "from-[#C5A059]/10 to-[#E8D09E]/5",
      iconBg: "bg-[#E8D09E]/30",
      iconColor: "text-[#8C6F3D]",
      accentBorder: "border-[#E8D09E]/40",
      size: "small"
    },
    {
      id: 'supply',
      icon: <Lock className="w-6 h-6" />,
      title: "Supply Chain Security",
      desc: "Amankan rantai pasok dari hulu ke hilir dengan sistem tracking dan verifikasi di setiap titik distribusi.",
      industries: ["Distributor", "Manufacturer", "Logistics"],
      gradient: "from-purple-500/10 to-purple-500/[0.02]",
      iconBg: "bg-purple-100",
      iconColor: "text-purple-600",
      accentBorder: "border-purple-200",
      size: "small"
    },
    {
      id: 'protection',
      icon: <Shield className="w-7 h-7" />,
      title: "Brand Protection",
      subtitle: "Enterprise Solution",
      desc: "Solusi komprehensif untuk melindungi reputasi brand dari produk palsu. Dilengkapi dashboard analytics real-time dan sistem alert otomatis.",
      highlights: [
        { label: "Brand Dilindungi", value: "500+" },
        { label: "Response Time", value: "<1s" }
      ],
      industries: ["Enterprise", "Premium Brand", "Luxury Goods"],
      gradient: "from-blue-500/10 to-blue-500/[0.02]",
      iconBg: "bg-blue-100",
      iconColor: "text-blue-600",
      accentBorder: "border-blue-200",
      size: "large"
    }
  ]

  return (
    <section id="services" className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <p className="text-[#8C6F3D] font-bold tracking-widest uppercase text-xs">Layanan Kami</p>
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Solusi Anti-Counterfeit <span className="text-transparent bg-clip-text bg-linear-to-r from-[#8C6F3D] to-[#C5A059]">Terlengkap</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Berbagai layanan autentikasi yang dirancang khusus untuk melindungi brand dan kepuasan konsumen di Asia Pasifik.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {services.map((service, idx) => {
            const isLarge = service.size === 'large'
            
            return (
              <motion.div
                key={service.id}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, margin: "-50px" }}
                transition={{ duration: 0.5, delay: idx * 0.1 }}
                className={`group relative bg-white rounded-3xl border ${service.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden ${
                  isLarge ? 'p-8 md:p-10' : 'p-6 md:p-8'
                }`}
              >
                <div className={`absolute inset-0 bg-linear-to-br ${service.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />
                
                <div className="relative z-10">
                  <div className="flex items-start justify-between mb-6">
                    <div className="flex items-start gap-4">
                      <div className={`w-14 h-14 ${service.iconBg} ${service.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                        {service.icon}
                      </div>
                      <div>
                        {service.subtitle && (
                          <span className="text-[10px] font-bold text-[#8C6F3D] uppercase tracking-widest mb-1 block">
                            {service.subtitle}
                          </span>
                        )}
                        <h3 className={`${isLarge ? 'text-2xl' : 'text-xl'} font-bold text-[#1A1A1A] mb-2`}>
                          {service.title}
                        </h3>
                      </div>
                    </div>
                    
                    {isLarge && (
                      <div className="hidden md:flex items-center gap-1.5 bg-[#E8D09E]/20 text-[#8C6F3D] px-3 py-1.5 rounded-full text-xs font-bold">
                        <Sparkles className="w-3.5 h-3.5" />
                        <span>Popular</span>
                      </div>
                    )}
                  </div>

                  <p className={`text-gray-600 leading-relaxed mb-6 ${isLarge ? 'text-base' : 'text-sm'}`}>
                    {service.desc}
                  </p>

                  {service.highlights && isLarge && (
                    <div className="grid grid-cols-2 gap-4 mb-6 p-4 bg-white/50 backdrop-blur-sm rounded-2xl border border-gray-100">
                      {service.highlights.map((stat, sIdx) => (
                        <div key={sIdx} className="text-center">
                          <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
                          <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
                        </div>
                      ))}
                    </div>
                  )}

                  {service.industries && (
                    <div className="mb-6">
                      <p className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                        Cocok untuk:
                      </p>
                      <div className="flex flex-wrap gap-2">
                        {service.industries.map((industry, iIdx) => (
                          <span 
                            key={iIdx}
                            className="text-xs font-semibold text-gray-600 bg-gray-100 px-3 py-1.5 rounded-full hover:bg-[#E8D09E]/20 hover:text-[#8C6F3D] transition-colors"
                          >
                            {industry}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  <Link
                    to="/contact"
                    className="inline-flex items-center gap-2 text-[#8C6F3D] font-bold text-sm hover:text-[#6b5530] transition-colors group/link"
                  >
                    <span>Pelajari Lebih Lanjut</span>
                    <ArrowRight className="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
                  </Link>
                </div>
              </motion.div>
            )
          })}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// TECHNOLOGY BENTO GRID
// ============================================================================
function TechnologySection() {
  const features = [
    {
      id: 'triple-layer',
      icon: <Shield className="w-7 h-7" />,
      title: "Keamanan Triple-Layer",
      subtitle: "Core Technology",
      desc: "Sistem keamanan berlapis yang menggabungkan tiga teknologi autentikasi dalam satu label. Setiap lapisan bekerja sinergis untuk menciptakan proteksi yang hampir mustahil dipalsukan.",
      highlights: [
        { label: "Tingkat Keamanan", value: "99.9%" },
        { label: "Waktu Verifikasi", value: "<1s" }
      ],
      gradient: "from-emerald-500/10 to-emerald-500/[0.02]",
      iconBg: "bg-emerald-100",
      iconColor: "text-emerald-600",
      accentBorder: "border-emerald-200",
      size: "large"
    },
    {
      id: 'instant',
      icon: <Zap className="w-6 h-6" />,
      title: "Verifikasi Instan",
      desc: "Scan sekali untuk verifikasi instan dalam hitungan milidetik tanpa perlu koneksi internet stabil.",
      gradient: "from-amber-500/10 to-amber-500/[0.02]",
      iconBg: "bg-amber-100",
      iconColor: "text-amber-600",
      accentBorder: "border-amber-200",
      size: "small"
    },
    {
      id: 'mobile',
      icon: <Smartphone className="w-6 h-6" />,
      title: "Mobile Friendly",
      desc: "Akses verifikasi dari smartphone kapan saja dan di mana saja dengan UI yang intuitif.",
      gradient: "from-blue-500/10 to-blue-500/[0.02]",
      iconBg: "bg-blue-100",
      iconColor: "text-blue-600",
      accentBorder: "border-blue-200",
      size: "small"
    },
    {
      id: 'anti-duplicate',
      icon: <Eye className="w-6 h-6" />,
      title: "Anti-Duplikasi",
      desc: "Sistem validasi yang memastikan setiap kode hanya bisa diverifikasi satu kali untuk mencegah penyalahgunaan.",
      gradient: "from-purple-500/10 to-purple-500/[0.02]",
      iconBg: "bg-purple-100",
      iconColor: "text-purple-600",
      accentBorder: "border-purple-200",
      size: "small"
    },
    {
      id: 'hologram',
      icon: <Sparkles className="w-6 h-6" />,
      title: "Hologram Premium",
      desc: "Teknologi hologram yang tidak dapat dipalsukan dengan visual effect yang menarik dan sulit ditiru.",
      gradient: "from-pink-500/10 to-pink-500/[0.02]",
      iconBg: "bg-pink-100",
      iconColor: "text-pink-600",
      accentBorder: "border-pink-200",
      size: "small"
    },
    {
      id: 'analytics',
      icon: <TrendingUp className="w-7 h-7" />,
      title: "Analytics Dashboard",
      subtitle: "Enterprise Feature",
      desc: "Dashboard analitik real-time yang komprehensif untuk monitoring semua produk, klaim, dan aktivitas verifikasi. Dilengkapi dengan alert system dan reporting otomatis.",
      highlights: [
        { label: "Real-time Sync", value: "100%" },
        { label: "Data Retention", value: "5+ Tahun" }
      ],
      gradient: "from-[#C5A059]/10 to-[#E8D09E]/5",
      iconBg: "bg-[#E8D09E]/30",
      iconColor: "text-[#8C6F3D]",
      accentBorder: "border-[#E8D09E]/40",
      size: "large"
    }
  ]

  return (
    <section id="technology" className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <p className="text-[#8C6F3D] font-bold tracking-widest uppercase text-xs">Teknologi Kami</p>
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Dibangun dengan <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Teknologi Terdepan</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Setiap fitur dirancang untuk memberikan jaminan keaslian produk yang tak tertandingi.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {features.map((feature, idx) => {
            const isLarge = feature.size === 'large'
            
            return (
              <motion.div
                key={feature.id}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, margin: "-50px" }}
                transition={{ duration: 0.5, delay: idx * 0.08 }}
                className={`group relative bg-white rounded-3xl border ${feature.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden ${
                  isLarge ? 'md:col-span-2 p-8 md:p-10' : 'p-6 md:p-8'
                }`}
              >
                <div className={`absolute inset-0 bg-gradient-to-br ${feature.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />
                
                <div className="relative z-10">
                  <div className="flex items-start justify-between mb-6">
                    <div className="flex items-start gap-4">
                      <div className={`w-14 h-14 ${feature.iconBg} ${feature.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                        {feature.icon}
                      </div>
                      <div>
                        {'subtitle' in feature && feature.subtitle && (
                          <span className="text-[10px] font-bold text-[#8C6F3D] uppercase tracking-widest mb-1 block">
                            {feature.subtitle}
                          </span>
                        )}
                        <h3 className={`${isLarge ? 'text-2xl' : 'text-xl'} font-bold text-[#1A1A1A] mb-2`}>
                          {feature.title}
                        </h3>
                      </div>
                    </div>
                    
                    {isLarge && (
                      <div className="hidden md:flex items-center gap-1.5 bg-[#E8D09E]/20 text-[#8C6F3D] px-3 py-1.5 rounded-full text-xs font-bold">
                        <Sparkles className="w-3.5 h-3.5" />
                        <span>Featured</span>
                      </div>
                    )}
                  </div>

                  <p className={`text-gray-600 leading-relaxed mb-6 ${isLarge ? 'text-base' : 'text-sm'}`}>
                    {feature.desc}
                  </p>

                  {'highlights' in feature && feature.highlights && isLarge && (
                    <div className="grid grid-cols-2 gap-4 mb-6 p-4 bg-white/50 backdrop-blur-sm rounded-2xl border border-gray-100">
                      {feature.highlights.map((stat, sIdx) => (
                        <div key={sIdx} className="text-center">
                          <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
                          <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
                        </div>
                      ))}
                    </div>
                  )}

                  <Link
                    to="/contact"
                    className="inline-flex items-center gap-2 text-[#8C6F3D] font-bold text-sm hover:text-[#6b5530] transition-colors group/link"
                  >
                    <span>Pelajari Lebih Lanjut</span>
                    <ArrowRight className="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
                  </Link>
                </div>
              </motion.div>
            )
          })}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// STATS SECTION - Satu-satunya section stats yang komprehensif
// ============================================================================
function StatsSection() {
  const stats = useMemo(() => {
    const rawStats = [
      { value: 8, suffix: '+', label: 'Tahun Berkiprah', icon: <Calendar className="w-6 h-6" />, desc: 'Sejak 2017 hingga sekarang' },
      { value: 500, suffix: '+', label: 'Brand Partner', icon: <Building2 className="w-6 h-6" />, desc: 'Dari berbagai industri' },
      { value: 10000000, suffix: '+', label: 'Produk Terverifikasi', icon: <Package className="w-6 h-6" />, desc: 'Hingga hari ini' },
      { value: 99.9, suffix: '%', label: 'Akurasi Sistem', icon: <BadgeCheck className="w-6 h-6" />, desc: 'Verifikasi real-time' }
    ];
    
    return rawStats.map(v => {
      if (v.value > 999) {
        const part = compactParts(v.value);
        return {
          ...v,
          value: part.value,
          suffix: `${part.compact}${v.suffix}`,
          decimal: +!Number.isInteger(v.value)
        }
      }
      return { ...v, decimal: +!Number.isInteger(v.value) }
    })
  }, []);

  return (
    <section className="py-16 md:py-24 bg-linear-to-br from-[#1A1A1A] to-[#2a2a2a] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 w-96 h-96 bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <p className="text-[#E8D09E] font-bold tracking-widest uppercase text-xs">Dampak Kami</p>
          <h2 className="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
            Angka yang <span className="text-transparent bg-clip-text bg-linear-to-r from-[#E8D09E] to-[#C5A059]">Berbicara</span>
          </h2>
          <p className="text-gray-400 text-lg leading-relaxed">
            Delapan tahun dedikasi dalam melindungi brand dan konsumen di Asia Pasifik.
          </p>
        </motion.div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
          {stats.map((stat, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl p-6 hover:bg-white/10 hover:border-[#E8D09E]/30 transition-all group"
            >
              <div className="w-12 h-12 bg-[#E8D09E]/20 text-[#E8D09E] rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                {stat.icon}
              </div>
              <p className="text-4xl md:text-5xl font-extrabold text-white mb-2 tracking-tight">
                <CountUp start={0} end={stat.value} suffix={stat.suffix} decimals={stat.decimal} />
              </p>
              <p className="text-sm font-bold text-[#E8D09E] mb-1">{stat.label}</p>
              <p className="text-xs text-gray-400">{stat.desc}</p>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

