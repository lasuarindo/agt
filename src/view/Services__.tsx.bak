import { useState } from 'react'
import { Link } from 'react-router'
import { motion, AnimatePresence } from 'motion/react'
import {
  Shield,
  ShieldCheck,
  Tag,
  Layers,
  Lock,
  Eye,
  Zap,
  CheckCircle2,
  ArrowRight,
  Sparkles,
  Package,
  QrCode,
  Fingerprint,
  TrendingUp,
  Smartphone,
  BarChart3,
  AlertTriangle,
  Clock,
  Users,
  Building2,
  Globe,
  Award,
  ChevronDown,
  ChevronRight,
  Target,
  Lightbulb,
  Handshake,
  FileCheck,
  ScanLine,
  Database,
  Bell,
  LineChart,
  Truck,
  Factory,
  Boxes,
  Search
} from 'lucide-react'

// ============================================================================
// HERO SERVICES SECTION
// ============================================================================
function HeroServices() {
  return (
    <section className="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden">
      <div className="absolute inset-0 bg-gradient-to-br from-[#FAF8F5] via-[#F5EFE6] to-[#E8D09E]/20" />
      <div className="absolute top-0 right-0 -mt-32 -mr-32 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 -mb-32 -ml-32 w-[600px] h-[600px] bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div
        className="absolute inset-0 opacity-[0.03] pointer-events-none"
        style={{
          backgroundImage: `linear-gradient(rgba(26, 26, 26, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 26, 26, 1) 1px, transparent 1px)`,
          backgroundSize: '60px 60px'
        }}
      />

      <div className="relative z-10 max-w-5xl mx-auto px-4 md:px-8 text-center">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-[#C5A059]/40 px-4 py-2 rounded-full mb-6"
        >
          <Sparkles className="w-4 h-4 text-[#C5A059]" />
          <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Layanan Kami</span>
        </motion.div>

        <motion.h1
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.1 }}
          className="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#1A1A1A] leading-[1.1] tracking-tight mb-6"
        >
          Solusi Anti-Counterfeit <br className="hidden md:block" />
          <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] via-[#C5A059] to-[#8C6F3D]">
            Terlengkap
          </span>
          <br className="hidden md:block" />
          untuk Brand Anda
        </motion.h1>

        <motion.p
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8"
        >
          Dari sticker hologram hingga supply chain security, kami menyediakan ekosistem autentikasi end-to-end yang dirancang khusus untuk melindungi brand dan membangun kepercayaan konsumen di Asia Pasifik.
        </motion.p>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.3 }}
          className="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-gray-600"
        >
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">4 Layanan Utama</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">Customizable</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">Terintegrasi Penuh</span>
          </span>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// SERVICES OVERVIEW - 4 Layanan Utama
// ============================================================================
function ServicesOverview() {
  const services = [
    {
      id: 'hologram',
      icon: <Tag className="w-7 h-7" />,
      title: "Sticker Hologram",
      subtitle: "Flagship Product",
      desc: "Solusi autentikasi paling populer kami dengan teknologi hologram premium, QR code unik, dan scratch PIN 6 digit.",
      highlights: [
        { label: "Produk Terverifikasi", value: "10M+" },
        { label: "Tingkat Akurasi", value: "99.9%" }
      ],
      industries: ["Semua Industri", "FMCG", "Elektronik", "Farmasi"],
      gradient: "from-emerald-500/10 to-emerald-500/[0.02]",
      iconBg: "bg-emerald-100",
      iconColor: "text-emerald-600",
      accentBorder: "border-emerald-200"
    },
    {
      id: 'garment',
      icon: <Layers className="w-7 h-7" />,
      title: "Garment Label",
      subtitle: "Fashion Solution",
      desc: "Label tekstil khusus untuk industri fashion dengan integrasi QR code dan scratch PIN yang tahan cuci.",
      highlights: [
        { label: "Brand Fashion", value: "100+" },
        { label: "Tahan Cuci", value: "50x+" }
      ],
      industries: ["Fashion", "Apparel", "Footwear", "Accessories"],
      gradient: "from-[#C5A059]/10 to-[#E8D09E]/5",
      iconBg: "bg-[#E8D09E]/30",
      iconColor: "text-[#8C6F3D]",
      accentBorder: "border-[#E8D09E]/40"
    },
    {
      id: 'protection',
      icon: <Shield className="w-7 h-7" />,
      title: "Brand Protection",
      subtitle: "Enterprise Solution",
      desc: "Solusi komprehensif untuk melindungi reputasi brand dengan monitoring real-time dan sistem alert otomatis.",
      highlights: [
        { label: "Brand Dilindungi", value: "500+" },
        { label: "Response Time", value: "<1s" }
      ],
      industries: ["Enterprise", "Premium Brand", "Luxury Goods"],
      gradient: "from-blue-500/10 to-blue-500/[0.02]",
      iconBg: "bg-blue-100",
      iconColor: "text-blue-600",
      accentBorder: "border-blue-200"
    },
    {
      id: 'supply',
      icon: <Lock className="w-7 h-7" />,
      title: "Supply Chain Security",
      subtitle: "Logistics Solution",
      desc: "Amankan rantai pasok dari hulu ke hilir dengan sistem tracking dan verifikasi di setiap titik distribusi.",
      highlights: [
        { label: "Titik Distribusi", value: "10K+" },
        { label: "Uptime", value: "99.99%" }
      ],
      industries: ["Distributor", "Manufacturer", "Logistics"],
      gradient: "from-purple-500/10 to-purple-500/[0.02]",
      iconBg: "bg-purple-100",
      iconColor: "text-purple-600",
      accentBorder: "border-purple-200"
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <p className="text-[#8C6F3D] font-bold tracking-widest uppercase text-xs">Overview</p>
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Empat Pilar <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Perlindungan</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Setiap layanan dirancang untuk saling melengkapi, menciptakan ekosistem autentikasi yang komprehensif.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {services.map((service, idx) => (
            <motion.a
              key={service.id}
              href={`#${service.id}`}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className={`group relative bg-white rounded-3xl border ${service.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden p-8 md:p-10 cursor-pointer`}
            >
              <div className={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />

              <div className="relative z-10">
                <div className="flex items-start justify-between mb-6">
                  <div className="flex items-start gap-4">
                    <div className={`w-14 h-14 ${service.iconBg} ${service.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                      {service.icon}
                    </div>
                    <div>
                      <span className="text-[10px] font-bold text-[#8C6F3D] uppercase tracking-widest mb-1 block">
                        {service.subtitle}
                      </span>
                      <h3 className="text-2xl font-bold text-[#1A1A1A] mb-2">
                        {service.title}
                      </h3>
                    </div>
                  </div>

                  <div className="hidden md:flex items-center gap-1.5 bg-[#E8D09E]/20 text-[#8C6F3D] px-3 py-1.5 rounded-full text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">
                    <span>Detail</span>
                    <ArrowRight className="w-3.5 h-3.5" />
                  </div>
                </div>

                <p className="text-gray-600 leading-relaxed mb-6 text-base">
                  {service.desc}
                </p>

                <div className="grid grid-cols-2 gap-4 mb-6 p-4 bg-white/50 backdrop-blur-sm rounded-2xl border border-gray-100">
                  {service.highlights.map((stat, sIdx) => (
                    <div key={sIdx} className="text-center">
                      <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
                      <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
                    </div>
                  ))}
                </div>

                <div>
                  <p className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                    Cocok untuk:
                  </p>
                  <div className="flex flex-wrap gap-2">
                    {service.industries.map((industry, iIdx) => (
                      <span
                        key={iIdx}
                        className="text-xs font-semibold text-gray-600 bg-gray-100 px-3 py-1.5 rounded-full"
                      >
                        {industry}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </motion.a>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Sticker Hologram
// ============================================================================
function HologramDetail() {
  const features = [
    {
      icon: <Sparkles className="w-5 h-5" />,
      title: "Hologram Premium Anti-Clone",
      desc: "Teknologi hologram multi-layer dengan efek visual yang sulit ditiru oleh pemalsu."
    },
    {
      icon: <QrCode className="w-5 h-5" />,
      title: "QR Code Unik Per Produk",
      desc: "Setiap produk memiliki QR code unik yang terhubung ke database real-time kami."
    },
    {
      icon: <Fingerprint className="w-5 h-5" />,
      title: "Scratch PIN 6 Digit",
      desc: "Lapisan pelindung dengan PIN rahasia yang hanya bisa diakses satu kali."
    },
    {
      icon: <Database className="w-5 h-5" />,
      title: "Database Real-time",
      desc: "Verifikasi instan dengan database yang tersinkronisasi di seluruh Asia Pasifik."
    }
  ]

  const benefits = [
    "Proteksi maksimal dengan 3 lapis keamanan",
    "Verifikasi mudah oleh konsumen via smartphone",
    "Data verifikasi tersimpan untuk analisis",
    "Meningkatkan kepercayaan konsumen hingga 80%",
    "Biaya implementasi terjangkau per unit",
    "Custom design sesuai brand identity"
  ]

  return (
    <section id="hologram" className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden scroll-mt-20">
      <div className="absolute top-0 right-0 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Content */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-emerald-100 border border-emerald-200 px-4 py-2 rounded-full">
              <Tag className="w-4 h-4 text-emerald-600" />
              <span className="text-xs font-bold text-emerald-700 uppercase tracking-widest">Flagship Product</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Sticker <span className="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-emerald-500">Hologram</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Solusi autentikasi paling populer kami. Sticker hologram premium dengan teknologi multi-layer yang menggabungkan QR code unik dan scratch PIN 6 digit, terintegrasi penuh dengan database real-time.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: -20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-white rounded-2xl border border-gray-100 hover:border-emerald-200 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>
          </motion.div>

          {/* Right Content */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            {/* Visual Card */}
            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl" />

              <div className="relative z-10">
                <div className="flex items-center gap-2 mb-6">
                  <div className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
                  <span className="text-xs font-bold text-emerald-400 uppercase tracking-wider">Live Demo</span>
                </div>

                <div className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 space-y-4">
                  <div className="flex items-center gap-3">
                    <div className="w-12 h-12 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center">
                      <Sparkles className="w-6 h-6 text-white" />
                    </div>
                    <div>
                      <p className="text-xs text-gray-400">Produk Terverifikasi</p>
                      <p className="text-white font-bold">Premium Sneakers X1</p>
                    </div>
                  </div>

                  <div className="grid grid-cols-2 gap-3">
                    <div className="bg-white/5 rounded-xl p-3">
                      <p className="text-[10px] text-gray-400 uppercase tracking-wider">Kode</p>
                      <p className="text-sm font-mono font-bold text-emerald-400">AG-7J1DG</p>
                    </div>
                    <div className="bg-white/5 rounded-xl p-3">
                      <p className="text-[10px] text-gray-400 uppercase tracking-wider">Status</p>
                      <div className="flex items-center gap-1">
                        <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                        <p className="text-sm font-bold text-emerald-400">Original</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Benefits Card */}
            <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-4 flex items-center gap-2">
                <CheckCircle2 className="w-5 h-5 text-emerald-500" />
                Keuntungan Utama
              </h4>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                {benefits.map((benefit, idx) => (
                  <div key={idx} className="flex items-start gap-2 p-2">
                    <div className="w-1.5 h-1.5 bg-emerald-500 rounded-full mt-2 shrink-0" />
                    <span className="text-sm text-gray-700">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Garment Label
// ============================================================================
function GarmentDetail() {
  const features = [
    {
      icon: <Layers className="w-5 h-5" />,
      title: "Material Premium Tahan Cuci",
      desc: "Dibuat dari material khusus yang tahan hingga 50+ kali pencucian tanpa degradasi kualitas."
    },
    {
      icon: <QrCode className="w-5 h-5" />,
      title: "QR Code Terintegrasi",
      desc: "QR code yang dicetak langsung pada label dengan teknologi high-resolution printing."
    },
    {
      icon: <Fingerprint className="w-5 h-5" />,
      title: "Scratch PIN pada Label",
      desc: "Lapisan scratch khusus yang menyatu dengan desain label, tetap estetis dan aman."
    },
    {
      icon: <Target className="w-5 h-5" />,
      title: "Custom Design",
      desc: "Desain label fully customizable sesuai brand identity dan kebutuhan produk."
    }
  ]

  return (
    <section id="garment" className="py-16 md:py-24 bg-white relative overflow-hidden scroll-mt-20">
      <div className="absolute top-0 left-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Visual */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-2 lg:order-1"
          >
            <div className="bg-gradient-to-br from-[#FAF8F5] to-white rounded-3xl p-8 border border-[#E8D09E]/30 shadow-sm">
              <div className="space-y-4">
                <div className="bg-white rounded-2xl p-6 border border-gray-100">
                  <div className="flex items-center gap-3 mb-4">
                    <div className="w-10 h-10 bg-[#E8D09E]/30 text-[#8C6F3D] rounded-xl flex items-center justify-center">
                      <Layers className="w-5 h-5" />
                    </div>
                    <div>
                      <p className="text-xs text-gray-500">Spesifikasi</p>
                      <p className="font-bold text-[#1A1A1A]">Garment Label Premium</p>
                    </div>
                  </div>

                  <div className="space-y-3">
                    {[
                      { label: "Material", value: "Polyester Premium" },
                      { label: "Ketahanan Cuci", value: "50+ kali" },
                      { label: "Ukuran", value: "Custom" },
                      { label: "Printing", value: "High-Resolution" }
                    ].map((spec, idx) => (
                      <div key={idx} className="flex items-center justify-between p-2 bg-[#FAF8F5] rounded-lg">
                        <span className="text-xs text-gray-500 font-medium">{spec.label}</span>
                        <span className="text-sm font-bold text-[#1A1A1A]">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-3">
                  <div className="bg-gradient-to-br from-[#C5A059] to-[#8C6F3D] rounded-2xl p-5 text-white">
                    <p className="text-3xl font-extrabold mb-1">100+</p>
                    <p className="text-xs text-white/80 uppercase tracking-wider">Brand Fashion</p>
                  </div>
                  <div className="bg-white rounded-2xl p-5 border border-[#E8D09E]/30">
                    <p className="text-3xl font-extrabold text-[#1A1A1A] mb-1">50x+</p>
                    <p className="text-xs text-gray-500 uppercase tracking-wider">Tahan Cuci</p>
                  </div>
                </div>
              </div>
            </div>
          </motion.div>

          {/* Right Content */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-1 lg:order-2 space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-[#E8D09E]/20 border border-[#E8D09E]/40 px-4 py-2 rounded-full">
              <Layers className="w-4 h-4 text-[#8C6F3D]" />
              <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Fashion Solution</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Garment <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Label</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Label tekstil khusus yang dirancang untuk industri fashion. Mengintegrasikan teknologi autentikasi kami ke dalam label produk yang estetis, tahan lama, dan tetap nyaman dikenakan.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: 20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-[#FAF8F5] rounded-2xl border border-gray-100 hover:border-[#E8D09E]/40 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-[#E8D09E]/30 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>

            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-2xl p-6 text-white">
              <div className="flex items-start gap-3">
                <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#E8D09E] rounded-xl flex items-center justify-center shrink-0">
                  <Lightbulb className="w-5 h-5" />
                </div>
                <div>
                  <h4 className="font-bold mb-2">Kenapa Garment Label?</h4>
                  <p className="text-sm text-gray-300 leading-relaxed">
                    Produk fashion sering menjadi target pemalsuan. Label kami memberikan lapisan keamanan yang tidak terlihat namun efektif, tanpa mengorbankan estetika produk.
                  </p>
                </div>
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Brand Protection
// ============================================================================
function BrandProtectionDetail() {
  const features = [
    {
      icon: <Eye className="w-5 h-5" />,
      title: "Real-time Monitoring",
      desc: "Dashboard monitoring 24/7 untuk mendeteksi aktivitas mencurigakan secara instan."
    },
    {
      icon: <BarChart3 className="w-5 h-5" />,
      title: "Analytics Dashboard",
      desc: "Analitik komprehensif untuk memahami pola verifikasi dan potensi pemalsuan."
    },
    {
      icon: <Bell className="w-5 h-5" />,
      title: "Alert System Otomatis",
      desc: "Notifikasi real-time saat terdeteksi aktivitas yang mencurigakan atau anomali."
    },
    {
      icon: <FileCheck className="w-5 h-5" />,
      title: "Legal Support",
      desc: "Dukungan hukum untuk tindakan terhadap pemalsu berdasarkan data yang terkumpul."
    }
  ]

  return (
    <section id="protection" className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden scroll-mt-20">
      <div className="absolute bottom-0 right-0 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Content */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-blue-100 border border-blue-200 px-4 py-2 rounded-full">
              <Shield className="w-4 h-4 text-blue-600" />
              <span className="text-xs font-bold text-blue-700 uppercase tracking-widest">Enterprise Solution</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Brand <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-500">Protection</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Solusi enterprise komprehensif untuk melindungi reputasi brand Anda dari produk palsu. Dilengkapi dengan dashboard analytics real-time dan sistem alert otomatis yang proaktif.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: -20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-white rounded-2xl border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>
          </motion.div>

          {/* Right Visual - Dashboard Mockup */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-blue-500/10 rounded-full blur-3xl" />

              <div className="relative z-10">
                <div className="flex items-center justify-between mb-6">
                  <div>
                    <p className="text-xs text-gray-400 mb-1">Analytics Dashboard</p>
                    <p className="text-lg font-bold">Real-time Monitoring</p>
                  </div>
                  <div className="flex items-center gap-2 bg-emerald-500/20 px-3 py-1.5 rounded-full">
                    <div className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
                    <span className="text-xs font-bold text-emerald-400">LIVE</span>
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-3 mb-4">
                  <div className="bg-white/5 rounded-xl p-4">
                    <p className="text-[10px] text-gray-400 uppercase tracking-wider mb-1">Verifikasi Hari Ini</p>
                    <p className="text-2xl font-extrabold text-white">12,847</p>
                    <p className="text-xs text-emerald-400 mt-1">↑ 23% dari kemarin</p>
                  </div>
                  <div className="bg-white/5 rounded-xl p-4">
                    <p className="text-[10px] text-gray-400 uppercase tracking-wider mb-1">Anomali Terdeteksi</p>
                    <p className="text-2xl font-extrabold text-white">3</p>
                    <p className="text-xs text-amber-400 mt-1">Perlu investigasi</p>
                  </div>
                </div>

                <div className="bg-white/5 rounded-xl p-4">
                  <p className="text-xs text-gray-400 mb-3">Aktivitas Verifikasi (7 Hari)</p>
                  <div className="flex items-end gap-1 h-20">
                    {[40, 65, 45, 80, 55, 90, 75].map((height, idx) => (
                      <div
                        key={idx}
                        className="flex-1 bg-gradient-to-t from-blue-500 to-blue-400 rounded-t"
                        style={{ height: `${height}%` }}
                      />
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-4 flex items-center gap-2">
                <TrendingUp className="w-5 h-5 text-blue-600" />
                ROI Brand Protection
              </h4>
              <div className="grid grid-cols-2 gap-4">
                {[
                  { value: "80%", label: "Penurunan Produk Palsu" },
                  { value: "3x", label: "Peningkatan Kepercayaan" },
                  { value: "60%", label: "Penghematan Biaya Hukum" },
                  { value: "<1s", label: "Response Time" }
                ].map((stat, idx) => (
                  <div key={idx} className="text-center p-3 bg-[#FAF8F5] rounded-xl">
                    <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
                    <p className="text-xs text-gray-500">{stat.label}</p>
                  </div>
                ))}
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Supply Chain Security
// ============================================================================
function SupplyChainDetail() {
  const features = [
    {
      icon: <Truck className="w-5 h-5" />,
      title: "End-to-End Tracking",
      desc: "Lacak perjalanan produk dari pabrik hingga ke tangan konsumen dengan presisi."
    },
    {
      icon: <Users className="w-5 h-5" />,
      title: "Distributor Verification",
      desc: "Verifikasi setiap titik distribusi untuk memastikan produk tidak dibelokkan."
    },
    {
      icon: <LineChart className="w-5 h-5" />,
      title: "Audit Trail Lengkap",
      desc: "Catatan audit yang komprehensif untuk setiap pergerakan produk dalam rantai pasok."
    },
    {
      icon: <FileCheck className="w-5 h-5" />,
      title: "Compliance Report",
      desc: "Laporan kepatuhan otomatis untuk memenuhi regulasi industri dan standar internasional."
    }
  ]

  return (
    <section id="supply" className="py-16 md:py-24 bg-white relative overflow-hidden scroll-mt-20">
      <div className="absolute top-0 left-0 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Visual - Supply Chain Flow */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-2 lg:order-1"
          >
            <div className="bg-gradient-to-br from-[#FAF8F5] to-white rounded-3xl p-8 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-6 flex items-center gap-2">
                <Lock className="w-5 h-5 text-purple-600" />
                Alur Supply Chain Security
              </h4>

              <div className="space-y-3">
                {[
                  { icon: <Factory className="w-5 h-5" />, title: "Pabrik", desc: "Verifikasi awal produk", color: "purple" },
                  { icon: <Boxes className="w-5 h-5" />, title: "Gudang Pusat", desc: "Tracking & audit trail", color: "blue" },
                  { icon: <Truck className="w-5 h-5" />, title: "Distributor", desc: "Verifikasi distributor resmi", color: "emerald" },
                  { icon: <Building2 className="w-5 h-5" />, title: "Retailer", desc: "Verifikasi titik penjualan", color: "amber" },
                  { icon: <Users className="w-5 h-5" />, title: "Konsumen", desc: "Verifikasi akhir oleh user", color: "rose" }
                ].map((step, idx) => (
                  <motion.div
                    key={idx}
                    initial={{ opacity: 0, x: -20 }}
                    whileInView={{ opacity: 1, x: 0 }}
                    viewport={{ once: true }}
                    transition={{ delay: idx * 0.1 }}
                    className="relative"
                  >
                    <div className="flex items-center gap-4 p-4 bg-white rounded-2xl border border-gray-100 hover:border-purple-200 hover:shadow-sm transition-all">
                      <div className={`w-10 h-10 bg-${step.color}-100 text-${step.color}-600 rounded-xl flex items-center justify-center shrink-0`}>
                        {step.icon}
                      </div>
                      <div className="flex-1">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-bold text-purple-600 bg-purple-100 px-2 py-0.5 rounded">
                            Step {idx + 1}
                          </span>
                          <h5 className="font-bold text-[#1A1A1A]">{step.title}</h5>
                        </div>
                        <p className="text-xs text-gray-500 mt-0.5">{step.desc}</p>
                      </div>
                      <CheckCircle2 className="w-5 h-5 text-emerald-500 shrink-0" />
                    </div>
                    {idx < 4 && (
                      <div className="absolute left-9 top-full w-0.5 h-3 bg-purple-200" />
                    )}
                  </motion.div>
                ))}
              </div>
            </div>
          </motion.div>

          {/* Right Content */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-1 lg:order-2 space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-purple-100 border border-purple-200 px-4 py-2 rounded-full">
              <Lock className="w-4 h-4 text-purple-600" />
              <span className="text-xs font-bold text-purple-700 uppercase tracking-widest">Logistics Solution</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Supply Chain <span className="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-purple-500">Security</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Amankan rantai pasok Anda dari hulu ke hilir. Sistem tracking dan verifikasi kami memastikan setiap titik distribusi terverifikasi, mengurangi risiko produk palsu masuk ke pasar.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: 20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-[#FAF8F5] rounded-2xl border border-gray-100 hover:border-purple-200 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>

            <div className="bg-gradient-to-br from-purple-600 to-purple-700 rounded-2xl p-6 text-white">
              <div className="flex items-start gap-3">
                <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center shrink-0">
                  <Award className="w-5 h-5" />
                </div>
                <div>
                  <h4 className="font-bold mb-2">Compliance & Certification</h4>
                  <p className="text-sm text-purple-100 leading-relaxed">
                    Sistem kami memenuhi standar ISO 27001 dan regulasi internasional untuk keamanan rantai pasok, memberikan ketenangan pikiran bagi bisnis Anda.
                  </p>
                </div>
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// PROCESS SECTION - How We Work
// ============================================================================
function ProcessSection() {
  const steps = [
    {
      num: "01",
      icon: <Handshake className="w-6 h-6" />,
      title: "Konsultasi",
      desc: "Diskusi mendalam untuk memahami kebutuhan spesifik brand dan industri Anda.",
      duration: "1-2 hari"
    },
    {
      num: "02",
      icon: <Target className="w-6 h-6" />,
      title: "Perencanaan",
      desc: "Merancang solusi yang disesuaikan dengan skala dan kebutuhan bisnis Anda.",
      duration: "3-5 hari"
    },
    {
      num: "03",
      icon: <Lightbulb className="w-6 h-6" />,
      title: "Implementasi",
      desc: "Tim teknis kami mengimplementasikan solusi dengan minimal disruption.",
      duration: "1-2 minggu"
    },
    {
      num: "04",
      icon: <CheckCircle2 className="w-6 h-6" />,
      title: "Monitoring",
      desc: "Monitoring 24/7 dan dukungan berkelanjutan untuk memastikan performa optimal.",
      duration: "Berkelanjutan"
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 w-96 h-96 bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <p className="text-[#E8D09E] font-bold tracking-widest uppercase text-xs">Proses Kami</p>
          <h2 className="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
            Bagaimana Kami <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#E8D09E] to-[#C5A059]">Bekerja</span>
          </h2>
          <p className="text-gray-400 text-lg leading-relaxed">
            Proses implementasi yang terstruktur untuk memastikan kesuksesan setiap proyek.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {steps.map((step, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className="group relative bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl p-6 hover:bg-white/10 hover:border-[#E8D09E]/30 transition-all"
            >
              <div className="absolute top-4 right-4 text-5xl font-extrabold text-white/5 group-hover:text-[#E8D09E]/10 transition-colors">
                {step.num}
              </div>

              <div className="relative z-10">
                <div className="w-12 h-12 bg-[#E8D09E]/20 text-[#E8D09E] rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  {step.icon}
                </div>

                <div className="flex items-center gap-2 mb-2">
                  <span className="text-xs font-bold text-[#E8D09E] bg-[#E8D09E]/20 px-2 py-0.5 rounded">
                    {step.duration}
                  </span>
                </div>

                <h3 className="text-xl font-bold text-white mb-2">{step.title}</h3>
                <p className="text-sm text-gray-400 leading-relaxed">{step.desc}</p>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// FAQ SECTION
// ============================================================================
function FAQSection() {
  const [openIndex, setOpenIndex] = useState<number | null>(0)

  const faqs = [
    {
      q: "Berapa lama waktu implementasi untuk setiap layanan?",
      a: "Waktu implementasi bervariasi tergantung kompleksitas. Sticker Hologram biasanya 1-2 minggu, Garment Label 2-3 minggu, Brand Protection 1 minggu, dan Supply Chain Security 2-4 minggu. Kami akan memberikan timeline yang jelas setelah konsultasi awal."
    },
    {
      q: "Apakah layanan ini bisa di-custom sesuai kebutuhan brand saya?",
      a: "Tentu! Semua layanan kami fully customizable. Mulai dari desain visual, integrasi sistem, hingga fitur-fitur khusus yang sesuai dengan kebutuhan industri dan brand Anda."
    },
    {
      q: "Bagaimana sistem menangani lonjakan verifikasi?",
      a: "Infrastruktur kami dibangun dengan arsitektur cloud yang scalable, didukung oleh partnership dengan Telkom Indonesia. Sistem kami mampu menangani jutaan verifikasi per hari dengan uptime 99.99%."
    },
    {
      q: "Apakah ada minimum order untuk sticker hologram?",
      a: "Ya, kami memiliki minimum order quantity (MOQ) yang bervariasi tergantung kompleksitas desain. Tim sales kami akan memberikan penawaran terbaik sesuai volume yang Anda butuhkan."
    },
    {
      q: "Bagaimana dengan dukungan teknis setelah implementasi?",
      a: "Kami menyediakan dukungan teknis 24/7 untuk semua layanan. Tim customer success kami akan memastikan Anda mendapatkan bantuan kapan pun dibutuhkan, termasuk training untuk tim internal Anda."
    },
    {
      q: "Apakah data verifikasi aman dan privat?",
      a: "Keamanan data adalah prioritas utama kami. Kami telah tersertifikasi ISO 27001 dan menggunakan enkripsi end-to-end untuk semua data. Data Anda tidak akan dibagikan ke pihak ketiga tanpa persetujuan."
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-4xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12 space-y-4"
        >
          <p className="text-[#8C6F3D] font-bold tracking-widest uppercase text-xs">FAQ</p>
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Pertanyaan <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Umum</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Jawaban untuk pertanyaan yang sering ditanyakan tentang layanan kami.
          </p>
        </motion.div>

        <div className="space-y-3">
          {faqs.map((faq, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 10 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ delay: idx * 0.05 }}
              className="bg-[#FAF8F5] rounded-2xl border border-gray-100 overflow-hidden hover:border-[#E8D09E]/40 transition-all"
            >
              <button
                onClick={() => setOpenIndex(openIndex === idx ? null : idx)}
                className="w-full flex items-center justify-between gap-4 p-5 text-left"
              >
                <h3 className="font-bold text-[#1A1A1A] text-base md:text-lg pr-4">
                  {faq.q}
                </h3>
                <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-all ${
                  openIndex === idx
                    ? 'bg-[#C5A059] text-white rotate-180'
                    : 'bg-white text-[#8C6F3D]'
                }`}>
                  <ChevronDown className="w-4 h-4" />
                </div>
              </button>

              <AnimatePresence>
                {openIndex === idx && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: 'auto', opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    transition={{ duration: 0.3 }}
                    className="overflow-hidden"
                  >
                    <div className="px-5 pb-5 pt-0">
                      <div className="pt-4 border-t border-gray-200">
                        <p className="text-sm text-gray-600 leading-relaxed">
                          {faq.a}
                        </p>
                      </div>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// CTA SECTION
// ============================================================================
function ServicesCTA() {
  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="max-w-5xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="relative bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 md:p-16 text-white text-center shadow-2xl overflow-hidden"
        >
          <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/15 rounded-full blur-3xl pointer-events-none" />
          <div className="absolute bottom-0 left-0 w-72 h-72 bg-[#8C6F3D]/10 rounded-full blur-3xl pointer-events-none" />

          <div className="relative z-10 space-y-6 max-w-2xl mx-auto">
            <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-1.5 rounded-full">
              <Handshake className="w-4 h-4 text-[#E8D09E]" />
              <span className="text-xs font-bold text-[#E8D09E] tracking-wider uppercase">Konsultasi Gratis</span>
            </div>

            <h2 className="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight">
              Siap Melindungi <br className="hidden md:block" />
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#E8D09E] to-[#C5A059]">
                Brand Anda?
              </span>
            </h2>

            <p className="text-gray-300 text-lg leading-relaxed">
              Tim kami siap membantu Anda menemukan solusi autentikasi yang tepat sesuai kebutuhan dan budget.
            </p>

            <div className="flex flex-col sm:flex-row gap-4 justify-center pt-4">
              <Link
                to="/contact"
                className="group inline-flex items-center justify-center gap-3 bg-[#C5A059] text-[#1A1A1A] px-8 py-4 rounded-xl font-bold text-lg hover:bg-[#E8D09E] transition-all duration-300 shadow-lg hover:shadow-[#C5A059]/30 hover:-translate-y-0.5"
              >
                <span>Mulai Konsultasi</span>
                <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
              </Link>
              <a
                href="#hologram"
                className="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-all duration-300"
              >
                <Search className="w-5 h-5" />
                <span>Lihat Detail</span>
              </a>
            </div>

            <div className="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-6 text-xs text-gray-400">
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Konsultasi Gratis
              </span>
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Custom Solution
              </span>
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Dukungan 24/7
              </span>
            </div>
          </div>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// MAIN PAGE
// ============================================================================
export default function ServicesPage() {
  return (
    <>
      <HeroServices />
      <ServicesOverview />
      <HologramDetail />
      <GarmentDetail />
      <BrandProtectionDetail />
      <SupplyChainDetail />
      <ProcessSection />
      <FAQSection />
      {/* <ServicesCTA /> */}
    </>
  )
}