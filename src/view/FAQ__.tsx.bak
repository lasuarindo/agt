// ============================================================================
// TYPES
// ============================================================================
interface FAQItem {
  id: string
  question: string
  answer: string
  category: string
  popular?: boolean
  lastUpdated?: string
  relatedLinks?: { label: string; href: string }[]
}

interface FAQCategory {
  id: string
  label: string
  icon: React.ReactNode
  color: string
  bgColor: string
  borderColor: string
  count: number
}

