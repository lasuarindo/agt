import { useState } from 'react'
import { Link } from 'react-router'
import { motion, AnimatePresence } from 'motion/react'
import {
  Shield,
  ShieldCheck,
  QrCode,
  Fingerprint,
  Zap,
  CheckCircle2,
  ArrowRight,
  Globe,
  Package,
  Sparkles,
  Lock,
  Eye,
  Smartphone,
  MapPin,
  Phone,
  Mail,
  ChevronDown,
  TrendingUp,
  Clock,
  BadgeCheck,
  Layers,
  Server,
  Database,
  Cpu,
  Wifi,
  Key,
  ScanLine,
  BarChart3,
  LineChart,
  Bell,
  FileCheck,
  Search,
  ArrowUpRight,
  Handshake,
  Code2,
  Boxes,
  Activity,
  Users,
  Fingerprint as FingerprintIcon
} from 'lucide-react'

// ============================================================================
// HERO TECHNOLOGY SECTION
// ============================================================================
function HeroTechnology() {
  return (
    <section className="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden">
      <div className="absolute inset-0 bg-gradient-to-br from-[#FAF8F5] via-[#F5EFE6] to-[#E8D09E]/20" />
      <div className="absolute top-0 right-0 -mt-32 -mr-32 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 -mb-32 -ml-32 w-[600px] h-[600px] bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div
        className="absolute inset-0 opacity-[0.03] pointer-events-none"
        style={{
          backgroundImage: `linear-gradient(rgba(26, 26, 26, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 26, 26, 1) 1px, transparent 1px)`,
          backgroundSize: '60px 60px'
        }}
      />

      <div className="relative z-10 max-w-5xl mx-auto px-4 md:px-8 text-center">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-[#C5A059]/40 px-4 py-2 rounded-full mb-6"
        >
          <Cpu className="w-4 h-4 text-[#C5A059]" />
          <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Teknologi Kami</span>
        </motion.div>

        <motion.h1
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.1 }}
          className="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#1A1A1A] leading-[1.1] tracking-tight mb-6"
        >
          Teknologi Autentikasi <br className="hidden md:block" />
          <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] via-[#C5A059] to-[#8C6F3D]">
            Terdepan
          </span>
          <br className="hidden md:block" />
          di Asia Pasifik
        </motion.h1>

        <motion.p
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8"
        >
          Dibangun dengan arsitektur modern dan standar keamanan internasional. Sistem kami menggabungkan teknologi fisik (hologram, scratch PIN) dengan teknologi digital (QR code, database real-time) untuk menciptakan lapisan proteksi yang tak tertandingi.
        </motion.p>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.3 }}
          className="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-gray-600"
        >
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">ISO 27001 Certified</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">99.99% Uptime</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">End-to-End Encryption</span>
          </span>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// CORE TECHNOLOGY - Triple Layer Security
// ============================================================================
function CoreTechnologySection() {
  const layers = [
    {
      num: '01',
      icon: <Sparkles className="w-6 h-6" />,
      title: 'Hologram Premium',
      subtitle: 'Physical Security Layer',
      desc: 'Lapisan fisik pertama dengan teknologi hologram multi-layer yang hampir mustahil dipalsukan. Setiap hologram memiliki pola unik yang dapat diverifikasi secara visual.',
      specs: [
        { label: 'Jenis', value: 'Multi-layer Hologram' },
        { label: 'Ketahanan', value: 'Anti-UV & Anti-Scratch' },
        { label: 'Verifikasi', value: 'Visual Inspection' },
        { label: 'Tingkat Keamanan', value: 'Sangat Tinggi' }
      ],
      gradient: 'from-emerald-500/10 to-emerald-500/[0.02]',
      iconBg: 'bg-emerald-100',
      iconColor: 'text-emerald-600',
      accentBorder: 'border-emerald-200'
    },
    {
      num: '02',
      icon: <Fingerprint className="w-6 h-6" />,
      title: 'Scratch PIN',
      subtitle: 'Concealed Security Layer',
      desc: 'Lapisan kedua berupa PIN 6 digit yang tersembunyi di balik lapisan scratch. Hanya bisa diakses satu kali untuk mencegah penyalahgunaan dan memastikan keaslian produk.',
      specs: [
        { label: 'Format', value: '6 Digit Alphanumeric' },
        { label: 'Akses', value: 'One-time Use' },
        { label: 'Lapisan', value: 'Scratch-off Coating' },
        { label: 'Uniqueness', value: '1 in 16.7 Million' }
      ],
      gradient: 'from-amber-500/10 to-amber-500/[0.02]',
      iconBg: 'bg-amber-100',
      iconColor: 'text-amber-600',
      accentBorder: 'border-amber-200'
    },
    {
      num: '03',
      icon: <QrCode className="w-6 h-6" />,
      title: 'QR Code Unik',
      subtitle: 'Digital Security Layer',
      desc: 'Lapisan digital berupa QR code unik yang terhubung langsung ke database real-time kami. Setiap QR code memiliki signature digital yang tidak dapat diduplikasi.',
      specs: [
        { label: 'Format', value: 'Dynamic QR Code' },
        { label: 'Database', value: 'Real-time Sync' },
        { label: 'Encryption', value: 'AES-256' },
        { label: 'Response Time', value: '< 100ms' }
      ],
      gradient: 'from-blue-500/10 to-blue-500/[0.02]',
      iconBg: 'bg-blue-100',
      iconColor: 'text-blue-600',
      accentBorder: 'border-blue-200'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Shield className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Core Technology</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Triple-Layer <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Security</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Tiga lapisan keamanan yang bekerja sinergis untuk menciptakan proteksi yang hampir mustahil ditembus oleh pemalsu.
          </p>
        </motion.div>

        <div className="space-y-6">
          {layers.map((layer, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className={`group relative bg-white rounded-3xl border ${layer.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden p-8 md:p-10`}
            >
              <div className={`absolute inset-0 bg-gradient-to-br ${layer.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />
              
              <div className="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                {/* Left: Number + Icon + Content */}
                <div className="lg:col-span-8">
                  <div className="flex items-start gap-4 mb-6">
                    <div className={`w-14 h-14 ${layer.iconBg} ${layer.iconColor} rounded-2xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300`}>
                      {layer.icon}
                    </div>
                    <div className="flex-1">
                      <div className="flex items-center gap-3 mb-2">
                        <span className="text-xs font-extrabold text-[#8C6F3D] bg-[#E8D09E]/20 px-2.5 py-1 rounded-md tracking-wider">
                          LAYER {layer.num}
                        </span>
                        <span className="text-xs font-bold text-gray-400 uppercase tracking-wider">
                          {layer.subtitle}
                        </span>
                      </div>
                      <h3 className="text-2xl md:text-3xl font-bold text-[#1A1A1A] mb-3">
                        {layer.title}
                      </h3>
                      <p className="text-gray-600 leading-relaxed text-base">
                        {layer.desc}
                      </p>
                    </div>
                  </div>
                </div>

                {/* Right: Specs */}
                <div className="lg:col-span-4">
                  <div className="bg-white/50 backdrop-blur-sm rounded-2xl border border-gray-100 p-5">
                    <p className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">
                      Spesifikasi Teknis
                    </p>
                    <div className="space-y-3">
                      {layer.specs.map((spec, sIdx) => (
                        <div key={sIdx} className="flex items-center justify-between pb-3 border-b border-gray-100 last:border-0 last:pb-0">
                          <span className="text-xs text-gray-500 font-medium">{spec.label}</span>
                          <span className="text-sm font-bold text-[#1A1A1A]">{spec.value}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// TECHNOLOGY STACK - Detailed Components
// ============================================================================
function TechnologyStackSection() {
  const technologies = [
    {
      id: 'database',
      icon: <Database className="w-6 h-6" />,
      title: 'Real-time Database',
      subtitle: 'Data Infrastructure',
      desc: 'Database terdistribusi dengan replikasi multi-region untuk memastikan ketersediaan data 24/7 dengan latency minimal.',
      features: [
        'Multi-region replication',
        'Auto-scaling infrastructure',
        '99.99% uptime SLA',
        'Sub-millisecond query time'
      ],
      stats: [
        { value: '10M+', label: 'Records' },
        { value: '<100ms', label: 'Query Time' }
      ],
      gradient: 'from-emerald-500/10 to-emerald-500/[0.02]',
      iconBg: 'bg-emerald-100',
      iconColor: 'text-emerald-600',
      accentBorder: 'border-emerald-200',
      size: 'large'
    },
    {
      id: 'encryption',
      icon: <Lock className="w-6 h-6" />,
      title: 'AES-256 Encryption',
      desc: 'Enkripsi military-grade untuk semua data yang ditransmisikan dan disimpan dalam sistem kami.',
      features: [
        'AES-256 bit encryption',
        'TLS 1.3 protocol',
        'Zero-knowledge architecture'
      ],
      gradient: 'from-blue-500/10 to-blue-500/[0.02]',
      iconBg: 'bg-blue-100',
      iconColor: 'text-blue-600',
      accentBorder: 'border-blue-200',
      size: 'small'
    },
    // {
    //   id: 'api',
    //   icon: <Code2 className="w-6 h-6" />,
    //   title: 'RESTful API',
    //   desc: 'API modern dengan dokumentasi lengkap untuk integrasi yang mudah dengan sistem existing Anda.',
    //   features: [
    //     'RESTful & GraphQL',
    //     'OAuth 2.0 authentication',
    //     'Rate limiting & throttling'
    //   ],
    //   gradient: 'from-purple-500/10 to-purple-500/[0.02]',
    //   iconBg: 'bg-purple-100',
    //   iconColor: 'text-purple-600',
    //   accentBorder: 'border-purple-200',
    //   size: 'small'
    // },
    // {
    //   id: 'mobile',
    //   icon: <Smartphone className="w-6 h-6" />,
    //   title: 'Mobile SDK',
    //   desc: 'SDK native untuk iOS dan Android dengan performa optimal dan UX yang intuitif.',
    //   features: [
    //     'iOS & Android native',
    //     'Offline capability',
    //     'Biometric authentication'
    //   ],
    //   gradient: 'from-amber-500/10 to-amber-500/[0.02]',
    //   iconBg: 'bg-amber-100',
    //   iconColor: 'text-amber-600',
    //   accentBorder: 'border-amber-200',
    //   size: 'small'
    // },
    {
      id: 'analytics',
      icon: <BarChart3 className="w-6 h-6" />,
      title: 'Analytics Engine',
      subtitle: 'Business Intelligence',
      desc: 'Engine analitik canggih yang memproses jutaan data point untuk memberikan insight bisnis yang actionable.',
      features: [
        'Real-time analytics',
        'Predictive modeling',
        'Custom dashboards',
        'Automated reporting'
      ],
      stats: [
        { value: '1M+', label: 'Events/Day' },
        { value: '50+', label: 'Metrics' },
      ],
      gradient: 'from-[#C5A059]/10 to-[#E8D09E]/5',
      iconBg: 'bg-[#E8D09E]/30',
      iconColor: 'text-[#8C6F3D]',
      accentBorder: 'border-[#E8D09E]/40',
      size: 'large'
    },
    {
      id: 'monitoring',
      icon: <Activity className="w-6 h-6" />,
      title: '24/7 Monitoring',
      desc: 'Sistem monitoring proaktif dengan alert otomatis untuk mendeteksi anomali secara real-time.',
      features: [
        'Proactive monitoring',
        'Smart alerting',
        'Incident response'
      ],
      gradient: 'from-rose-500/10 to-rose-500/[0.02]',
      iconBg: 'bg-rose-100',
      iconColor: 'text-rose-600',
      accentBorder: 'border-rose-200',
      size: 'small'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Server className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Technology Stack</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Infrastruktur <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Enterprise-Grade</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Dibangun dengan teknologi modern dan standar industri untuk memastikan performa, keamanan, dan skalabilitas.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {technologies.map((tech, idx) => {
            const isLarge = tech.size === 'large'
            
            return (
              <motion.div
                key={tech.id}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, margin: "-50px" }}
                transition={{ duration: 0.5, delay: idx * 0.08 }}
                className={`group relative bg-white rounded-3xl border ${tech.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden ${
                  isLarge ? 'md:col-span-2 p-8 md:p-10' : 'p-6 md:p-8'
                }`}
              >
                <div className={`absolute inset-0 bg-gradient-to-br ${tech.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />
                
                <div className="relative z-10">
                  {/* Header */}
                  <div className="flex items-start justify-between mb-6">
                    <div className="flex items-start gap-4">
                      <div className={`w-14 h-14 ${tech.iconBg} ${tech.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                        {tech.icon}
                      </div>
                      <div>
                        {'subtitle' in tech && tech.subtitle && (
                          <span className="text-[10px] font-bold text-[#8C6F3D] uppercase tracking-widest mb-1 block">
                            {tech.subtitle}
                          </span>
                        )}
                        <h3 className={`${isLarge ? 'text-2xl' : 'text-xl'} font-bold text-[#1A1A1A] mb-2`}>
                          {tech.title}
                        </h3>
                      </div>
                    </div>
                    
                    {isLarge && (
                      <div className="hidden md:flex items-center gap-1.5 bg-[#E8D09E]/20 text-[#8C6F3D] px-3 py-1.5 rounded-full text-xs font-bold">
                        <Sparkles className="w-3.5 h-3.5" />
                        <span>Core</span>
                      </div>
                    )}
                  </div>

                  {/* Description */}
                  <p className={`text-gray-600 leading-relaxed mb-6 ${isLarge ? 'text-base' : 'text-sm'}`}>
                    {tech.desc}
                  </p>

                  {/* Features */}
                  <div className="space-y-2 mb-6">
                    {tech.features.map((feature, fIdx) => (
                      <div key={fIdx} className="flex items-start gap-2">
                        <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                        <span className="text-sm text-gray-700">{feature}</span>
                      </div>
                    ))}
                  </div>

                  {/* Stats (Only for Large Cards) */}
                  {'stats' in tech && tech.stats && isLarge && (
                    <div className="grid grid-cols-2 gap-4 p-4 bg-white/50 backdrop-blur-sm rounded-2xl border border-gray-100">
                      {tech.stats.map((stat, sIdx) => (
                        <div key={sIdx} className="text-center">
                          <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
                          <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </motion.div>
            )
          })}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// HOW IT WORKS - Verification Flow
// ============================================================================
function VerificationFlowSection() {
  const steps = [
    {
      num: '01',
      icon: <ScanLine className="w-6 h-6" />,
      title: 'Scan QR Code',
      desc: 'Konsumen mengarahkan kamera smartphone ke QR code pada label produk.',
      detail: 'QR code dibaca dan divalidasi formatnya sebelum dikirim ke server untuk verifikasi.',
      duration: '< 1 detik'
    },
    {
      num: '02',
      icon: <Key className="w-6 h-6" />,
      title: 'Input Scratch PIN',
      desc: 'Konsumen menggosok lapisan scratch dan memasukkan 6 digit PIN rahasia.',
      detail: 'PIN divalidasi dan dicocokkan dengan database untuk memastikan keaslian.',
      duration: '5-10 detik'
    },
    {
      num: '03',
      icon: <Server className="w-6 h-6" />,
      title: 'Server Verification',
      desc: 'Sistem memverifikasi kombinasi QR code dan PIN di database real-time.',
      detail: 'Proses enkripsi dan validasi dilakukan dalam hitungan milidetik dengan standar keamanan tinggi.',
      duration: '< 100ms'
    },
    {
      num: '04',
      icon: <CheckCircle2 className="w-6 h-6" />,
      title: 'Result Display',
      desc: 'Hasil verifikasi ditampilkan instan dengan detail lengkap produk.',
      detail: 'Menampilkan status keaslian, informasi produk, brand, dan riwayat verifikasi.',
      duration: 'Instan'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 w-96 h-96 bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2 rounded-full">
            <Zap className="w-4 h-4 text-[#E8D09E]" />
            <span className="text-xs font-bold text-[#E8D09E] uppercase tracking-widest">Verification Flow</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
            Alur Verifikasi <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#E8D09E] to-[#C5A059]">4 Langkah</span>
          </h2>
          <p className="text-gray-400 text-lg leading-relaxed">
            Proses verifikasi yang cepat, mudah, dan aman untuk konsumen Anda.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {steps.map((step, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className="group relative bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl p-6 hover:bg-white/10 hover:border-[#E8D09E]/30 transition-all"
            >
              <div className="absolute top-4 right-4 text-5xl font-extrabold text-white/5 group-hover:text-[#E8D09E]/10 transition-colors">
                {step.num}
              </div>

              <div className="relative z-10">
                <div className="w-12 h-12 bg-[#E8D09E]/20 text-[#E8D09E] rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  {step.icon}
                </div>

                <div className="flex items-center gap-2 mb-2">
                  <span className="text-xs font-bold text-[#E8D09E] bg-[#E8D09E]/20 px-2 py-0.5 rounded">
                    {step.duration}
                  </span>
                </div>

                <h3 className="text-xl font-bold text-white mb-2">{step.title}</h3>
                <p className="text-sm text-gray-400 leading-relaxed mb-3">{step.desc}</p>
                <p className="text-xs text-gray-500 leading-relaxed pt-3 border-t border-white/10">{step.detail}</p>
              </div>

              {idx < steps.length - 1 && (
                <div className="hidden lg:block absolute top-1/2 -right-3 -translate-y-1/2 z-20">
                  <ArrowRight className="w-6 h-6 text-[#C5A059]" />
                </div>
              )}
            </motion.div>
          ))}
        </div>

        {/* Total Time */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ delay: 0.4 }}
          className="mt-12 text-center"
        >
          <div className="inline-flex items-center gap-4 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl px-6 py-4">
            <Clock className="w-5 h-5 text-[#E8D09E]" />
            <div className="text-left">
              <p className="text-xs text-gray-400 uppercase tracking-wider">Total Waktu Verifikasi</p>
              <p className="text-2xl font-extrabold text-white">Kurang dari 15 Detik</p>
            </div>
          </div>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// SECURITY & COMPLIANCE SECTION
// ============================================================================
function SecurityComplianceSection() {
  const certifications = [
    {
      icon: <BadgeCheck className="w-6 h-6" />,
      title: 'ISO 27001:2022',
      desc: 'Sertifikasi internasional untuk Information Security Management System (ISMS).',
      color: 'emerald'
    },
    {
      icon: <ShieldCheck className="w-6 h-6" />,
      title: 'GDPR Compliant',
      desc: 'Sesuai dengan regulasi perlindungan data pribadi Uni Eropa.',
      color: 'blue'
    },
    {
      icon: <Lock className="w-6 h-6" />,
      title: 'SOC 2 Type II',
      desc: 'Audit independen untuk keamanan, ketersediaan, dan kerahasiaan data.',
      color: 'purple'
    },
    {
      icon: <FileCheck className="w-6 h-6" />,
      title: 'PCI DSS',
      desc: 'Standar keamanan untuk pemrosesan data kartu pembayaran.',
      color: 'amber'
    }
  ]

  const colorMap = {
    emerald: { bg: 'bg-emerald-100', text: 'text-emerald-600', border: 'border-emerald-200' },
    blue: { bg: 'bg-blue-100', text: 'text-blue-600', border: 'border-blue-200' },
    purple: { bg: 'bg-purple-100', text: 'text-purple-600', border: 'border-purple-200' },
    amber: { bg: 'bg-amber-100', text: 'text-amber-600', border: 'border-amber-200' }
  }

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Content */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6 lg:sticky lg:top-32"
          >
            <div>
              <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full mb-4">
                <Shield className="w-4 h-4 text-[#8C6F3D]" />
                <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Security & Compliance</span>
              </div>
              
              <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight mb-4">
                Standar Keamanan <br />
                <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">
                  Kelas Dunia
                </span>
              </h2>
              <p className="text-gray-600 leading-relaxed text-lg">
                Kami berkomitmen pada standar keamanan dan privasi tertinggi. Semua sistem dan proses kami diaudit secara independen dan tersertifikasi oleh lembaga internasional.
              </p>
            </div>

            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-6 text-white">
              <div className="flex items-start gap-3 mb-4">
                <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#E8D09E] rounded-xl flex items-center justify-center shrink-0">
                  <Lock className="w-5 h-5" />
                </div>
                <div>
                  <h4 className="font-bold mb-2">Zero-Trust Architecture</h4>
                  <p className="text-sm text-gray-300 leading-relaxed">
                    Setiap permintaan diverifikasi, setiap akses diautentikasi, dan setiap transaksi dienkripsi. Tidak ada implicit trust dalam sistem kami.
                  </p>
                </div>
              </div>
            </div>
          </motion.div>

          {/* Right: Certifications */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-4"
          >
            {certifications.map((cert, idx) => {
              const colors = colorMap[cert.color as keyof typeof colorMap]
              return (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, y: 20 }}
                  whileInView={{ opacity: 1, y: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className={`group flex gap-4 p-5 bg-[#FAF8F5] rounded-2xl border border-gray-100 hover:border-[#E8D09E]/40 hover:shadow-md transition-all`}
                >
                  <div className={`w-12 h-12 ${colors.bg} ${colors.text} rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform`}>
                    {cert.icon}
                  </div>
                  <div>
                    <h3 className="font-bold text-[#1A1A1A] mb-1">{cert.title}</h3>
                    <p className="text-sm text-gray-600 leading-relaxed">{cert.desc}</p>
                  </div>
                </motion.div>
              )
            })}
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// PERFORMANCE METRICS SECTION
// ============================================================================
function PerformanceMetricsSection() {
  const metrics = [
    {
      icon: <Activity className="w-6 h-6" />,
      value: '99.99',
      suffix: '%',
      label: 'Uptime Guarantee',
      desc: 'SLA ketersediaan sistem dengan monitoring 24/7'
    },
    {
      icon: <Zap className="w-6 h-6" />,
      value: '<100',
      suffix: 'ms',
      label: 'Response Time',
      desc: 'Waktu respons rata-rata untuk verifikasi produk'
    },
    {
      icon: <Database className="w-6 h-6" />,
      value: '10M',
      suffix: '+',
      label: 'Products Verified',
      desc: 'Total produk yang telah diverifikasi hingga saat ini'
    },
    {
      icon: <Globe className="w-6 h-6" />,
      value: '5',
      suffix: '',
      label: 'Regions',
      desc: 'Data center yang tersebar di Asia Pasifik'
    },
    {
      icon: <Users className="w-6 h-6" />,
      value: '500',
      suffix: '+',
      label: 'Active Brands',
      desc: 'Brand yang aktif menggunakan teknologi kami'
    },
    {
      icon: <ShieldCheck className="w-6 h-6" />,
      value: '99.9',
      suffix: '%',
      label: 'Accuracy Rate',
      desc: 'Tingkat akurasi sistem verifikasi kami'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <TrendingUp className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Performance Metrics</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Performa yang <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Terbukti</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Angka-angka yang menunjukkan komitmen kami terhadap kualitas dan kehandalan sistem.
          </p>
        </motion.div>

        <div className="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
          {metrics.map((metric, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.08 }}
              className="group bg-white rounded-3xl p-6 border border-[#E8D09E]/30 hover:border-[#C5A059]/50 hover:shadow-lg transition-all duration-300"
            >
              <div className="w-12 h-12 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                {metric.icon}
              </div>
              <p className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] mb-1 tracking-tight">
                {metric.value}<span className="text-[#8C6F3D]">{metric.suffix}</span>
              </p>
              <p className="text-sm font-bold text-[#8C6F3D] mb-2">{metric.label}</p>
              <p className="text-xs text-gray-500">{metric.desc}</p>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// INTEGRATION CAPABILITIES SECTION
// ============================================================================
function IntegrationSection() {
  const integrations = [
    {
      icon: <Code2 className="w-5 h-5" />,
      title: 'RESTful API',
      desc: 'API modern dengan dokumentasi lengkap dan SDK untuk berbagai bahasa pemrograman.'
    },
    {
      icon: <Smartphone className="w-5 h-5" />,
      title: 'Mobile SDK',
      desc: 'SDK native untuk iOS dan Android dengan performa optimal.'
    },
    {
      icon: <Globe className="w-5 h-5" />,
      title: 'Web Widget',
      desc: 'Widget embeddable untuk integrasi cepat di website Anda.'
    },
    {
      icon: <Boxes className="w-5 h-5" />,
      title: 'ERP Integration',
      desc: 'Integrasi langsung dengan sistem ERP populer seperti SAP dan Oracle.'
    },
    {
      icon: <Database className="w-5 h-5" />,
      title: 'Webhook Support',
      desc: 'Real-time notifications untuk setiap event dalam sistem.'
    },
    {
      icon: <FileCheck className="w-5 h-5" />,
      title: 'Custom Reports',
      desc: 'Laporan custom yang dapat disesuaikan dengan kebutuhan bisnis Anda.'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          {/* Left Content */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div>
              <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full mb-4">
                <Code2 className="w-4 h-4 text-[#8C6F3D]" />
                <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Integration</span>
              </div>
              
              <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight mb-4">
                Mudah <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Diintegrasikan</span>
              </h2>
              <p className="text-gray-600 leading-relaxed text-lg">
                Sistem kami dirancang untuk integrasi yang mulus dengan infrastruktur existing Anda. Dukungan untuk berbagai platform dan bahasa pemrograman.
              </p>
            </div>

            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-6 text-white shadow-2xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-[#C5A059]/10 rounded-full blur-3xl" />
              
              <div className="relative z-10">
                <div className="flex items-center gap-2 mb-4">
                  <div className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
                  <span className="text-xs font-bold text-emerald-400 uppercase tracking-wider">API Endpoint</span>
                </div>

                <div className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-4 font-mono text-sm">
                  <p className="text-gray-400 mb-2">// Verify product authenticity</p>
                  <p className="text-emerald-400">POST <span className="text-[#E8D09E]">/api/v1/verify</span></p>
                  <p className="text-gray-500 text-xs mt-3">Response time: &lt; 100ms</p>
                </div>

                <div className="grid grid-cols-2 gap-3 mt-4">
                  <div className="bg-white/5 rounded-xl p-3">
                    <p className="text-[10px] text-gray-400 uppercase tracking-wider">SDK</p>
                    <p className="text-sm font-bold text-white">10+ Languages</p>
                  </div>
                  <div className="bg-white/5 rounded-xl p-3">
                    <p className="text-[10px] text-gray-400 uppercase tracking-wider">Documentation</p>
                    <p className="text-sm font-bold text-white">Complete</p>
                  </div>
                </div>
              </div>
            </div>
          </motion.div>

          {/* Right: Integration Grid */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="grid grid-cols-1 sm:grid-cols-2 gap-4"
          >
            {integrations.map((integration, idx) => (
              <motion.div
                key={idx}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ delay: idx * 0.08 }}
                className="group flex gap-3 p-4 bg-[#FAF8F5] rounded-2xl border border-gray-100 hover:border-[#E8D09E]/40 hover:shadow-md transition-all"
              >
                <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                  {integration.icon}
                </div>
                <div>
                  <h4 className="font-bold text-[#1A1A1A] text-sm mb-1">{integration.title}</h4>
                  <p className="text-xs text-gray-600 leading-relaxed">{integration.desc}</p>
                </div>
              </motion.div>
            ))}
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// FAQ SECTION
// ============================================================================
function FAQSection() {
  const [openIndex, setOpenIndex] = useState<number | null>(0)

  const faqs = [
    {
      q: "Bagaimana sistem menangani lonjakan traffic saat peak season?",
      a: "Infrastruktur kami menggunakan auto-scaling yang dapat menangani jutaan request per detik. Dengan 5 data center yang tersebar di Asia Pasifik, kami menjamin ketersediaan 99.99% bahkan saat traffic tinggi."
    },
    {
      q: "Apakah data verifikasi disimpan dan bagaimana keamanannya?",
      a: "Semua data disimpan dengan enkripsi AES-256 dan didistribusikan ke multi-region. Kami mengikuti standar ISO 27001, GDPR, dan SOC 2 Type II. Data tidak pernah dibagikan ke pihak ketiga tanpa persetujuan."
    },
    {
      q: "Berapa lama waktu yang dibutuhkan untuk integrasi?",
      a: "Untuk integrasi standar melalui API, biasanya membutuhkan 1-2 minggu. Untuk integrasi enterprise dengan custom requirements, timeline bervariasi antara 2-6 minggu tergantung kompleksitas."
    },
    {
      q: "Apakah ada sandbox environment untuk testing?",
      a: "Ya, kami menyediakan sandbox environment lengkap dengan data dummy untuk testing. Anda bisa mengakses semua fitur API dan SDK di environment ini sebelum deploy ke production."
    },
    {
      q: "Bagaimana sistem mendeteksi produk palsu?",
      a: "Sistem kami menggunakan kombinasi QR code unik, scratch PIN, dan database real-time. Setiap kode hanya bisa diverifikasi satu kali. Jika ada upaya duplikasi atau verifikasi berulang, sistem akan otomatis menandai sebagai anomali."
    },
    {
      q: "Apakah tersedia dukungan teknis 24/7?",
      a: "Ya, tim support kami tersedia 24/7 untuk semua klien enterprise. Untuk klien standar, support tersedia pada jam kerja dengan SLA response time kurang dari 4 jam."
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative">
      <div className="max-w-4xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Search className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">FAQ</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Pertanyaan <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Teknis</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Jawaban untuk pertanyaan yang sering ditanyakan tentang teknologi kami.
          </p>
        </motion.div>

        <div className="space-y-3">
          {faqs.map((faq, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 10 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ delay: idx * 0.05 }}
              className="bg-white rounded-2xl border border-gray-100 overflow-hidden hover:border-[#E8D09E]/40 transition-all"
            >
              <button
                onClick={() => setOpenIndex(openIndex === idx ? null : idx)}
                className="w-full flex items-center justify-between gap-4 p-5 text-left"
              >
                <h3 className="font-bold text-[#1A1A1A] text-base md:text-lg pr-4">
                  {faq.q}
                </h3>
                <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-all ${
                  openIndex === idx
                    ? 'bg-[#C5A059] text-white rotate-180'
                    : 'bg-[#FAF8F5] text-[#8C6F3D]'
                }`}>
                  <ChevronDown className="w-4 h-4" />
                </div>
              </button>

              <AnimatePresence>
                {openIndex === idx && (
                  <motion.div
                    initial={{ height: 0, opacity: 0 }}
                    animate={{ height: 'auto', opacity: 1 }}
                    exit={{ height: 0, opacity: 0 }}
                    transition={{ duration: 0.3 }}
                    className="overflow-hidden"
                  >
                    <div className="px-5 pb-5 pt-0">
                      <div className="pt-4 border-t border-gray-200">
                        <p className="text-sm text-gray-600 leading-relaxed">
                          {faq.a}
                        </p>
                      </div>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// CTA SECTION
// ============================================================================
function TechnologyCTA() {
  return (
    <section className="py-16 md:py-24 bg-white relative overflow-hidden">
      <div className="max-w-5xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="relative bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 md:p-16 text-white text-center shadow-2xl overflow-hidden"
        >
          <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/15 rounded-full blur-3xl pointer-events-none" />
          <div className="absolute bottom-0 left-0 w-72 h-72 bg-[#8C6F3D]/10 rounded-full blur-3xl pointer-events-none" />

          <div className="relative z-10 space-y-6 max-w-2xl mx-auto">
            <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-1.5 rounded-full">
              <Handshake className="w-4 h-4 text-[#E8D09E]" />
              <span className="text-xs font-bold text-[#E8D09E] tracking-wider uppercase">Demo Teknologi</span>
            </div>

            <h2 className="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight">
              Lihat Teknologi Kami <br className="hidden md:block" />
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#E8D09E] to-[#C5A059]">
                Beraksi
              </span>
            </h2>

            <p className="text-gray-300 text-lg leading-relaxed">
              Jadwalkan demo pribadi dengan tim kami dan saksikan langsung bagaimana teknologi kami dapat melindungi brand Anda.
            </p>

            <div className="flex flex-col sm:flex-row gap-4 justify-center pt-4">
              <Link
                to="/contact"
                className="group inline-flex items-center justify-center gap-3 bg-[#C5A059] text-[#1A1A1A] px-8 py-4 rounded-xl font-bold text-lg hover:bg-[#E8D09E] transition-all duration-300 shadow-lg hover:shadow-[#C5A059]/30 hover:-translate-y-0.5"
              >
                <span>Jadwalkan Demo</span>
                <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
              </Link>
              <a
                href="#core"
                className="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-all duration-300"
              >
                <Search className="w-5 h-5" />
                <span>Pelajari Detail</span>
              </a>
            </div>

            <div className="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-6 text-xs text-gray-400">
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Demo Gratis
              </span>
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Konsultasi Teknis
              </span>
              <span className="flex items-center gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                Sandbox Access
              </span>
            </div>
          </div>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// MAIN PAGE
// ============================================================================
export default function TechnologyPage() {
  return (
    <>
