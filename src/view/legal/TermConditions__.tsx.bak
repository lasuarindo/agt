import { useState, useEffect } from 'react'
import { Link } from 'react-router'
import { motion } from 'motion/react'
import {
  FileText,
  Shield,
  ShieldCheck,
  Lock,
  Users,
  Globe,
  Mail,
  Phone,
  MapPin,
  CheckCircle2,
  AlertCircle,
  ArrowRight,
  Clock,
  Server,
  UserCheck,
  RefreshCw,
  MessageCircle,
  ChevronRight,
  Sparkles,
  BookOpen,
  HelpCircle,
  Scale,
  CreditCard,
  Package,
  Code2,
  AlertTriangle,
  Building2,
  Handshake,
  XCircle,
  Gavel,
  FileCheck,
  BadgeCheck
} from 'lucide-react'

// ============================================================================
// HERO TERMS & CONDITIONS
// ============================================================================
function HeroTerms() {
  return (
    <section className="relative pt-32 pb-12 md:pt-40 md:pb-16 overflow-hidden">
      <div className="absolute inset-0 bg-gradient-to-br from-[#FAF8F5] via-[#F5EFE6] to-[#E8D09E]/20" />
      <div className="absolute top-0 right-0 -mt-32 -mr-32 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 -mb-32 -ml-32 w-[600px] h-[600px] bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div
        className="absolute inset-0 opacity-[0.03] pointer-events-none"
        style={{
          backgroundImage: `linear-gradient(rgba(26, 26, 26, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 26, 26, 1) 1px, transparent 1px)`,
          backgroundSize: '60px 60px'
        }}
      />

      <div className="relative z-10 max-w-5xl mx-auto px-4 md:px-8 text-center">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-[#C5A059]/40 px-4 py-2 rounded-full mb-6"
        >
          <FileText className="w-4 h-4 text-[#C5A059]" />
          <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Syarat & Ketentuan</span>
        </motion.div>

        <motion.h1
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.1 }}
          className="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#1A1A1A] leading-[1.1] tracking-tight mb-6"
        >
          Syarat & <br className="hidden md:block" />
          <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] via-[#C5A059] to-[#8C6F3D]">
            Ketentuan
          </span>
        </motion.h1>

        <motion.p
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8"
        >
          Syarat dan ketentuan ini mengatur penggunaan layanan PT. Autentikasi Garda Teknologi. Dengan menggunakan layanan kami, Anda menyetujui seluruh ketentuan yang tertera di bawah ini.
        </motion.p>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.3 }}
          className="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-gray-600"
        >
          <span className="flex items-center gap-2">
            <Clock className="w-4 h-4 text-[#8C6F3D]" />
            <span className="font-semibold">Berlaku Sejak: 22 Juni 2026</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <FileText className="w-4 h-4 text-[#8C6F3D]" />
            <span className="font-semibold">Versi 2.0</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <Scale className="w-4 h-4 text-[#8C6F3D]" />
            <span className="font-semibold">Hukum Indonesia</span>
          </span>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// TABLE OF CONTENTS
// ============================================================================
function TableOfContents() {
  const sections = [
    { id: 'pendahuluan', label: 'Pendahuluan', icon: <BookOpen className="w-4 h-4" /> },
    { id: 'definisi', label: 'Definisi', icon: <FileText className="w-4 h-4" /> },
    { id: 'layanan', label: 'Layanan Kami', icon: <Package className="w-4 h-4" /> },
    { id: 'pendaftaran', label: 'Pendaftaran Akun', icon: <UserCheck className="w-4 h-4" /> },
    { id: 'kewajiban', label: 'Kewajiban Pengguna', icon: <CheckCircle2 className="w-4 h-4" /> },
    { id: 'hak-kekayaan', label: 'Hak Kekayaan Intelektual', icon: <Shield className="w-4 h-4" /> },
    { id: 'pembayaran', label: 'Pembayaran & Harga', icon: <CreditCard className="w-4 h-4" /> },
    { id: 'batasan', label: 'Batasan Tanggung Jawab', icon: <AlertTriangle className="w-4 h-4" /> },
    { id: 'indemnifikasi', label: 'Indemnifikasi', icon: <Handshake className="w-4 h-4" /> },
    { id: 'penghentian', label: 'Penghentian Layanan', icon: <XCircle className="w-4 h-4" /> },
    { id: 'sengketa', label: 'Penyelesaian Sengketa', icon: <Gavel className="w-4 h-4" /> },
    { id: 'hukum', label: 'Hukum yang Berlaku', icon: <Scale className="w-4 h-4" /> },
    { id: 'perubahan', label: 'Perubahan Syarat', icon: <RefreshCw className="w-4 h-4" /> },
    { id: 'kontak', label: 'Hubungi Kami', icon: <MessageCircle className="w-4 h-4" /> }
  ]

  return (
    <motion.aside
      initial={{ opacity: 0, x: -20 }}
      animate={{ opacity: 1, x: 0 }}
      transition={{ duration: 0.5 }}
      className="lg:col-span-3"
    >
      <div className="sticky top-28 bg-white border border-[#E8D09E]/30 rounded-2xl p-6 shadow-sm">
        <div className="flex items-center gap-2 mb-4">
          <FileText className="w-5 h-5 text-[#8C6F3D]" />
          <h3 className="font-bold text-[#1A1A1A]">Daftar Isi</h3>
        </div>
        <nav className="space-y-1">
          {sections.map((section) => (
            <a
              key={section.id}
              href={`#${section.id}`}
              className="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-[#8C6F3D] hover:bg-[#FAF8F5] rounded-lg transition-all group"
            >
              <span className="text-[#8C6F3D]/60 group-hover:text-[#8C6F3D] transition-colors">
                {section.icon}
              </span>
              <span className="flex-1">{section.label}</span>
              <ChevronRight className="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" />
            </a>
          ))}
        </nav>
      </div>
    </motion.aside>
  )
}

// ============================================================================
// SECTION WRAPPER COMPONENT
// ============================================================================
function TermsSection({ id, title, icon, children }: {
  id: string
  title: string
  icon: React.ReactNode
  children: React.ReactNode
}) {
  return (
    <motion.section
      id={id}
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.5 }}
      className="scroll-mt-28"
    >
      <div className="flex items-center gap-3 mb-5">
        <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
          {icon}
        </div>
        <h2 className="text-2xl md:text-3xl font-bold text-[#1A1A1A] tracking-tight">
          {title}
        </h2>
      </div>
      <div className="prose prose-gray max-w-none">
        {children}
      </div>
    </motion.section>
  )
}

// ============================================================================
// CALLOUT BOX COMPONENT
// ============================================================================
function CalloutBox({ type = 'info', title, children }: {
  type?: 'info' | 'warning' | 'success' | 'important'
  title?: string
  children: React.ReactNode
}) {
  const styles = {
    info: {
      bg: 'bg-blue-50',
      border: 'border-blue-200',
      icon: <AlertCircle className="w-5 h-5 text-blue-600" />,
      titleColor: 'text-blue-900',
      textColor: 'text-blue-800'
    },
    warning: {
      bg: 'bg-amber-50',
      border: 'border-amber-200',
      icon: <AlertTriangle className="w-5 h-5 text-amber-600" />,
      titleColor: 'text-amber-900',
      textColor: 'text-amber-800'
    },
    success: {
      bg: 'bg-emerald-50',
      border: 'border-emerald-200',
      icon: <CheckCircle2 className="w-5 h-5 text-emerald-600" />,
      titleColor: 'text-emerald-900',
      textColor: 'text-emerald-800'
    },
    important: {
      bg: 'bg-red-50',
      border: 'border-red-200',
      icon: <AlertCircle className="w-5 h-5 text-red-600" />,
      titleColor: 'text-red-900',
      textColor: 'text-red-800'
    }
  }

  const style = styles[type]

  return (
    <div className={`${style.bg} ${style.border} border rounded-2xl p-5 my-6`}>
      <div className="flex items-start gap-3">
        <div className="shrink-0 mt-0.5">{style.icon}</div>
        <div className="flex-1">
          {title && (
            <h4 className={`font-bold ${style.titleColor} mb-2`}>{title}</h4>
          )}
          <div className={`text-sm ${style.textColor} leading-relaxed`}>
            {children}
          </div>
        </div>
      </div>
    </div>
  )
}

// ============================================================================
// NUMBERED LIST COMPONENT
// ============================================================================
function NumberedList({ items }: { items: string[] }) {
  return (
    <ol className="list-decimal list-inside space-y-2 ml-4 my-4">
      {items.map((item, idx) => (
        <li key={idx} className="text-gray-600 leading-relaxed">{item}</li>
      ))}
    </ol>
  )
}

// ============================================================================
// MAIN CONTENT
// ============================================================================
function TermsContent() {
  return (
    <motion.div
      initial={{ opacity: 0, x: 20 }}
      animate={{ opacity: 1, x: 0 }}
      transition={{ duration: 0.5, delay: 0.1 }}
      className="lg:col-span-9 space-y-16"
    >
      {/* 1. PENDAHULUAN */}
      <TermsSection id="pendahuluan" title="Pendahuluan" icon={<BookOpen className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Selamat datang di <strong className="text-[#1A1A1A]">AuthenticGuards</strong>, sebuah platform layanan yang dioperasikan oleh <strong className="text-[#1A1A1A]">PT. Autentikasi Garda Teknologi</strong> ("kami", "milik kami", atau "perusahaan"), sebuah perseroan terbatas yang didirikan berdasarkan hukum Republik Indonesia.
          </p>
          <p>
            Syarat dan Ketentuan ini ("Syarat") merupakan perjanjian hukum yang mengikat antara Anda ("Pengguna", "Anda", atau "Klien") dengan PT. Autentikasi Garda Teknologi terkait penggunaan layanan autentikasi produk yang kami sediakan melalui website, aplikasi mobile, API, dan platform terkait (secara kolektif disebut "Layanan").
          </p>
        </div>

        <CalloutBox type="important" title="PENTING: Baca dengan Seksama">
          <p>
            Dengan mendaftar, mengakses, atau menggunakan Layanan kami, Anda menyatakan bahwa Anda telah membaca, memahami, dan menyetujui untuk terikat oleh Syarat dan Ketentuan ini, serta <Link to="/privacy-policy" className="font-semibold hover:underline">Kebijakan Privasi</Link> kami. Jika Anda tidak menyetujui Syarat ini, Anda tidak diperkenankan menggunakan Layanan kami.
          </p>
        </CalloutBox>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Syarat ini berlaku untuk seluruh pengguna Layanan kami, termasuk namun tidak terbatas pada:
          </p>
          <ul className="list-disc list-inside space-y-2 ml-4">
            <li>Brand owner dan produsen yang menggunakan layanan autentikasi produk</li>
            <li>Distributor dan retailer yang menggunakan sistem tracking</li>
            <li>Konsumen yang melakukan verifikasi produk</li>
            <li>Pengguna yang mendaftar akun AuthenticGuards</li>
            <li>Developer yang menggunakan API kami</li>
          </ul>
        </div>
      </TermsSection>

      {/* 2. DEFINISI */}
      <TermsSection id="definisi" title="Definisi" icon={<FileText className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Untuk keperluan Syarat dan Ketentuan ini, istilah-istilah berikut memiliki makna sebagaimana didefinisikan di bawah ini:
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-3 my-6">
          {[
            { term: 'Layanan', def: 'Seluruh produk, fitur, dan fungsi yang disediakan oleh AuthenticGuards termasuk sticker hologram, garment label, sistem verifikasi, dashboard analytics, dan API.' },
            { term: 'Pengguna', def: 'Setiap individu atau entitas hukum yang mendaftar dan/atau menggunakan Layanan kami, baik sebagai brand owner, distributor, maupun konsumen.' },
            { term: 'Produk', def: 'Barang fisik yang dilabeli dengan teknologi autentikasi AuthenticGuards (QR code, scratch PIN, hologram).' },
            { term: 'Verifikasi', def: 'Proses validasi keaslian produk melalui scan QR code dan input scratch PIN.' },
            { term: 'Klaim', def: 'Proses pendaftaran kepemilikan produk oleh konsumen untuk mengaktifkan garansi dan manfaat.' },
            { term: 'Dashboard', def: 'Antarmuka web-based untuk monitoring dan analytics yang disediakan untuk brand owner.' },
            { term: 'API', def: 'Application Programming Interface yang memungkinkan integrasi sistem eksternal dengan Layanan kami.' },
            { term: 'Data Verifikasi', def: 'Informasi yang tercatat saat verifikasi produk dilakukan, termasuk waktu, lokasi, dan status.' }
          ].map((item, idx) => (
            <div key={idx} className="p-4 bg-[#FAF8F5] rounded-xl border border-gray-100">
              <h4 className="font-bold text-[#1A1A1A] mb-2">{item.term}</h4>
              <p className="text-sm text-gray-600 leading-relaxed">{item.def}</p>
            </div>
          ))}
        </div>
      </TermsSection>

      {/* 3. LAYANAN KAMI */}
      <TermsSection id="layanan" title="Layanan Kami" icon={<Package className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            AuthenticGuards menyediakan berbagai layanan autentikasi dan perlindungan produk, termasuk namun tidak terbatas pada:
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          {[
            {
              icon: <ShieldCheck className="w-5 h-5" />,
              title: 'Sticker Hologram',
              desc: 'Label autentikasi dengan teknologi hologram premium, QR code unik, dan scratch PIN 6 digit.'
            },
            {
              icon: <Package className="w-5 h-5" />,
              title: 'Garment Label',
              desc: 'Label tekstil khusus untuk industri fashion dengan integrasi teknologi autentikasi.'
            },
            {
              icon: <Shield className="w-5 h-5" />,
              title: 'Brand Protection',
              desc: 'Sistem monitoring real-time untuk mendeteksi aktivitas pemalsuan dan anomali.'
            },
            {
              icon: <Lock className="w-5 h-5" />,
              title: 'Supply Chain Security',
              desc: 'Tracking end-to-end dari pabrik hingga ke tangan konsumen.'
            },
            {
              icon: <Code2 className="w-5 h-5" />,
              title: 'API Integration',
              desc: 'RESTful API dan GraphQL untuk integrasi dengan sistem existing klien.'
            },
            {
              icon: <Building2 className="w-5 h-5" />,
              title: 'Dashboard Analytics',
              desc: 'Platform web-based untuk monitoring dan analisis data verifikasi.'
            }
          ].map((item, idx) => (
            <div key={idx} className="flex items-start gap-3 p-4 bg-white border border-gray-100 rounded-xl hover:border-[#E8D09E]/40 hover:shadow-sm transition-all">
              <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
                {item.icon}
              </div>
              <div className="flex-1">
                <h4 className="font-bold text-[#1A1A1A] text-sm mb-1">{item.title}</h4>
                <p className="text-xs text-gray-600 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <CalloutBox type="info" title="Cakupan Layanan">
          <p>
            Kami berhak untuk memodifikasi, menangguhkan, atau menghentikan sebagian atau seluruh Layanan kapan saja, dengan atau tanpa pemberitahuan sebelumnya, untuk keperluan pemeliharaan, peningkatan, atau alasan lainnya. Kami akan berusaha memberikan pemberitahuan yang wajar apabila perubahan tersebut berdampak signifikan pada Layanan yang sedang Anda gunakan.
          </p>
        </CalloutBox>
      </TermsSection>

      {/* 4. PENDAFTARAN AKUN */}
      <TermsSection id="pendaftaran" title="Pendaftaran Akun" icon={<UserCheck className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Untuk mengakses fitur-fitur tertentu dari Layanan kami, Anda diminta untuk membuat akun. Dalam proses pendaftaran, Anda setuju untuk:
          </p>
        </div>

        <NumberedList items={[
          'Memberikan informasi yang akurat, lengkap, dan terkini sesuai formulir pendaftaran',
          'Menjaga kerahasiaan password dan kredensial akun Anda',
          'Segera memberitahukan kami tentang setiap penggunaan tidak sah atas akun Anda',
          'Memastikan bahwa Anda berusia minimal 17 tahun atau telah mendapatkan persetujuan orang tua/wali',
          'Bertanggung jawab penuh atas seluruh aktivitas yang terjadi di bawah akun Anda'
        ]} />

        <CalloutBox type="warning" title="Keamanan Akun">
          <p>
            Anda bertanggung jawab penuh untuk menjaga kerahasiaan password dan semua aktivitas yang terjadi di bawah akun Anda. Kami tidak akan bertanggung jawab atas kerugian atau kerusakan yang timbul akibat kegagalan Anda mematuhi kewajiban keamanan ini. Segera hubungi kami jika Anda mencurigai adanya penggunaan tidak sah atas akun Anda.
          </p>
        </CalloutBox>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Kami berhak untuk menolak pendaftaran, menangguhkan, atau menghentikan akun Anda apabila:
          </p>
          <ul className="list-disc list-inside space-y-2 ml-4">
            <li>Informasi yang diberikan tidak akurat, menyesatkan, atau tidak lengkap</li>
            <li>Anda melanggar ketentuan dalam Syarat dan Ketentuan ini</li>
            <li>Aktivitas akun Anda terindikasi fraudulent atau melanggar hukum</li>
            <li>Anda tidak menggunakan Layanan selama periode yang berkepanjangan</li>
            <li>Diperlukan untuk memenuhi kewajiban hukum atau regulasi</li>
          </ul>
        </div>
      </TermsSection>

      {/* 5. KEWAJIBAN PENGGUNA */}
      <TermsSection id="kewajiban" title="Kewajiban Pengguna" icon={<CheckCircle2 className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Dalam menggunakan Layanan kami, Anda setuju untuk tidak:
          </p>
        </div>

        <div className="space-y-3 my-6">
          {[
            'Menggunakan Layanan untuk tujuan ilegal atau tidak sah',
            'Melanggar hukum dan regulasi yang berlaku di yurisdiksi Anda',
            'Menyalin, memodifikasi, atau mendistribusikan teknologi autentikasi kami tanpa izin',
            'Mencoba untuk membobol, reverse-engineer, atau mengakses sistem kami secara tidak sah',
            'Mengunggah atau mentransmisikan virus, malware, atau kode berbahaya lainnya',
            'Menggunakan Layanan untuk mengirim spam atau komunikasi yang tidak diminta',
            'Menyebarkan informasi palsu atau menyesatkan tentang produk atau Layanan',
            'Melanggar hak kekayaan intelektual kami atau pihak ketiga',
            'Menggunakan Layanan untuk memalsukan atau memalsukan produk',
            'Memberikan data palsu saat melakukan verifikasi atau klaim produk'
          ].map((item, idx) => (
            <div key={idx} className="flex items-start gap-3 p-3 bg-red-50/50 rounded-xl border border-red-100">
              <XCircle className="w-5 h-5 text-red-500 shrink-0 mt-0.5" />
              <span className="text-sm text-gray-700">{item}</span>
            </div>
          ))}
        </div>

        <CalloutBox type="important" title="Pelanggaran Ketentuan">
          <p>
            Setiap pelanggaran terhadap ketentuan di atas dapat mengakibatkan penangguhan atau penghentian akun Anda secara permanen, serta potensi tindakan hukum sesuai peraturan perundang-undangan yang berlaku. Kami juga berhak melaporkan aktivitas ilegal kepada pihak berwajib.
          </p>
        </CalloutBox>
      </TermsSection>

      {/* 6. HAK KEKAYAAN INTELEKTUAL */}
      <TermsSection id="hak-kekayaan" title="Hak Kekayaan Intelektual" icon={<Shield className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Seluruh konten, teknologi, desain, logo, merek dagang, dan kekayaan intelektual lainnya yang terkait dengan Layanan AuthenticGuards merupakan milik eksklusif PT. Autentikasi Garda Teknologi atau pemberi lisensi kami, dan dilindungi oleh:
          </p>
          <ul className="list-disc list-inside space-y-2 ml-4">
            <li>Undang-Undang No. 28 Tahun 2014 tentang Hak Cipta</li>
            <li>Undang-Undang No. 20 Tahun 2016 tentang Merek dan Indikasi Geografis</li>
            <li>Undang-Undang No. 13 Tahun 2016 tentang Paten</li>
            <li>Peraturan perundang-undangan lainnya yang berlaku</li>
          </ul>
        </div>

        <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-2xl p-6 md:p-8 text-white my-6 relative overflow-hidden">
          <div className="absolute top-0 right-0 w-48 h-48 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
          
          <div className="relative z-10">
            <div className="flex items-center gap-2 mb-5">
              <BadgeCheck className="w-6 h-6 text-[#E8D09E]" />
              <h3 className="text-xl font-bold">Perlindungan HKI Kami</h3>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[
                { label: 'Teknologi Hologram', value: 'Paten & Rahasia Dagang' },
                { label: 'Sistem Verifikasi', value: 'Hak Cipta' },
                { label: 'Brand AuthenticGuards', value: 'Merek Dagang Terdaftar' },
                { label: 'Source Code', value: 'Hak Cipta & Rahasia Dagang' }
              ].map((item, idx) => (
                <div key={idx} className="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/10">
                  <span className="text-sm text-gray-300">{item.label}</span>
                  <span className="text-sm font-bold text-[#E8D09E]">{item.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Kecuali secara tegas diizinkan dalam Syarat ini atau dengan persetujuan tertulis dari kami, Anda tidak diperkenankan untuk:
          </p>
          <ul className="list-disc list-inside space-y-2 ml-4">
            <li>Menggunakan, menyalin, atau mendistribusikan materi berhak cipta kami</li>
            <li>Menggunakan merek dagang kami tanpa izin tertulis</li>
            <li>Melakukan reverse engineering, dekompilasi, atau membongkar teknologi kami</li>
            <li>Membuat karya turunan berdasarkan Layanan kami</li>
            <li>Menghapus atau mengubah informasi hak cipta atau kepemilikan lainnya</li>
          </ul>
        </div>
      </TermsSection>

      {/* 7. PEMBAYARAN & HARGA */}
      <TermsSection id="pembayaran" title="Pembayaran & Harga" icon={<CreditCard className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Untuk layanan berbayar, ketentuan pembayaran berlaku sebagai berikut:
          </p>
        </div>

        <div className="overflow-x-auto my-6">
          <table className="w-full border border-gray-200 rounded-xl overflow-hidden">
            <thead className="bg-[#FAF8F5]">
              <tr>
                <th className="px-4 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Aspek</th>
                <th className="px-4 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Ketentuan</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {[
                { aspek: 'Harga', ketentuan: 'Disepakati dalam kontrak terpisah berdasarkan volume, jenis layanan, dan durasi kerjasama' },
                { aspek: 'Mata Uang', ketentuan: 'Seluruh pembayaran dalam Rupiah (IDR) kecuali disepakati lain secara tertulis' },
                { aspek: 'Metode Pembayaran', ketentuan: 'Transfer bank, virtual account, atau metode lain yang disetujui' },
                { aspek: 'Jatuh Tempo', ketentuan: 'Sesuai ketentuan dalam kontrak atau invoice yang diterbitkan' },
                { aspek: 'Pajak', ketentuan: 'Harga belum termasuk PPN dan pajak lainnya yang berlaku' },
                { aspek: 'Keterlambatan', ketentuan: 'Keterlambatan pembayaran dikenakan denda 0.5% per bulan dari outstanding amount' }
              ].map((row, idx) => (
                <tr key={idx} className="hover:bg-[#FAF8F5] transition-colors">
                  <td className="px-4 py-3 text-sm font-semibold text-[#1A1A1A]">{row.aspek}</td>
                  <td className="px-4 py-3 text-sm text-gray-600">{row.ketentuan}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <CalloutBox type="info" title="Konsultasi Harga">
          <p>
            Untuk informasi harga dan penawaran khusus, silakan hubungi tim sales kami melalui <a href="mailto:sales@authenticguards.com" className="font-semibold hover:underline">sales@authenticguards.com</a> atau kunjungi halaman <Link to="/contact" className="font-semibold hover:underline">Kontak</Link>.
          </p>
        </CalloutBox>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Kami berhak untuk mengubah harga layanan dengan pemberitahuan tertulis minimal 30 hari sebelum perubahan berlaku. Untuk kontrak jangka panjang, perubahan harga akan mengikuti ketentuan yang disepakati dalam kontrak.
          </p>
        </div>
      </TermsSection>

      {/* 8. BATASAN TANGGUNG JAWAB */}
      <TermsSection id="batasan" title="Batasan Tanggung Jawab" icon={<AlertTriangle className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            SEJAUH DIIZINKAN OLEH HUKUM YANG BERLAKU, AUTHENTICGUARDS DAN AFILIASINYA TIDAK BERTANGGUNG JAWAB ATAS:
          </p>
        </div>

        <div className="space-y-3 my-6">
          {[
            'Kerugian tidak langsung, insidental, khusus, atau konsekuensial',
            'Kehilangan keuntungan, pendapatan, atau bisnis',
            'Kehilangan data atau gangguan bisnis',
            'Kerusakan yang timbul dari penggunaan atau ketidakmampuan menggunakan Layanan',
            'Tindakan atau kelalaian pihak ketiga',
            'Force majeure (bencana alam, perang, kerusuhan, pandemi, dll)',
            'Kegagalan sistem yang di luar kendali wajar kami'
          ].map((item, idx) => (
            <div key={idx} className="flex items-start gap-3 p-3 bg-amber-50/50 rounded-xl border border-amber-100">
              <AlertTriangle className="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
              <span className="text-sm text-gray-700">{item}</span>
            </div>
          ))}
        </div>

        <CalloutBox type="warning" title="Batas Maksimum Tanggung Jawab">
          <p>
            Dalam hal kami tetap dianggap bertanggung jawab berdasarkan hukum yang berlaku, total tanggung jawab kami kepada Anda untuk seluruh klaim yang timbul dari atau terkait dengan Syarat ini atau Layanan kami, tidak akan melebihi jumlah yang telah Anda bayarkan kepada kami dalam 12 (dua belas) bulan terakhir sebelum timbulnya klaim tersebut.
          </p>
        </CalloutBox>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Ketentuan di atas tidak membatasi tanggung jawab kami untuk:
          </p>
          <ul className="list-disc list-inside space-y-2 ml-4">
            <li>Kecelakaan pribadi atau kematian yang disebabkan oleh kelalaian kami</li>
            <li>Penipuan atau pernyataan palsu yang disengaja</li>
            <li>Pelanggaran hak kekayaan intelektual yang disengaja</li>
            <li>Kewajiban yang tidak dapat dikecualikan berdasarkan hukum yang berlaku</li>
          </ul>
        </div>
      </TermsSection>

      {/* 9. INDEMNIFIKASI */}
      <TermsSection id="indemnifikasi" title="Indemnifikasi" icon={<Handshake className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Anda setuju untuk mengindemnifikasi, membela, dan membebaskan PT. Autentikasi Garda Teknologi, afiliasi, direktur, pejabat, karyawan, dan agen kami dari dan terhadap setiap dan seluruh klaim, tuntutan, kewajiban, kerugian, liabilitas, biaya, dan pengeluaran (termasuk biaya hukum yang wajar) yang timbul dari atau terkait dengan:
          </p>
        </div>

        <NumberedList items={[
          'Penggunaan Layanan oleh Anda',
          'Pelanggaran Syarat dan Ketentuan ini oleh Anda',
          'Pelanggaran hak pihak ketiga oleh Anda',
          'Informasi palsu atau tidak akurat yang Anda berikan',
          'Kelalaian atau misconduct Anda',
          'Produk Anda yang dilabeli dengan teknologi kami (untuk brand owner)'
        ]} />

        <CalloutBox type="info" title="Hak untuk Mengambil Alih Pertahanan">
          <p>
            Kami berhak, atas biaya kami sendiri, untuk mengambil alih pertahanan eksklusif dan kontrol atas setiap masalah yang dikenakan indemnifikasi oleh Anda, dan dalam hal tersebut, Anda setuju untuk bekerja sama dengan kami dalam mengejar setiap pembelaan yang tersedia.
          </p>
        </CalloutBox>
      </TermsSection>

      {/* 10. PENGHENTIAN LAYANAN */}
      <TermsSection id="penghentian" title="Penghentian Layanan" icon={<XCircle className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Perjanjian ini akan tetap berlaku hingga dihentikan oleh Anda atau kami sesuai ketentuan berikut:
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div className="p-5 bg-white border border-gray-200 rounded-2xl">
            <h4 className="font-bold text-[#1A1A1A] mb-3 flex items-center gap-2">
              <UserCheck className="w-5 h-5 text-[#8C6F3D]" />
              Penghentian oleh Anda
            </h4>
            <ul className="space-y-2 text-sm text-gray-600">
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Dapat menutup akun kapan saja melalui pengaturan akun</span>
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Untuk layanan berbayar, ikuti prosedur dalam kontrak</span>
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Pemberitahuan tertulis 30 hari untuk kontrak enterprise</span>
              </li>
            </ul>
          </div>

          <div className="p-5 bg-white border border-gray-200 rounded-2xl">
            <h4 className="font-bold text-[#1A1A1A] mb-3 flex items-center gap-2">
              <Building2 className="w-5 h-5 text-[#8C6F3D]" />
              Penghentian oleh Kami
            </h4>
            <ul className="space-y-2 text-sm text-gray-600">
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Pelanggaran material terhadap Syarat ini</span>
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Aktivitas ilegal atau fraudulent</span>
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Tidak aktif selama 12+ bulan (untuk akun gratis)</span>
              </li>
              <li className="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Kewajiban hukum atau regulasi</span>
              </li>
            </ul>
          </div>
        </div>

        <CalloutBox type="warning" title="Efek Penghentian">
          <p>
            Setelah penghentian, hak Anda untuk menggunakan Layanan akan segera berakhir. Ketentuan yang secara wajar dimaksudkan untuk bertahan setelah penghentian akan tetap berlaku, termasuk namun tidak terbatas pada: ketentuan kepemilikan, batasan tanggung jawab, indemnifikasi, dan ketentuan sengketa.
          </p>
        </CalloutBox>
      </TermsSection>

      {/* 11. PENYELESAIAN SENGKETA */}
      <TermsSection id="sengketa" title="Penyelesaian Sengketa" icon={<Gavel className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Setiap sengketa yang timbul dari atau terkait dengan Syarat dan Ketentuan ini akan diselesaikan melalui tahapan berikut:
          </p>
        </div>

        <div className="space-y-4 my-6">
          {[
            {
              step: '1',
              title: 'Negosiasi Langsung',
              desc: 'Para pihak akan berusaha menyelesaikan sengketa secara musyawarah dalam waktu 30 hari sejak pemberitahuan sengketa.',
              color: 'emerald'
            },
            {
              step: '2',
              title: 'Mediasi',
              desc: 'Jika negosiasi gagal, sengketa akan dimediasi oleh mediator independen yang disepakati bersama.',
              color: 'blue'
            },
            {
              step: '3',
              title: 'Arbitrase atau Pengadilan',
              desc: 'Jika mediasi tidak berhasil, sengketa akan diselesaikan melalui arbitrase BANI atau Pengadilan Negeri Bandung.',
              color: 'purple'
            }
          ].map((item, idx) => (
            <div key={idx} className="flex items-start gap-4 p-5 bg-[#FAF8F5] rounded-2xl border border-gray-100">
              <div className={`w-12 h-12 bg-${item.color}-100 text-${item.color}-600 rounded-xl flex items-center justify-center shrink-0 font-extrabold text-lg`}>
                {item.step}
              </div>
              <div className="flex-1">
                <h4 className="font-bold text-[#1A1A1A] mb-1">{item.title}</h4>
                <p className="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <CalloutBox type="info" title="Bahasa Penyelesaian Sengketa">
          <p>
            Seluruh proses penyelesaian sengketa akan dilakukan dalam Bahasa Indonesia, kecuali disepakati lain secara tertulis oleh para pihak.
          </p>
        </CalloutBox>
      </TermsSection>

      {/* 12. HUKUM YANG BERLAKU */}
      <TermsSection id="hukum" title="Hukum yang Berlaku" icon={<Scale className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Syarat dan Ketentuan ini diatur oleh dan ditafsirkan sesuai dengan hukum Republik Indonesia, tanpa memperhatikan prinsip konflik hukum.
          </p>
          <p>
            Para pihak sepakat untuk memilih domisili hukum yang tetap di Kantor Kepaniteraan Pengadilan Negeri Bandung, untuk setiap sengketa yang tidak dapat diselesaikan melalui arbitrase.
          </p>
        </div>

        <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-2xl p-6 md:p-8 text-white my-6 relative overflow-hidden">
          <div className="absolute top-0 right-0 w-48 h-48 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
          
          <div className="relative z-10">
            <div className="flex items-center gap-2 mb-5">
              <Scale className="w-6 h-6 text-[#E8D09E]" />
              <h3 className="text-xl font-bold">Regulasi yang Relevan</h3>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
              {[
                'UU No. 27/2022 - Pelindungan Data Pribadi',
                'UU No. 11/2008 - ITE (sebagaimana diubah)',
                'UU No. 8/1999 - Perlindungan Konsumen',
                'UU No. 20/2016 - Merek dan Indikasi Geografis',
                'UU No. 13/2016 - Paten',
                'UU No. 28/2014 - Hak Cipta',
                'UU No. 40/2007 - Perseroan Terbatas',
                'KUHPerdata - Hukum Perjanjian'
              ].map((item, idx) => (
                <div key={idx} className="flex items-center gap-2 p-2.5 bg-white/5 rounded-xl border border-white/10">
                  <FileCheck className="w-4 h-4 text-[#E8D09E] shrink-0" />
                  <span className="text-sm text-gray-300">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </TermsSection>

      {/* 13. PERUBAHAN SYARAT */}
      <TermsSection id="perubahan" title="Perubahan Syarat" icon={<RefreshCw className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Kami berhak untuk merevisi Syarat dan Ketentuan ini dari waktu ke waktu sesuai kebutuhan bisnis, perubahan regulasi, atau alasan lainnya. Apabila terjadi perubahan material, kami akan:
          </p>
        </div>

        <NumberedList items={[
          'Memberitahukan kepada Anda melalui email atau notifikasi dalam aplikasi minimal 30 hari sebelum perubahan berlaku',
          'Memperbarui tanggal "Terakhir Diperbarui" di bagian atas halaman ini',
          'Menyediakan ringkasan perubahan yang signifikan',
          'Meminta persetujuan ulang Anda jika diperlukan oleh hukum'
        ]} />

        <CalloutBox type="info" title="Persetujuan Anda">
          <p>
            Dengan terus menggunakan Layanan setelah perubahan berlaku, Anda dianggap telah menyetujui Syarat yang telah direvisi. Jika Anda tidak menyetujui perubahan tersebut, Anda harus menghentikan penggunaan Layanan.
          </p>
        </CalloutBox>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Kami mendorong Anda untuk meninjau Syarat ini secara berkala untuk tetap terinformasi tentang ketentuan yang berlaku.
          </p>
        </div>
      </TermsSection>

      {/* 14. KONTAK KAMI */}
      <TermsSection id="kontak" title="Hubungi Kami" icon={<MessageCircle className="w-5 h-5" />}>
        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Jika Anda memiliki pertanyaan, kekhawatiran, atau memerlukan klarifikasi terkait Syarat dan Ketentuan ini, silakan hubungi kami melalui:
          </p>
        </div>

        <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-2xl p-6 md:p-8 text-white my-6 relative overflow-hidden">
          <div className="absolute top-0 right-0 w-48 h-48 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
          
          <div className="relative z-10">
            <div className="flex items-center gap-2 mb-5">
              <Sparkles className="w-6 h-6 text-[#E8D09E]" />
              <h3 className="text-xl font-bold">Tim Legal & Compliance</h3>
            </div>

            <div className="space-y-3">
              <a href="mailto:legal@authenticguards.com" className="flex items-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10 hover:bg-white/10 transition-colors">
                <Mail className="w-5 h-5 text-[#E8D09E] shrink-0" />
                <div>
                  <p className="text-xs text-gray-400">Email (Respon &lt; 2x24 jam)</p>
                  <p className="text-sm font-bold text-white">legal@authenticguards.com</p>
                </div>
              </a>

              <a href="tel:+6281222201649" className="flex items-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10 hover:bg-white/10 transition-colors">
                <Phone className="w-5 h-5 text-[#E8D09E] shrink-0" />
                <div>
                  <p className="text-xs text-gray-400">Telepon (Senin - Jumat, 09:00 - 17:00)</p>
                  <p className="text-sm font-bold text-white">+62 812-2220-1649</p>
                </div>
              </a>

              <div className="flex items-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10">
                <MapPin className="w-5 h-5 text-[#E8D09E] shrink-0" />
                <div>
                  <p className="text-xs text-gray-400">Alamat Kantor</p>
                  <p className="text-sm font-bold text-white">Jl. Kh Wahid Hasyim No.316, Bandung 40233</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div className="text-gray-600 leading-relaxed space-y-4">
          <p>
            Untuk permintaan terkait legal atau compliance, silakan gunakan subjek email <strong className="text-[#1A1A1A]">"Permintaan Legal"</strong> agar dapat diproses dengan cepat oleh tim kami.
          </p>
        </div>
      </TermsSection>

      {/* LAST UPDATED */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        className="bg-[#FAF8F5] border border-[#E8D09E]/30 rounded-2xl p-6 text-center"
      >
        <div className="flex items-center justify-center gap-2 mb-3">
          <Clock className="w-5 h-5 text-[#8C6F3D]" />
          <p className="text-sm font-bold text-[#1A1A1A]">Dokumen Terakhir Diperbarui</p>
        </div>
        <p className="text-lg font-extrabold text-[#1A1A1A] mb-1">22 Juni 2026</p>
        <p className="text-xs text-gray-500">Versi 2.0 • PT. Autentikasi Garda Teknologi</p>
      </motion.div>

      {/* CTA */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        className="text-center"
      >
        <p className="text-gray-500 mb-4">
          Masih ada pertanyaan tentang Syarat & Ketentuan?
        </p>
        <Link
          to="/contact"
          className="inline-flex items-center gap-2 bg-[#1A1A1A] text-white px-6 py-3 rounded-xl font-bold hover:bg-[#8C6F3D] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
        >
          <span>Hubungi Tim Kami</span>
          <ArrowRight className="w-4 h-4" />
        </Link>
      </motion.div>
    </motion.div>
  )
}

// ============================================================================
// MAIN PAGE
// ============================================================================
export default function TermsPage() {
  return (
    <>
      <style>{`@import url('https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.16/index.css'); body { font-family: 'Inter', sans-serif; background-color: #FAFAFA; } html { scroll-behavior: smooth; }`}</style>

      <div className="min-h-screen bg-white text-[#1A1A1A]">
        <main>
          <HeroTerms />

          <div className="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
              <TableOfContents />
              <TermsContent />
            </div>
          </div>
        </main>
      </div>
    </>
  )
}