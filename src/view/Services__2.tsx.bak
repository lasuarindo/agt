import { useEffect, useState } from 'react'
import { Link, useLocation } from 'react-router'
import { motion, AnimatePresence } from 'motion/react'
import {
  Shield,
  ShieldCheck,
  Tag,
  Layers,
  Lock,
  Eye,
  Zap,
  CheckCircle2,
  ArrowRight,
  Sparkles,
  Package,
  QrCode,
  Fingerprint,
  TrendingUp,
  Smartphone,
  BarChart3,
  AlertTriangle,
  Clock,
  Users,
  Building2,
  Globe,
  Award,
  ChevronDown,
  ChevronRight,
  Target,
  Lightbulb,
  Handshake,
  FileCheck,
  ScanLine,
  Database,
  Bell,
  LineChart,
  Truck,
  Factory,
  Boxes,
  Search,
  // Tambahan icon untuk layanan baru & customer features
  Nfc,
  Printer,
  Hash,
  BadgeCheck,
  MapPin,
  ShoppingBag,
  Heart,
  Megaphone,
  ShieldAlert,
  ArrowUpRight
} from 'lucide-react'

// ============================================================================
// HERO SERVICES SECTION (disesuaikan dengan proposal)
// ============================================================================
function HeroServices() {
  return (
    <section className="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden">
      <div className="absolute inset-0 bg-gradient-to-br from-[#FAF8F5] via-[#F5EFE6] to-[#E8D09E]/20" />
      <div className="absolute top-0 right-0 -mt-32 -mr-32 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 -mb-32 -ml-32 w-[600px] h-[600px] bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />
      <div
        className="absolute inset-0 opacity-[0.03] pointer-events-none"
        style={{
          backgroundImage: `linear-gradient(rgba(26, 26, 26, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 26, 26, 1) 1px, transparent 1px)`,
          backgroundSize: '60px 60px'
        }}
      />

      <div className="relative z-10 max-w-5xl mx-auto px-4 md:px-8 text-center">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-[#C5A059]/40 px-4 py-2 rounded-full mb-6"
        >
          <Sparkles className="w-4 h-4 text-[#C5A059]" />
          <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Layanan Kami</span>
        </motion.div>

        <motion.h1
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.1 }}
          className="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#1A1A1A] leading-[1.1] tracking-tight mb-6"
        >
          Solusi Marking <br className="hidden md:block" />
          <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] via-[#C5A059] to-[#8C6F3D]">
            Anti-Pemalsuan
          </span>
          <br className="hidden md:block" />
          untuk Berbagai Industri
        </motion.h1>

        <motion.p
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8"
        >
          Authentic Guards menyediakan solusi marking (penanda) untuk berbagai macam industri dengan 4 opsi media utama:
          Label Tafeta, Sticker ber-NFC, Hologram dengan QR, dan Printing QR pada Kemasan — terintegrasi penuh dengan sistem AG.
        </motion.p>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.3 }}
          className="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-gray-600"
        >
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            {/* Disesuaikan: 4 marking options sesuai proposal */}
            <span className="font-semibold">4 Opsi Marking</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            <span className="font-semibold">Customizable</span>
          </span>
          <span className="hidden md:inline w-1 h-1 bg-gray-300 rounded-full" />
          <span className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-600" />
            {/* Disesuaikan: ISO/IEC 18004:2015 Licensed */}
            <span className="font-semibold">Licensed ISO 18004:2015</span>
          </span>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// SERVICES OVERVIEW - 4 Marking Options (disesuaikan dengan proposal)
// ============================================================================
function ServicesOverview() {
  // Disesuaikan: 4 opsi marking dari proposal
  const services = [
    {
      id: 'hologram',
      icon: <Sparkles className="w-7 h-7" />,
      title: "Hologram dengan QR",
      subtitle: "Premium Security",
      desc: "Kombinasi hologram premium dengan kode QR untuk lapisan keamanan ganda yang sulit dipalsukan.",
      highlights: [
        { label: "Lapisan Keamanan", value: "Ganda" },
        { label: "Tingkat Kesulitan Palsu", value: "Sangat Tinggi" }
      ],
      industries: ["Farmasi", "Kosmetik", "Elektronik", "Minuman Keras"],
      gradient: "from-emerald-500/10 to-emerald-500/[0.02]",
      iconBg: "bg-emerald-100",
      iconColor: "text-emerald-600",
      accentBorder: "border-emerald-200"
    },
    {
      id: 'tafeta',
      icon: <Tag className="w-7 h-7" />,
      title: "Label Tafeta dengan QR",
      subtitle: "Fashion Solution",
      desc: "Label tafeta berkualitas tinggi dengan kode QR terintegrasi, cocok untuk industri fashion dan tekstil.",
      highlights: [
        { label: "Material", value: "Premium" },
        { label: "Industri", value: "Fashion & Tekstil" }
      ],
      industries: ["Fashion", "Apparel", "Footwear", "Accessories"],
      gradient: "from-[#C5A059]/10 to-[#E8D09E]/5",
      iconBg: "bg-[#E8D09E]/30",
      iconColor: "text-[#8C6F3D]",
      accentBorder: "border-[#E8D09E]/40"
    },
    {
      id: 'nfc',
      icon: <Nfc className="w-7 h-7" />,
      title: "Sticker ber-NFC",
      subtitle: "Smart Technology",
      desc: "Sticker dengan teknologi NFC untuk memudahkan pengaplikasian marking dan verifikasi instan via smartphone.",
      highlights: [
        { label: "Teknologi", value: "NFC Enabled" },
        { label: "Verifikasi", value: "Tap & Go" }
      ],
      industries: ["Luxury Goods", "Premium Brand", "Spirits", "Electronics"],
      gradient: "from-blue-500/10 to-blue-500/[0.02]",
      iconBg: "bg-blue-100",
      iconColor: "text-blue-600",
      accentBorder: "border-blue-200"
    },
    {
      id: 'printing',
      icon: <Printer className="w-7 h-7" />,
      title: "Printing QR pada Kemasan",
      subtitle: "Direct Integration",
      desc: "Pencetakan QR langsung pada kemasan produk dengan driver printer klien yang terintegrasi penuh.",
      highlights: [
        { label: "Integrasi", value: "Driver Printer" },
        { label: "Kapasitas", value: "100M/hari" }
      ],
      industries: ["FMCG", "Makanan", "Minuman", "Household"],
      gradient: "from-purple-500/10 to-purple-500/[0.02]",
      iconBg: "bg-purple-100",
      iconColor: "text-purple-600",
      accentBorder: "border-purple-200"
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-16 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Package className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Marking Development</span>
          </div>
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Empat Opsi <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Penandaan</span>
          </h2>
          <p className="text-gray-500 text-lg leading-relaxed">
            Solusi marking multi-industri yang terintegrasi penuh dengan sistem Authentic Guards.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {services.map((service, idx) => (
            <motion.a
              key={service.id}
              href={`#${service.id}`}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className={`group relative bg-white rounded-3xl border ${service.accentBorder} hover:border-[#C5A059]/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden p-8 md:p-10 cursor-pointer`}
            >
              <div className={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />

              <div className="relative z-10">
                <div className="flex items-start justify-between mb-6">
                  <div className="flex items-start gap-4">
                    <div className={`w-14 h-14 ${service.iconBg} ${service.iconColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                      {service.icon}
                    </div>
                    <div>
                      <span className="text-[10px] font-bold text-[#8C6F3D] uppercase tracking-widest mb-1 block">
                        {service.subtitle}
                      </span>
                      <h3 className="text-2xl font-bold text-[#1A1A1A] mb-2">
                        {service.title}
                      </h3>
                    </div>
                  </div>

                  <div className="hidden md:flex items-center gap-1.5 bg-[#E8D09E]/20 text-[#8C6F3D] px-3 py-1.5 rounded-full text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">
                    <span>Detail</span>
                    <ArrowRight className="w-3.5 h-3.5" />
                  </div>
                </div>

                <p className="text-gray-600 leading-relaxed mb-6 text-base">
                  {service.desc}
                </p>

                <div className="grid grid-cols-2 gap-4 mb-6 p-4 bg-white/50 backdrop-blur-sm rounded-2xl border border-gray-100">
                  {service.highlights.map((stat, sIdx) => (
                    <div key={sIdx} className="text-center">
                      <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
                      <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
                    </div>
                  ))}
                </div>

                <div>
                  <p className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                    Cocok untuk:
                  </p>
                  <div className="flex flex-wrap gap-2">
                    {service.industries.map((industry, iIdx) => (
                      <span
                        key={iIdx}
                        className="text-xs font-semibold text-gray-600 bg-gray-100 px-3 py-1.5 rounded-full"
                      >
                        {industry}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </motion.a>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Hologram dengan QR (disesuaikan dengan proposal)
// ============================================================================
function HologramDetail() {
  // Disesuaikan: Hologram dengan QR dari proposal (bukan "Sticker Hologram + Scratch PIN")
  const features = [
    {
      icon: <Sparkles className="w-5 h-5" />,
      title: "Hologram Premium Multi-Layer",
      desc: "Teknologi hologram dengan efek visual yang sulit ditiru, memberikan lapisan keamanan fisik pertama."
    },
    {
      icon: <QrCode className="w-5 h-5" />,
      title: "QR Code Terintegrasi",
      desc: "Kode QR dengan standar ISO/IEC 18004:2015 (licensed) yang terhubung ke database AG real-time."
    },
    {
      icon: <ShieldAlert className="w-5 h-5" />,
      title: "Tamper-Evident",
      desc: "Label dirancang untuk menunjukkan tanda-tanda pembukaan, mencegah transfer kode ke produk lain."
    },
    {
      icon: <Database className="w-5 h-5" />,
      title: "Verifikasi Real-time",
      desc: "Setiap scan langsung divalidasi ke cloud database AG dengan standar ISO/IEC 27000:2016."
    }
  ]

  const benefits = [
    "Kombinasi keamanan fisik (hologram) + digital (QR)",
    "Verifikasi mudah oleh konsumen via smartphone",
    "Terintegrasi dengan 5 lapis keamanan AG",
    "Sulit dipalsukan — 2 lapisan proteksi",
    "Custom design sesuai brand identity",
    "Cocok untuk produk premium & high-value"
  ]

  return (
    <section id="hologram" className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden scroll-mt-20">
      <div className="absolute top-0 right-0 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none" />
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Content */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-emerald-100 border border-emerald-200 px-4 py-2 rounded-full">
              <Sparkles className="w-4 h-4 text-emerald-600" />
              <span className="text-xs font-bold text-emerald-700 uppercase tracking-widest">Premium Security</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Hologram <span className="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-emerald-500">dengan QR</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Kombinasi hologram premium dengan kode QR untuk lapisan keamanan ganda. Hologram memberikan proteksi fisik yang sulit dipalsukan, sementara QR code terintegrasi dengan sistem verifikasi digital Authentic Guards.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: -20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-white rounded-2xl border border-gray-100 hover:border-emerald-200 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>
          </motion.div>

          {/* Right Content */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            {/* Visual Card */}
            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl" />

              <div className="relative z-10">
                <div className="flex items-center gap-2 mb-6">
                  <div className="w-2 h-2 bg-[#C5A059] rounded-full animate-pulse" />
                  <span className="text-xs font-bold text-[#C5A059] uppercase tracking-wider">Example Verification</span>
                </div>

                <div className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 space-y-4">
                  <div className="flex items-center gap-3">
                    <div className="w-12 h-12 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center">
                      <Sparkles className="w-6 h-6 text-white" />
                    </div>
                    <div>
                      <p className="text-xs text-gray-400">Produk Terverifikasi</p>
                      <p className="text-white font-bold">Hologram + QR Code</p>
                    </div>
                  </div>

                  <div className="grid grid-cols-2 gap-3">
                    <div className="bg-white/5 rounded-xl p-3">
                      <p className="text-[10px] text-gray-400 uppercase tracking-wider">Kode AG</p>
                      <p className="text-sm font-mono font-bold text-emerald-400">AG-7J1DG</p>
                    </div>
                    <div className="bg-white/5 rounded-xl p-3">
                      <p className="text-[10px] text-gray-400 uppercase tracking-wider">Status</p>
                      <div className="flex items-center gap-1">
                        <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                        <p className="text-sm font-bold text-emerald-400">Original</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Benefits Card */}
            <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-4 flex items-center gap-2">
                <CheckCircle2 className="w-5 h-5 text-emerald-500" />
                Keuntungan Utama
              </h4>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                {benefits.map((benefit, idx) => (
                  <div key={idx} className="flex items-start gap-2 p-2">
                    <div className="w-1.5 h-1.5 bg-emerald-500 rounded-full mt-2 shrink-0" />
                    <span className="text-sm text-gray-700">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Label Tafeta dengan QR (menggantikan Garment Label)
// ============================================================================
function TafetaLabelDetail() {
  // Disesuaikan: Label Tafeta dengan QR dari proposal
  const features = [
    {
      icon: <Tag className="w-5 h-5" />,
      title: "Material Tafeta Premium",
      desc: "Label tafeta berkualitas tinggi yang tahan lama, nyaman dikenakan, dan cocok untuk produk fashion."
    },
    {
      icon: <QrCode className="w-5 h-5" />,
      title: "QR Code Terintegrasi",
      desc: "QR code dicetak langsung pada label dengan teknologi high-resolution printing, standar ISO 18004:2015."
    },
    {
      icon: <Layers className="w-5 h-5" />,
      title: "Integrasi dengan Desain Label",
      desc: "QR code menyatu dengan desain label secara estetis, tidak mengganggu tampilan produk."
    },
    {
      icon: <Target className="w-5 h-5" />,
      title: "Fully Customizable",
      desc: "Desain label fully customizable sesuai brand identity, ukuran, dan kebutuhan produk."
    }
  ]

  return (
    <section id="tafeta" className="py-16 md:py-24 bg-white relative overflow-hidden scroll-mt-20">
      <div className="absolute top-0 left-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Visual */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-2 lg:order-1"
          >
            <div className="bg-gradient-to-br from-[#FAF8F5] to-white rounded-3xl p-8 border border-[#E8D09E]/30 shadow-sm">
              <div className="space-y-4">
                <div className="bg-white rounded-2xl p-6 border border-gray-100">
                  <div className="flex items-center gap-3 mb-4">
                    <div className="w-10 h-10 bg-[#E8D09E]/30 text-[#8C6F3D] rounded-xl flex items-center justify-center">
                      <Tag className="w-5 h-5" />
                    </div>
                    <div>
                      <p className="text-xs text-gray-500">Spesifikasi</p>
                      <p className="font-bold text-[#1A1A1A]">Label Tafeta Premium</p>
                    </div>
                  </div>

                  <div className="space-y-3">
                    {[
                      { label: "Material", value: "Tafeta Premium" },
                      { label: "Printing", value: "High-Resolution" },
                      { label: "Ukuran", value: "Custom" },
                      { label: "Integrasi", value: "QR Code AG" }
                    ].map((spec, idx) => (
                      <div key={idx} className="flex items-center justify-between p-2 bg-[#FAF8F5] rounded-lg">
                        <span className="text-xs text-gray-500 font-medium">{spec.label}</span>
                        <span className="text-sm font-bold text-[#1A1A1A]">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-3">
                  <div className="bg-gradient-to-br from-[#C5A059] to-[#8C6F3D] rounded-2xl p-5 text-white">
                    <p className="text-3xl font-extrabold mb-1">100%</p>
                    <p className="text-xs text-white/80 uppercase tracking-wider">Custom Design</p>
                  </div>
                  <div className="bg-white rounded-2xl p-5 border border-[#E8D09E]/30">
                    <p className="text-3xl font-extrabold text-[#1A1A1A] mb-1">ISO</p>
                    <p className="text-xs text-gray-500 uppercase tracking-wider">18004:2015</p>
                  </div>
                </div>
              </div>
            </div>
          </motion.div>

          {/* Right Content */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-1 lg:order-2 space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-[#E8D09E]/20 border border-[#E8D09E]/40 px-4 py-2 rounded-full">
              <Tag className="w-4 h-4 text-[#8C6F3D]" />
              <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Fashion Solution</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Label <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Tafeta dengan QR</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Label tafeta berkualitas tinggi dengan kode QR terintegrasi, dirancang khusus untuk industri fashion dan tekstil. Memberikan autentikasi produk tanpa mengorbankan estetika dan kenyamanan.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: 20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-[#FAF8F5] rounded-2xl border border-gray-100 hover:border-[#E8D09E]/40 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-[#E8D09E]/30 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>

            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-2xl p-6 text-white">
              <div className="flex items-start gap-3">
                <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#E8D09E] rounded-xl flex items-center justify-center shrink-0">
                  <Lightbulb className="w-5 h-5" />
                </div>
                <div>
                  <h4 className="font-bold mb-2">Kenapa Label Tafeta?</h4>
                  <p className="text-sm text-gray-300 leading-relaxed">
                    Produk fashion sering menjadi target pemalsuan. Label tafeta dengan QR memberikan lapisan keamanan yang terintegrasi langsung dengan produk, tanpa mengorbankan estetika dan kenyamanan pemakai.
                  </p>
                </div>
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Sticker ber-NFC (BARU - sesuai proposal)
// ============================================================================
function NfcStickerDetail() {
  const features = [
    {
      icon: <Nfc className="w-5 h-5" />,
      title: "Teknologi NFC Terintegrasi",
      desc: "Sticker dengan chip NFC yang memungkinkan verifikasi instan hanya dengan mendekatkan smartphone."
    },
    {
      icon: <Smartphone className="w-5 h-5" />,
      title: "Tap & Go Verification",
      desc: "Konsumen cukup mendekatkan smartphone ke sticker untuk verifikasi keaslian produk — tanpa perlu scan QR."
    },
    {
      icon: <Shield className="w-5 h-5" />,
      title: "Chip Anti-Clone",
      desc: "Setiap chip NFC memiliki unique ID yang tidak dapat diduplikasi, menjamin keaslian produk."
    },
    {
      icon: <Zap className="w-5 h-5" />,
      title: "Mudah Diaplikasikan",
      desc: "Sticker dapat ditempelkan pada berbagai permukaan produk dengan mudah dan cepat."
    }
  ]

  return (
    <section id="nfc" className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden scroll-mt-20">
      <div className="absolute bottom-0 right-0 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl pointer-events-none" />
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Content */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-blue-100 border border-blue-200 px-4 py-2 rounded-full">
              <Nfc className="w-4 h-4 text-blue-600" />
              <span className="text-xs font-bold text-blue-700 uppercase tracking-widest">Smart Technology</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Sticker <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-500">ber-NFC</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Sticker dengan teknologi NFC untuk memudahkan pengaplikasian marking dan verifikasi instan. Cukup mendekatkan smartphone ke sticker untuk memverifikasi keaslian produk — pengalaman verifikasi paling modern.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: -20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-white rounded-2xl border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>
          </motion.div>

          {/* Right Visual - NFC Flow */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div className="bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden">
              <div className="absolute top-0 right-0 w-48 h-48 bg-blue-500/10 rounded-full blur-3xl" />

              <div className="relative z-10">
                <div className="flex items-center justify-between mb-6">
                  <div>
                    <p className="text-xs text-gray-400 mb-1">NFC Verification</p>
                    <p className="text-lg font-bold">Tap & Go</p>
                  </div>
                  <div className="flex items-center gap-2 bg-blue-500/20 px-3 py-1.5 rounded-full">
                    <Nfc className="w-3.5 h-3.5 text-blue-400" />
                    <span className="text-xs font-bold text-blue-400">READY</span>
                  </div>
                </div>

                <div className="space-y-3">
                  {[
                    { step: "1", title: "Dekatkan Smartphone", desc: "Buka NFC pada smartphone", icon: <Smartphone className="w-5 h-5" /> },
                    { step: "2", title: "Tap Sticker NFC", desc: "Dekatkan ke sticker produk", icon: <Nfc className="w-5 h-5" /> },
                    { step: "3", title: "Verifikasi Instan", desc: "Status keaslian ditampilkan", icon: <CheckCircle2 className="w-5 h-5" /> }
                  ].map((step, idx) => (
                    <motion.div
                      key={idx}
                      initial={{ opacity: 0, y: 10 }}
                      whileInView={{ opacity: 1, y: 0 }}
                      viewport={{ once: true }}
                      transition={{ delay: idx * 0.15 }}
                      className="flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/10"
                    >
                      <div className="w-10 h-10 bg-blue-500/20 text-blue-400 rounded-lg flex items-center justify-center shrink-0">
                        {step.icon}
                      </div>
                      <div className="flex-1">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-bold text-blue-400 bg-blue-500/20 px-2 py-0.5 rounded">
                            Step {step.step}
                          </span>
                          <h5 className="font-bold text-white">{step.title}</h5>
                        </div>
                        <p className="text-xs text-gray-400 mt-0.5">{step.desc}</p>
                      </div>
                    </motion.div>
                  ))}
                </div>
              </div>
            </div>

            <div className="bg-white rounded-3xl p-6 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-4 flex items-center gap-2">
                <Zap className="w-5 h-5 text-blue-600" />
                Ideal Untuk
              </h4>
              <div className="grid grid-cols-2 gap-3">
                {[
                  { icon: <ShoppingBag className="w-4 h-4" />, label: "Luxury Goods" },
                  { icon: <Award className="w-4 h-4" />, label: "Premium Brand" },
                  { icon: <Shield className="w-4 h-4" />, label: "Spirits & Wine" },
                  { icon: <Package className="w-4 h-4" />, label: "Electronics" }
                ].map((item, idx) => (
                  <div key={idx} className="flex items-center gap-2 p-3 bg-[#FAF8F5] rounded-xl">
                    <div className="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center">
                      {item.icon}
                    </div>
                    <span className="text-sm font-semibold text-[#1A1A1A]">{item.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// DETAIL SECTION: Printing QR pada Kemasan (BARU - sesuai proposal)
// ============================================================================
function PrintingQrDetail() {
  const features = [
    {
      icon: <Printer className="w-5 h-5" />,
      title: "Integrasi Driver Printer Klien",
      desc: "Platform komunikasi yang menghubungkan sistem AG dengan driver printer klien untuk pengiriman kode QR."
    },
    {
      icon: <QrCode className="w-5 h-5" />,
      title: "Pencetakan Langsung pada Kemasan",
      desc: "QR code dicetak langsung pada kemasan produk, menghilangkan kebutuhan sticker tambahan."
    },
    {
      icon: <Boxes className="w-5 h-5" />,
      title: "Batch & Packing System",
      desc: "Modul pengaman dokumen dan pengaturan batch agar siap untuk dicetak, dikemas, dan dikirimkan."
    },
    {
      icon: <FileCheck className="w-5 h-5" />,
      title: "Quality Control Terstandar",
      desc: "Pengecekan kualitas produk cetak dari kecacatan dan kesalahan dengan prosedur pelaporan terstandar."
    }
  ]

  return (
    <section id="printing" className="py-16 md:py-24 bg-white relative overflow-hidden scroll-mt-20">
      <div className="absolute top-0 left-0 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl pointer-events-none" />
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          {/* Left Visual - Printing Flow */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-2 lg:order-1"
          >
            <div className="bg-gradient-to-br from-[#FAF8F5] to-white rounded-3xl p-8 border border-[#E8D09E]/30 shadow-sm">
              <h4 className="font-bold text-[#1A1A1A] mb-6 flex items-center gap-2">
                <Printer className="w-5 h-5 text-purple-600" />
                Alur Printing Support
              </h4>

              <div className="space-y-3">
                {[
                  { icon: <Database className="w-5 h-5" />, title: "AG Backend", desc: "Generate kode AG unik", color: "purple" },
                  { icon: <Boxes className="w-5 h-5" />, title: "Batch & Pack", desc: "Pengaturan batch & dokumen", color: "blue" },
                  { icon: <Printer className="w-5 h-5" />, title: "Driver Printer", desc: "Integrasi dengan printer klien", color: "emerald" },
                  { icon: <FileCheck className="w-5 h-5" />, title: "Quality Control", desc: "Pengecekan kualitas cetak", color: "amber" },
                  { icon: <Package className="w-5 h-5" />, title: "Kemasan Produk", desc: "QR terprint langsung", color: "rose" }
                ].map((step, idx) => (
                  <motion.div
                    key={idx}
                    initial={{ opacity: 0, x: -20 }}
                    whileInView={{ opacity: 1, x: 0 }}
                    viewport={{ once: true }}
                    transition={{ delay: idx * 0.1 }}
                    className="relative"
                  >
                    <div className="flex items-center gap-4 p-4 bg-white rounded-2xl border border-gray-100 hover:border-purple-200 hover:shadow-sm transition-all">
                      <div className={`w-10 h-10 bg-${step.color}-100 text-${step.color}-600 rounded-xl flex items-center justify-center shrink-0`}>
                        {step.icon}
                      </div>
                      <div className="flex-1">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-bold text-purple-600 bg-purple-100 px-2 py-0.5 rounded">
                            Step {idx + 1}
                          </span>
                          <h5 className="font-bold text-[#1A1A1A]">{step.title}</h5>
                        </div>
                        <p className="text-xs text-gray-500 mt-0.5">{step.desc}</p>
                      </div>
                      <CheckCircle2 className="w-5 h-5 text-emerald-500 shrink-0" />
                    </div>
                    {idx < 4 && (
                      <div className="absolute left-9 top-full w-0.5 h-3 bg-purple-200" />
                    )}
                  </motion.div>
                ))}
              </div>
            </div>
          </motion.div>

          {/* Right Content */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="order-1 lg:order-2 space-y-6"
          >
            <div className="inline-flex items-center gap-2 bg-purple-100 border border-purple-200 px-4 py-2 rounded-full">
              <Printer className="w-4 h-4 text-purple-600" />
              <span className="text-xs font-bold text-purple-700 uppercase tracking-widest">Direct Integration</span>
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
              Printing QR <span className="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-purple-500">pada Kemasan</span>
            </h2>

            <p className="text-gray-600 leading-relaxed text-lg">
              Pencetakan QR langsung pada kemasan produk dengan integrasi driver printer klien. Solusi paling efisien untuk produksi massal dengan kapasitas hingga 100 juta kode per hari.
            </p>

            <div className="space-y-4">
              {features.map((feature, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, x: 20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ delay: idx * 0.1 }}
                  className="flex gap-4 p-4 bg-[#FAF8F5] rounded-2xl border border-gray-100 hover:border-purple-200 hover:shadow-sm transition-all"
                >
                  <div className="w-10 h-10 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center shrink-0">
                    {feature.icon}
                  </div>
                  <div>
                    <h4 className="font-bold text-[#1A1A1A] mb-1">{feature.title}</h4>
                    <p className="text-sm text-gray-600 leading-relaxed">{feature.desc}</p>
                  </div>
                </motion.div>
              ))}
            </div>

            <div className="bg-gradient-to-br from-purple-600 to-purple-700 rounded-2xl p-6 text-white">
              <div className="flex items-start gap-3">
                <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center shrink-0">
                  <Hash className="w-5 h-5" />
                </div>
                <div>
                  <h4 className="font-bold mb-2">Kapasitas Produksi</h4>
                  <p className="text-sm text-purple-100 leading-relaxed">
                    Sistem kami mampu menghasilkan hingga <strong>100 juta kode AG per hari</strong>, disimpan di cloud database dengan standar pengamanan informasi maksimum ISO/IEC 27000:2016.
                  </p>
                </div>
              </div>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

