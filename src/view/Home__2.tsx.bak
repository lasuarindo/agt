// ============================================================================
// TESTIMONIALS SECTION - Featured + Compact Layout
// ============================================================================
function TestimonialsSection() {
  const testimonials = [
    {
      id: 'featured',
      quote: "Sebelum menggunakan AuthenticGuards, kami kehilangan hampir 15% pendapatan akibat produk palsu yang beredar di pasaran. Setelah implementasi sistem verifikasi mereka selama 6 bulan, keluhan konsumen turun 80% dan kepercayaan retailer terhadap brand kami meningkat signifikan. ROI-nya luar biasa.",
      name: "Rizky Pratama",
      role: "Chief Operating Officer",
      industry: "F&B & Vaping",
      company: "Brand Rokok Elektrik Terkemuka",
      rating: 5,
      size: 'large'
    },
    {
      id: 'compact-1',
      quote: "Integrasi API-nya sangat mudah. Tim teknis kami bisa mengimplementasikan dalam 2 hari tanpa hambatan berarti.",
      name: "Diana Kusuma",
      role: "Head of Digital",
      industry: "Fashion & Apparel",
      rating: 5,
      size: 'small'
    },
    {
      id: 'compact-2',
      quote: "Dashboard analytics-nya membantu kami memetakan titik-titik rawan pemalsuan di rantai distribusi. Game changer.",
      name: "Hendra Wijaya",
      role: "Supply Chain Manager",
      industry: "Elektronik & Gadget",
      rating: 5,
      size: 'small'
    }
  ]

  const featured = testimonials.find(t => t.size === 'large')
  const compact = testimonials.filter(t => t.size === 'small')

  return (
    <section className="py-16 md:py-24 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#E8D09E]/10 rounded-full blur-3xl pointer-events-none" />
      
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center max-w-3xl mx-auto mb-12 space-y-4"
        >
          <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Quote className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Testimoni Klien</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Dipercaya oleh <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Ratusan Brand</span>
          </h2>
          <p className="text-gray-500 text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
            Dengarkan langsung dari para pemimpin industri yang telah merasakan dampak nyata dari solusi autentikasi kami.
          </p>
        </motion.div>

        {/* Testimonials Grid - Bento Layout */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          
          {/* Featured Testimonial */}
          {featured && (
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5 }}
              className="md:col-span-2 group relative bg-gradient-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 md:p-10 text-white shadow-xl overflow-hidden"
            >
              {/* Decorative */}
              <div className="absolute top-0 right-0 w-64 h-64 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none" />
              <div className="absolute -bottom-20 -left-20 w-64 h-64 bg-[#8C6F3D]/10 rounded-full blur-3xl pointer-events-none" />
              
              <div className="relative z-10 h-full flex flex-col">
                {/* Featured Badge */}
                <div className="flex items-center justify-between mb-6">
                  <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-3 py-1.5 rounded-full">
                    <Sparkles className="w-3.5 h-3.5 text-[#E8D09E]" />
                    <span className="text-[10px] font-bold text-[#E8D09E] uppercase tracking-wider">Featured Story</span>
                  </div>
                  <Quote className="w-10 h-10 text-[#E8D09E]/30" />
                </div>

                {/* Rating */}
                <div className="flex gap-1 mb-5">
                  {[...Array(featured.rating)].map((_, i) => (
                    <Star key={i} className="w-4 h-4 fill-amber-400 text-amber-400" />
                  ))}
                </div>

                {/* Quote */}
                <blockquote className="text-base md:text-lg text-gray-200 leading-relaxed mb-8 flex-1">
                  "{featured.quote}"
                </blockquote>

                {/* Author Info */}
                <div className="flex items-center justify-between pt-6 border-t border-white/10">
                  <div className="flex items-center gap-3">
                    <div className="w-12 h-12 bg-gradient-to-br from-[#E8D09E] to-[#C5A059] rounded-full flex items-center justify-center text-[#1A1A1A] font-extrabold text-lg shadow-lg">
                      {featured.name.charAt(0)}
                    </div>
                    <div>
                      <p className="font-bold text-white">{featured.name}</p>
                      <p className="text-xs text-gray-400">{featured.role}</p>
                    </div>
                  </div>
                  
                  <div className="hidden sm:block text-right">
                    <p className="text-xs font-bold text-[#E8D09E] uppercase tracking-wider">{featured.industry}</p>
                    <p className="text-[11px] text-gray-500 mt-0.5">{featured.company}</p>
                  </div>
                </div>
              </div>
            </motion.div>
          )}

          {/* Compact Testimonials */}
          <div className="flex flex-col gap-4 md:gap-6">
            {compact.map((item, idx) => (
              <motion.div
                key={item.id}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, margin: "-50px" }}
                transition={{ duration: 0.5, delay: (idx + 1) * 0.1 }}
                className="group relative bg-white rounded-3xl p-6 border border-[#E8D09E]/30 hover:border-[#C5A059]/50 hover:shadow-lg transition-all duration-300 flex-1 flex flex-col"
              >
                <div className="flex items-start justify-between mb-4">
                  <Quote className="w-6 h-6 text-[#E8D09E]" />
                  <div className="flex gap-0.5">
                    {[...Array(item.rating)].map((_, i) => (
                      <Star key={i} className="w-3 h-3 fill-amber-400 text-amber-400" />
                    ))}
                  </div>
                </div>

                <blockquote className="text-sm text-gray-700 leading-relaxed mb-5 flex-1">
                  "{item.quote}"
                </blockquote>

                <div className="pt-4 border-t border-gray-100">
                  <div className="flex items-center gap-2.5">
                    <div className="w-9 h-9 bg-gradient-to-br from-[#E8D09E]/50 to-[#C5A059]/50 rounded-full flex items-center justify-center text-white font-bold text-sm">
                      {item.name.charAt(0)}
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="font-bold text-[#1A1A1A] text-sm truncate">{item.name}</p>
                      <p className="text-[11px] text-gray-500 truncate">{item.role}</p>
                    </div>
                  </div>
                  <div className="mt-2">
                    <span className="inline-block text-[10px] font-bold text-[#8C6F3D] bg-[#E8D09E]/20 px-2 py-0.5 rounded uppercase tracking-wider">
                      {item.industry}
                    </span>
                  </div>
                </div>
              </motion.div>
            ))}
          </div>
        </div>

        {/* Stats Bar */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ delay: 0.3 }}
          className="mt-12 bg-white rounded-2xl p-6 border border-[#E8D09E]/30 shadow-sm"
        >
          <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
            {[
              { value: '4.9/5', label: 'Rating Kepuasan', icon: <Star className="w-4 h-4 fill-amber-400 text-amber-400" /> },
              { value: '500+', label: 'Klien Aktif', icon: <Users className="w-4 h-4 text-[#8C6F3D]" /> },
              { value: '98%', label: 'Tingkat Retensi', icon: <TrendingUp className="w-4 h-4 text-emerald-600" /> },
              { value: '15+', label: 'Industri Dilayani', icon: <Building2 className="w-4 h-4 text-blue-600" /> }
            ].map((stat, idx) => (
              <div key={idx} className="flex items-center gap-3">
                <div className="w-10 h-10 bg-[#FAF8F5] rounded-xl flex items-center justify-center shrink-0">
                  {stat.icon}
                </div>
                <div>
                  <p className="text-xl font-extrabold text-[#1A1A1A] tracking-tight">{stat.value}</p>
                  <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
                </div>
              </div>
            ))}
          </div>
        </motion.div>
            
      </div>
    </section>
  )
}

// ============================================================================
// CTA SECTION
// ============================================================================
function CTASection() {
  return (
    <section className="py-16 md:py-24 bg-white relative overflow-hidden">
      <div className="max-w-5xl mx-auto px-4 md:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="relative bg-linear-to-br from-[#1A1A1A] to-[#2a2a2a] rounded-3xl p-8 md:p-16 text-white text-center shadow-2xl overflow-hidden"
        >
          <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/15 rounded-full blur-3xl pointer-events-none" />
          <div className="absolute bottom-0 left-0 w-72 h-72 bg-[#8C6F3D]/10 rounded-full blur-3xl pointer-events-none" />

          <div className="relative z-10 space-y-6 max-w-2xl mx-auto">
            <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-1.5 rounded-full">
              <Sparkles className="w-4 h-4 text-[#E8D09E]" />
              <span className="text-xs font-bold text-[#E8D09E] tracking-wider uppercase">Mulai Hari Ini</span>
            </div>

            <h2 className="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight">
              Lindungi Brand Anda <br className="hidden md:block" />
              <span className="text-transparent bg-clip-text bg-linear-to-r from-[#E8D09E] to-[#C5A059]">
                Mulai Sekarang
              </span>
            </h2>

            <p className="text-gray-300 text-lg leading-relaxed">
              Bergabunglah dengan ratusan brand yang telah mempercayakan perlindungan produk mereka kepada AuthenticGuards.
            </p>

            <div className="flex flex-col sm:flex-row gap-4 justify-center pt-4">
              <Link
                to="/contact"
                className="group inline-flex items-center justify-center gap-3 bg-[#C5A059] text-[#1A1A1A] px-8 py-4 rounded-xl font-bold text-lg hover:bg-[#E8D09E] transition-all duration-300 shadow-lg hover:shadow-[#C5A059]/30 hover:-translate-y-0.5"
              >
                <span>Hubungi Tim Kami</span>
                <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
              </Link>
              <Link
                to="/scan"
                className="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-all duration-300"
              >
                <ScanLine className="w-5 h-5" />
                <span>Coba Verifikasi</span>
              </Link>
            </div>
          </div>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// CONTACT SECTION
// ============================================================================
function ContactSection() {
  return (
    <section id="contact" className="py-16 md:py-24 bg-[#FAF8F5] relative">
      <div className="max-w-7xl mx-auto px-4 md:px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <div>
              <p className="text-[#8C6F3D] font-bold tracking-widest uppercase text-xs mb-3">Hubungi Kami</p>
              <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight mb-4">
                Siap Berdiskusi <span className="text-transparent bg-clip-text bg-linear-to-r from-[#8C6F3D] to-[#C5A059]">Solusi Anda?</span>
              </h2>
              <p className="text-gray-600 leading-relaxed">
                Tim kami siap membantu Anda menemukan solusi anti-counterfeit yang tepat untuk brand Anda.
              </p>
            </div>

            <div className="space-y-4">
              {[
                { icon: <MapPin className="w-5 h-5" />, title: "Alamat", value: "Jl. Kh Wahid Hasyim No.316, Kopo, Bojongloa Kaler, Kota Bandung, Jawa Barat 40233" },
                { icon: <Phone className="w-5 h-5" />, title: "Telepon", value: "+62 812-2220-1649", href: "tel:+6281222201649" },
                { icon: <Mail className="w-5 h-5" />, title: "Email", value: "info@authenticguards.com", href: "mailto:info@authenticguards.com" }
              ].map((item, idx) => (
                <div key={idx} className="flex gap-4 p-4 bg-white rounded-2xl border border-[#E8D09E]/30 shadow-sm hover:shadow-md transition-shadow">
                  <div className="w-10 h-10 bg-[#E8D09E]/20 text-[#8C6F3D] rounded-xl flex items-center justify-center shrink-0">
                    {item.icon}
                  </div>
                  <div>
                    <p className="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">{item.title}</p>
                    {item.href ? (
                      <a href={item.href} className="text-sm font-semibold text-[#1A1A1A] hover:text-[#8C6F3D] transition-colors">
                        {item.value}
                      </a>
                    ) : (
                      <p className="text-sm font-semibold text-[#1A1A1A]">{item.value}</p>
                    )}
                  </div>
                </div>
              ))}
            </div>

            {/* <div className="flex gap-3 pt-4">
              {[
                { icon: <Instagram className="w-5 h-5" />, href: "#" },
                { icon: <Facebook className="w-5 h-5" />, href: "#" },
                { icon: <Twitter className="w-5 h-5" />, href: "#" },
                { icon: <Linkedin className="w-5 h-5" />, href: "#" }
              ].map((item, idx) => (
                <a
                  key={idx}
                  href={item.href}
                  className="w-10 h-10 bg-[#1A1A1A] text-white rounded-xl flex items-center justify-center hover:bg-[#8C6F3D] transition-colors"
                >
                  {item.icon}
                </a>
              ))}
            </div> */}
          </motion.div>

          <motion.div
            initial={{ opacity: 0, x: 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            className="bg-white border border-[#E8D09E]/30 rounded-3xl p-6 md:p-8 shadow-sm"
          >
            <h3 className="text-xl font-bold text-[#1A1A1A] mb-6">Kirim Pesan</h3>
            <form className="space-y-4">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-1.5 block">Nama</label>
                  <input
                    type="text"
                    className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                    placeholder="Nama lengkap"
                  />
                </div>
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-1.5 block">Email</label>
                  <input
                    type="email"
                    className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                    placeholder="email@contoh.com"
                  />
                </div>
              </div>
              <div>
                <label className="text-sm font-semibold text-gray-700 mb-1.5 block">Perusahaan</label>
                <input
                  type="text"
                  className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white"
                  placeholder="Nama perusahaan"
                />
              </div>
              <div>
                <label className="text-sm font-semibold text-gray-700 mb-1.5 block">Pesan</label>
                <textarea
                  rows={4}
                  className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#8C6F3D] focus:ring-2 focus:ring-[#E8D09E]/50 outline-none transition-all bg-gray-50 focus:bg-white resize-none"
                  placeholder="Ceritakan kebutuhan Anda..."
                />
              </div>
              <button
                type="submit"
                className="w-full flex items-center justify-center gap-2 bg-[#1A1A1A] text-white font-bold py-3.5 rounded-xl hover:bg-[#8C6F3D] transition-all duration-300 shadow-lg hover:shadow-[#8C6F3D]/30 hover:-translate-y-0.5 active:translate-y-0"
              >
                <span>Kirim Pesan</span>
                <ArrowRight className="w-5 h-5" />
              </button>
            </form>
          </motion.div>
        </div>
      </div>
    </section>
  )
}

// ============================================================================
// SUPPORTED BY SECTION - Telkom, Indigo, Visa (Minimalist Version)
// ============================================================================
// ============================================================================
// SUPPORTED BY SECTION - Telkom, Indigo, Viisa (Minimalist Version)
// ============================================================================
function SupportedBySection() {
  const supporters = [
    {
      name: 'Telkom Indonesia',
      tagline: 'Technology Partner',
      initial: 'T',
      gradient: 'from-blue-500 to-blue-700',
      logo: logodev('telkom.co.id')
    },
    {
      name: 'Indigo',
      tagline: 'Innovation Partner',
      initial: 'I',
      gradient: 'from-purple-500 to-pink-500'
    },
    {
      name: 'Viisa',
      tagline: '... Partner',
      initial: 'V',
      gradient: 'from-[#1A1F71] to-[#F7B600]',
      logo: logodev('viisa.vn')
    }
  ]
  
  console.log(supporters);

  return (
    <section className="py-16 md:py-20 bg-white relative overflow-hidden">
      <div className="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-b from-[#E8D09E]/8 to-transparent rounded-full blur-3xl pointer-events-none" />
      
      <div className="relative max-w-6xl mx-auto px-4 md:px-8">
        {/* Header - Minimal */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12"
        >
          <p className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest mb-2">
            Didukung Oleh
          </p>
          <h2 className="text-2xl md:text-3xl font-extrabold text-[#1A1A1A] tracking-tight">
            Mitra Strategis Kami
          </h2>
        </motion.div>

        {/* Supporters - Horizontal Layout */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {supporters.map((supporter, idx) => (
            <motion.div
              key={supporter.name}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className="group relative bg-gradient-to-br from-white to-[#FAF8F5] rounded-2xl p-6 border border-gray-100 hover:border-[#E8D09E]/50 shadow-sm hover:shadow-lg transition-all duration-300"
            >
              <div className="flex items-center gap-4">
                {/* Logo / Initial */}
                {supporter.logo ? (
                  <div className="w-16 h-16 rounded-2xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300 shrink-0 bg-white border border-gray-100 overflow-hidden">
                    <img 
                      src={supporter.logo} 
                      alt={`${supporter.name} logo`}
                      className="w-full h-full object-contain p-2"
                      onError={(e) => {
                        // Fallback ke initial jika logo gagal dimuat
                        e.currentTarget.style.display = 'none'
                        const parent = e.currentTarget.parentElement
                        if (parent) {
                          parent.innerHTML = `<span class="text-white font-extrabold text-2xl">${supporter.initial}</span>`
                          parent.className = `w-16 h-16 bg-gradient-to-br ${supporter.gradient} rounded-2xl flex items-center justify-center`
                        }
                      }}
                    />
                  </div>
                ) : (
                  <div className={`w-16 h-16 bg-gradient-to-br ${supporter.gradient} rounded-2xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300 shrink-0`}>
                    <span className="text-white font-extrabold text-2xl">{supporter.initial}</span>
                  </div>
                )}

                {/* Info */}
                <div className="flex-1 min-w-0">
                  <h3 className="text-base font-bold text-[#1A1A1A] mb-0.5 truncate">
                    {supporter.name}
                  </h3>
                  <p className="text-xs font-medium text-gray-500 uppercase tracking-wide">
                    {supporter.tagline}
                  </p>
                </div>
              </div>
            </motion.div>
          ))}
        </div>

        {/* Trust Badge - Minimal */}
        <motion.div
          initial={{ opacity: 0 }}
          whileInView={{ opacity: 1 }}
          viewport={{ once: true }}
          transition={{ delay: 0.4 }}
          className="mt-8 text-center"
        >
          <p className="text-xs text-gray-400 flex items-center justify-center gap-1.5">
            <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
            <span>Standar Keamanan Global</span>
          </p>
        </motion.div>
      </div>
    </section>
  )
}

// ============================================================================
// SPONSORS SECTION - Placeholder untuk sponsor mendatang
// ============================================================================
function SponsorsSection() {
  const sponsorSlots = [1, 2, 3, 4, 5, 6]

  return (
    <section className="py-16 md:py-20 bg-[#FAF8F5] relative overflow-hidden">
      <div className="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-b from-[#E8D09E]/8 to-transparent rounded-full blur-3xl pointer-events-none" />
      
      <div className="relative max-w-6xl mx-auto px-4 md:px-8">
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12 space-y-3"
        >
          <div className="inline-flex items-center gap-2 bg-white border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Sparkles className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Segera Hadir</span>
          </div>
          
          <h2 className="text-2xl md:text-3xl font-extrabold text-[#1A1A1A] tracking-tight">
            Sponsor & Mitra Event
          </h2>
          <p className="text-gray-500 text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
            Kolaborasi eksklusif dengan brand dan perusahaan terkemuka dalam event dan inisiatif kami.
          </p>
        </motion.div>

        {/* Sponsor Slots Grid - Placeholder */}
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {sponsorSlots.map((slot, idx) => (
            <motion.div
              key={slot}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.08 }}
              className="group relative aspect-square bg-white rounded-2xl border-2 border-dashed border-[#E8D09E]/40 hover:border-[#C5A059]/60 flex flex-col items-center justify-center p-4 transition-all duration-300 hover:shadow-md"
            >
              {/* Placeholder Icon */}
              <div className="w-12 h-12 bg-[#FAF8F5] rounded-xl flex items-center justify-center mb-3 group-hover:bg-[#E8D09E]/20 transition-colors">
                <Sparkles className="w-6 h-6 text-[#E8D09E] group-hover:text-[#C5A059] transition-colors" />
              </div>
              
              {/* Placeholder Text */}
              <p className="text-xs font-semibold text-gray-400 text-center group-hover:text-[#8C6F3D] transition-colors">
                Coming Soon
              </p>
            </motion.div>
          ))}
        </div>

        {/* CTA to become sponsor */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ delay: 0.4 }}
          className="mt-10 text-center"
        >
          <div className="inline-flex flex-col sm:flex-row items-center gap-4 bg-white rounded-2xl p-5 border border-[#E8D09E]/30 shadow-sm">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 bg-[#E8D09E]/20 rounded-xl flex items-center justify-center">
                <Award className="w-5 h-5 text-[#8C6F3D]" />
              </div>
              <div className="text-left">
                <p className="text-sm font-bold text-[#1A1A1A]">Tertarik Menjadi Sponsor?</p>
                <p className="text-xs text-gray-500">Jangkau ribuan brand dan konsumen di Asia Tenggara</p>
              </div>
            </div>
            <Link
              to="/contact"
              className="inline-flex items-center gap-2 bg-[#1A1A1A] text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-[#8C6F3D] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
            >
              <span>Hubungi Kami</span>
              <ArrowRight className="w-4 h-4" />
            </Link>
          </div>
        </motion.div>
      </div>
    </section>
  )
}


// ============================================================================
// AWARDS & RECOGNITION SECTION
// ============================================================================
function AwardsSection() {
  const awards = [
    {
      year: '2024',
      title: 'Best Anti-Counterfeit Innovation',
      organizer: 'Indonesia Digital Awards',
      category: 'Technology',
      icon: <Trophy className="w-5 h-5" />,
      gradient: 'from-amber-400 to-amber-600'
    },
    {
      year: '2023',
      title: 'Top 10 Security Startup',
      organizer: 'ASEAN Tech Summit',
      category: 'Security',
      icon: <Award className="w-5 h-5" />,
      gradient: 'from-[#C5A059] to-[#8C6F3D]'
    },
    {
      year: '2023',
      title: 'ISO 27001 Certified',
      organizer: 'International Organization for Standardization',
      category: 'Compliance',
      icon: <ShieldCheck className="w-5 h-5" />,
      gradient: 'from-blue-500 to-blue-700'
    },
    {
      year: '2022',
      title: 'Most Innovative Product',
      organizer: 'Bandung Creative City Forum',
      category: 'Innovation',
      icon: <Lightbulb className="w-5 h-5" />,
      gradient: 'from-purple-500 to-pink-500'
    }
  ]

  return (
    <section className="py-16 md:py-24 bg-white relative overflow-hidden">
      <div className="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-[#E8D09E]/5 to-transparent rounded-full blur-3xl pointer-events-none" />
      
      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          className="text-center mb-12 space-y-3"
        >
          <div className="inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E8D09E]/40 px-4 py-2 rounded-full">
            <Trophy className="w-4 h-4 text-[#8C6F3D]" />
            <span className="text-xs font-bold text-[#8C6F3D] uppercase tracking-widest">Penghargaan & Pengakuan</span>
          </div>
          
          <h2 className="text-3xl md:text-4xl font-extrabold text-[#1A1A1A] tracking-tight">
            Diakui oleh <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#8C6F3D] to-[#C5A059]">Industri</span>
          </h2>
          <p className="text-gray-500 text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
            Berbagai penghargaan dan sertifikasi yang kami terima sebagai komitmen terhadap inovasi dan kualitas layanan.
          </p>
        </motion.div>

        {/* Awards Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {awards.map((award, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-50px" }}
              transition={{ duration: 0.5, delay: idx * 0.1 }}
              className="group relative bg-gradient-to-br from-[#FAF8F5] to-white rounded-2xl p-6 border border-gray-100 hover:border-[#E8D09E]/50 hover:shadow-lg transition-all duration-300"
            >
              <div className="flex items-start gap-4">
                {/* Award Icon */}
                <div className={`w-14 h-14 bg-gradient-to-br ${award.gradient} rounded-2xl flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-md`}>
                  {award.icon}
                </div>

                {/* Award Info */}
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2 mb-1.5">
                    <span className="text-xs font-bold text-[#8C6F3D] bg-[#E8D09E]/20 px-2 py-0.5 rounded">
                      {award.year}
                    </span>
                    <span className="text-xs text-gray-400 uppercase tracking-wider font-semibold">
                      {award.category}
                    </span>
                  </div>
                  
                  <h3 className="font-bold text-[#1A1A1A] text-base mb-1 group-hover:text-[#8C6F3D] transition-colors">
                    {award.title}
                  </h3>
                  <p className="text-sm text-gray-500">
                    {award.organizer}
                  </p>
                </div>
              </div>
            </motion.div>
          ))}
        </div>

        {/* Bottom Stats */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ delay: 0.4 }}
          className="mt-12 grid grid-cols-3 gap-4 max-w-3xl mx-auto"
        >
          {[
            { value: '15+', label: 'Penghargaan' },
            { value: '5+', label: 'Sertifikasi' },
            { value: '8+', label: 'Tahun Inovasi' }
          ].map((stat, idx) => (
            <div key={idx} className="text-center p-4 bg-[#FAF8F5] rounded-xl">
              <p className="text-2xl font-extrabold text-[#1A1A1A] mb-1">{stat.value}</p>
              <p className="text-xs text-gray-500 font-medium">{stat.label}</p>
            </div>
          ))}
        </motion.div>
      </div>
    </section>
  )
}

