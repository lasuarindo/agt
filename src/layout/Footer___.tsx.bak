import { Link } from 'react-router'
import { motion } from 'motion/react'
import {
  ShieldCheck,
  MapPin,
  Phone,
  Mail,
  // Instagram,
  // Facebook,
  // Twitter,
  // Linkedin,
  ArrowUpRight,
  Globe
} from 'lucide-react'

export default function FooterMain() {
  const currentYear = new Date().getFullYear()

  const footerSections = [
    {
      title: 'Solusi',
      links: [
        { label: 'Sticker Hologram', href: '#services' },
        { label: 'Garment Label', href: '#services' },
        { label: 'Brand Protection', href: '#services' },
        { label: 'Supply Chain Security', href: '#services' }
      ]
    },
    {
      title: 'Perusahaan',
      links: [
        { label: 'Tentang Kami', href: '#about' },
        { label: 'Teknologi', href: '#technology' },
        { label: 'Partner', href: '#partners' },
        { label: 'Karir', href: '#' }
      ]
    },
    {
      title: 'Sumber Daya',
      links: [
        { label: 'Dokumentasi', href: '#' },
        { label: 'API Reference', href: '#' },
        { label: 'Panduan', href: '/help' },
        { label: 'Studi Kasus', href: '#' }
      ]
    }
  ]

  const contactInfo = [
    {
      icon: <MapPin className="w-4 h-4" />,
      label: 'Alamat',
      value: 'Jl. Kh Wahid Hasyim No.316, Kopo, Bojongloa Kaler, Kota Bandung, Jawa Barat 40233'
    },
    {
      icon: <Phone className="w-4 h-4" />,
      label: 'Telepon',
      value: '+62 812-2220-1649',
      href: 'tel:+6281222201649'
    },
    {
      icon: <Mail className="w-4 h-4" />,
      label: 'Email',
      value: 'info@authenticguards.com',
      href: 'mailto:info@authenticguards.com'
    }
  ]

  const socialLinks = [
    // { icon: <Instagram className="w-5 h-5" />, href: '#', label: 'Instagram' },
    // { icon: <Facebook className="w-5 h-5" />, href: '#', label: 'Facebook' },
    // { icon: <Twitter className="w-5 h-5" />, href: '#', label: 'Twitter' },
    // { icon: <Linkedin className="w-5 h-5" />, href: '#', label: 'LinkedIn' }
  ]

  return (
    <footer className="bg-[#1A1A1A] text-white relative overflow-hidden">
      {/* Decorative Background */}
      <div className="absolute top-0 right-0 w-96 h-96 bg-[#C5A059]/5 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 w-72 h-72 bg-[#8C6F3D]/5 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 md:px-8">
        {/* Main Footer Content */}
        <div className="py-12 md:py-16">
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            {/* Brand Column */}
            <div className="lg:col-span-4 space-y-6">
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 bg-linear-to-br from-[#2a2a2a] to-[#1A1A1A] rounded-xl flex items-center justify-center border border-[#C5A059]/30 shadow-lg">
                  <ShieldCheck className="w-6 h-6 text-[#E8D09E]" />
                </div>
                <div>
                  <p className="font-extrabold text-white text-lg leading-tight">AuthenticGuards</p>
                  <p className="text-[10px] text-[#E8D09E] font-semibold uppercase tracking-widest leading-tight">Technology</p>
                </div>
              </div>

              <p className="text-sm text-gray-400 leading-relaxed max-w-sm">
                Sistem Anti-Counterfeit Pertama di Asia Tenggara. Lindungi produk dan puaskan konsumen Anda dengan teknologi autentikasi canggih sejak 2017.
              </p>

              {/* Contact Info */}
              <div className="space-y-3 pt-4">
                {contactInfo.map((item, idx) => (
                  <div key={idx} className="flex items-start gap-3 group">
                    <div className="w-8 h-8 bg-white/5 rounded-lg flex items-center justify-center text-[#E8D09E] shrink-0 group-hover:bg-[#E8D09E]/10 transition-colors">
                      {item.icon}
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-xs text-gray-500 uppercase tracking-wider mb-0.5">{item.label}</p>
                      {item.href ? (
                        <a
                          href={item.href}
                          className="text-sm text-gray-300 hover:text-[#E8D09E] transition-colors leading-relaxed"
                        >
                          {item.value}
                        </a>
                      ) : (
                        <p className="text-sm text-gray-300 leading-relaxed">{item.value}</p>
                      )}
                    </div>
                  </div>
                ))}
              </div>

              {/* Social Links */}
              <div className="flex gap-3 pt-4">
                {socialLinks.map((social, idx) => (
                  <a
                    key={idx}
                    href={social.href}
                    aria-label={social.label}
                    className="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center text-gray-400 hover:bg-[#E8D09E]/10 hover:text-[#E8D09E] transition-all duration-300"
                  >
                    {social.icon}
                  </a>
                ))}
              </div>
            </div>

            {/* Navigation Columns */}
            <div className="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-8">
              {footerSections.map((section, idx) => (
                <motion.div
                  key={idx}
                  initial={{ opacity: 0, y: 20 }}
                  whileInView={{ opacity: 1, y: 0 }}
                  viewport={{ once: true }}
                  transition={{ duration: 0.5, delay: idx * 0.1 }}
                >
                  <h4 className="font-bold text-white mb-5 text-sm uppercase tracking-wider">
                    {section.title}
                  </h4>
                  <ul className="space-y-3">
                    {section.links.map((link, linkIdx) => (
                      <li key={linkIdx}>
                        {link.href.startsWith('#') || link.href.startsWith('/') ? (
                          <Link
                            to={link.href}
                            className="text-sm text-gray-400 hover:text-[#E8D09E] transition-colors duration-200 flex items-center gap-1.5 group"
                          >
                            <span>{link.label}</span>
                            <ArrowUpRight className="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" />
                          </Link>
                        ) : (
                          <a
                            href={link.href}
                            className="text-sm text-gray-400 hover:text-[#E8D09E] transition-colors duration-200 flex items-center gap-1.5 group"
                          >
                            <span>{link.label}</span>
                            <ArrowUpRight className="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" />
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                </motion.div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Bar */}
        <div className="py-6 border-t border-white/10">
          <div className="flex flex-col md:flex-row items-center justify-between gap-4">
            <p className="text-sm text-gray-500 text-center md:text-left">
              © {currentYear} PT. Autentikasi Garda Teknologi. Hak cipta dilindungi.
            </p>
            <div className="flex flex-col md:flex-row items-center gap-4 text-xs text-gray-500">
              <div className="flex items-center gap-2">
                <ShieldCheck className="w-4 h-4 text-[#E8D09E]" />
                <span>Solusi Anti-Counterfeit Terdepan di Asia Tenggara</span>
              </div>
              <div className="hidden md:block w-px h-4 bg-white/10" />
              <div className="flex items-center gap-4">
                <Link to="/term-condition" className="hover:text-[#E8D09E] transition-colors">
                  Syarat & Ketentuan
                </Link>
                <Link to="/privacy-policy" className="hover:text-[#E8D09E] transition-colors">
                  Kebijakan Privasi
                </Link>
              </div>
            </div>
          </div>
        </div>
      </div>
    </footer>
  )
}
